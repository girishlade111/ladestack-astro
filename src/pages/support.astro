---
/**
 * /support — Support Center
 * Redesigned with Obsidian & Precision Emerald tokens,
 * structured support channels, and accessible accordion FAQs.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Accordion from '../components/ui/Accordion.astro';
import AccordionItem from '../components/ui/AccordionItem.astro';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    description: 'Support center and FAQ for Lade Stack platform.',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
    name: 'Lade Stack Support',
    url: 'https://ladestack.in/support',
  },
];

const supportOptions = [
  { icon: 'mail', title: 'Email Assistance', description: 'Direct contact with our engineering and support leads for all inquiries.', responseTime: 'Direct email', action: 'admin@ladestack.in', href: 'mailto:admin@ladestack.in' },
  { icon: 'book-open', title: 'Knowledge Base', description: 'Comprehensive documentation, API specs, and client-side setup guides.', responseTime: 'Self-service', action: 'Browse Documentation', href: '/docs' },
  { icon: 'message-square', title: 'GitHub Discussions', description: 'Open community discussions, feature proposals, and bug tracker.', responseTime: 'Community driven', action: 'Join on GitHub', href: 'https://github.com/girishlade111' },
];

const faqs = [
  { question: 'Are Lade Stack utilities completely free for commercial use?', answer: 'Yes. All output generated in the AI Code Studio, LS PDF Toolkit, and LS Image Compressor is unrestricted and free for commercial client work.' },
  { question: 'How do you guarantee privacy for processed documents?', answer: 'We use WebAssembly sandboxes that execute strictly in local browser memory. Files are never uploaded to our servers, eliminating cloud exfiltration risks.' },
  { question: 'What browsers are compatible with Lade Stack?', answer: 'All modern evergreen browsers supporting WebAssembly and standard Canvas APIs (Chrome, Firefox, Safari, Edge, Arc) are fully supported.' },
  { question: 'How can I submit feature requests or report a bug?', answer: 'You can submit issues directly via our GitHub repository or email us at admin@ladestack.in with reproducible details.' },
];
---

<BaseLayout
  title="Support Center – Help & FAQ | Lade Stack"
  description="Get help with Lade Stack developer tools. Browse common questions, review documentation, or contact us directly."
  canonical="https://ladestack.in/support"
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: 'Lade Stack Support Center',
    description: "Get help with Lade Stack developer tools. FAQs, troubleshooting, and direct support.",
    url: 'https://ladestack.in/support',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Lade Stack Support Center',
    description: "Get help with Lade Stack developer tools. FAQs, troubleshooting, and direct support.",
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background">
    {/* Hero */}
    <section class="relative pt-20 pb-14 border-b border-border bg-surface-muted/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-3xl sm:text-5xl font-bold text-foreground tracking-tight leading-tight">
          How can we help?
        </h1>
        <p class="mt-4 text-base sm:text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed">
          Troubleshoot workflows, browse technical answers, or contact our engineering team directly.
        </p>
      </div>
    </section>

    {/* Options */}
    <section class="py-14 sm:py-20 border-b border-border bg-background">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="sr-only">Support Channels</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {
            supportOptions.map((opt) => (
              <div class="rounded-xl border border-border bg-surface p-6 shadow-soft flex flex-col justify-between hover:border-brand/40 transition-colors">
                <div>
                  <div class="w-10 h-10 rounded-lg bg-brand/10 text-brand flex items-center justify-center mb-4">
                    <Icon name={opt.icon} class="w-5 h-5" />
                  </div>
                  <h3 class="text-lg font-semibold text-foreground mb-2">
                    {opt.title}
                  </h3>
                  <p class="text-xs text-muted-foreground leading-relaxed mb-4">
                    {opt.description}
                  </p>
                </div>
                <div class="pt-4 border-t border-border/60 flex items-center justify-between">
                  <span class="text-[11px] font-mono text-muted-foreground">{opt.responseTime}</span>
                  <a
                    href={opt.href}
                    target={opt.href.startsWith('http') ? '_blank' : undefined}
                    rel={opt.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="text-xs font-semibold text-brand hover:underline"
                  >
                    {opt.action} →
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* FAQ */}
    <section class="py-14 sm:py-20 bg-surface-muted/10">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          title="Common Questions"
          description="Find quick answers to key architectural, privacy, and licensing questions."
        />

        <Accordion>
          {
            faqs.map((f, i) => (
              <AccordionItem question={f.question} open={i === 0}>
                <p>{f.answer}</p>
              </AccordionItem>
            ))
          }
        </Accordion>

        <div class="mt-12 text-center">
          <Button href="/contact" size="md">
            <span>Contact Support Directly</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </Button>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
