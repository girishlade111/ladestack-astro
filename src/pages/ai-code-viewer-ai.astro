        <div class="container mx-auto px-5 sm:px-6 lg:px-8 relative">
          <div class="max-w-4xl mx-auto text-center">
            <div class="mb-8">
              <a href="/apps" class="inline-flex items-center gap-2 text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100">
                <Icon name="arrow-left" class="w-4 h-4 mr-2" />
