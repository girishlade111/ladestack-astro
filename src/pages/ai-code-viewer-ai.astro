                <Icon name="github" class="w-4 h-4" /><span class="text-sm">GitHub</span>
              </a>
              <a href="https://codepen.io/Girish-Lade-the-looper" target="_blank" rel="noopener noreferrer" class="text-gray-600 dark:text-gray-300 hover:text-black transition-colors flex items-center gap-2">
                <Icon name="code" class="w-4 h-4" /><span class="text-sm">CodePen</span>
              </a>
              <a href="mailto:admin@ladestack.in" class="text-gray-600 dark:text-gray-300 hover:text-green-500 transition-colors flex items-center gap-2">
                <Icon name="mail" class="w-4 h-4" /><span class="text-sm">Email</span>
              </a>
            </div>
          </div>
        </div>
        <div class="border-t border-gray-200 dark:border-gray-800 mt-12 pt-8">
          <div class="flex flex-col md:flex-row items-center justify-between gap-4">
            <p class="text-sm text-gray-600 dark:text-gray-300">© 2025 Lade Stack. All rights reserved.</p>
            <div class="flex items-center gap-6">
              <a href="https://ladestack.in" target="_blank" rel="noopener noreferrer" class="group relative text-sm text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                Built with ❤️ by LadeStack.in
                <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-blue-600 group-hover:w-full transition-all duration-300"></span>
              </a>
              <a href="https://code.ladestack.in/" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors">
                Try AI Tool →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </footer>

  {/* Demo dialog */}
  <dialog data-ai-demo class="max-w-4xl w-[calc(100%-2rem)] max-h-[80vh] overflow-y-auto rounded-2xl border border-border bg-background p-6 backdrop:bg-black/50">
    <h3 class="flex items-center gap-2 text-xl font-bold mb-6">
      <Icon name="sparkles" class="w-5 h-5" />
      AI Code Enhancement Demo
    </h3>
    <div class="space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
          <label class="text-sm font-medium text-gray-600 dark:text-gray-400 mb-2 block">Your Code (Input)</label>
          <textarea
            placeholder="Paste your code here..."
            rows="8"
            class="w-full font-mono text-sm p-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900"
          >{jsBefore}</textarea>
        </div>
        <div>
          <span class="text-sm font-medium text-blue-600 dark:text-blue-400 mb-2 block">AI Enhanced Version</span>
          <pre class="text-sm font-mono text-gray-800 dark:text-gray-200 bg-gray-50 dark:bg-gray-800 p-4 rounded-lg h-48 overflow-auto" set:html={esc(jsAfter)} />
        </div>
      </div>
      <div class="flex items-center justify-center">
        <button type="button" class="inline-flex items-center bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors">
          <Icon name="sparkles" class="w-4 h-4 mr-2" />
          Enhance This Code
        </button>
      </div>
      <div class="bg-blue-50 dark:bg-blue-900/20 p-4 rounded-lg">
        <h4 class="font-medium text-blue-900 dark:text-blue-100 mb-2">AI Improvements Made:</h4>
        <ul class="text-sm text-blue-800 dark:text-blue-200 space-y-1">
          <li>✅ Added semantic HTML structure</li>
          <li>✅ Implemented proper accessibility attributes</li>
          <li>✅ Separated concerns (no inline handlers)</li>
          <li>✅ Added proper event handling with preventDefault</li>
          <li>✅ Enhanced security and maintainability</li>
        </ul>
      </div>
    </div>
    <form method="dialog" class="mt-6 text-right">
      <button class="px-4 py-2 rounded-lg border border-border text-sm font-medium hover:bg-muted/40">Close</button>
    </form>
  </dialog>

  <script is:inline>
    (function () {
      var demo = document.querySelector('[data-ai-demo]');
      document.querySelectorAll('[data-demo-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (demo && demo.showModal) demo.showModal();
        });
      });
      document.querySelectorAll('[data-ai-form]').forEach(function (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var btn = form.querySelector('button');
          var kind = form.getAttribute('data-ai-form');
          if (btn) {
            btn.disabled = true;
            btn.textContent = kind === 'beta' ? 'Application submitted!' : 'Thanks for subscribing!';
          }
          form.reset();
          setTimeout(function () {
            if (btn) {
              btn.disabled = false;
              btn.textContent = kind === 'beta' ? 'Join Beta Program' : 'Subscribe to Newsletter';
            }
          }, 3000);
        });
      });
      var img = document.querySelector('[data-creator-img]');
      if (img) {
        img.addEventListener('error', function () {
          img.style.display = 'none';
          var fb = document.querySelector('[data-creator-fallback]');
          if (fb) fb.classList.remove('hidden');
        });
      }
    })();
  </script>
</BaseLayout>
