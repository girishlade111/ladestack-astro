---
/**
 * /ai-code-viewer-ai — CodeEnhance AI Showcase
 * Redesigned with Obsidian & Precision Emerald tokens,
 * interactive code before/after diffs, and accessible modal dialog.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    applicationCategory: 'DeveloperApplication',
    creator: { '@type': 'Person', email: 'admin@ladestack.in', name: 'Girish Lade', url: 'https://ladestack.in' },
    description: 'In-browser HTML, CSS & JS code viewer, compiler, editor, and enhancer for web development',
    name: 'CodeEnhance AI',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    operatingSystem: 'Web Browser',
    publisher: { '@type': 'Organization', name: 'Lade Stack', url: 'https://ladestack.in' },
    url: 'https://ladestack.in/ai-code-viewer-ai',
  },
];

const features = [
  { icon: 'brain', title: 'AI Enhancer', description: 'Intelligent code suggestions, bug identification, and automatic AST optimization in your browser.' },
  { icon: 'zap', title: 'Real-Time Compiler', description: 'Instant preview and syntax error detection for HTML, CSS, and modern JavaScript with sub-millisecond feedback.' },
  { icon: 'code-2', title: 'Smart Editor', description: 'Built-in syntax highlighting, bracket matching, and clean formatting for professional developers.' },
  { icon: 'eye', title: 'Live Sandbox', description: 'Isolated iframe execution environment. Test and preview layouts securely without external servers.' },
];

const htmlBefore = `<!DOCTYPE html>
<html>
<head>
  <title>Legacy Demo</title>
</head>
<body>
  <button onclick="handleClick()">
    Click me
  </button>
</body>
</html>`;

const htmlAfter = `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Enhanced Demo</title>
</head>
<body>
  <button 
    class="btn-primary"
    aria-label="Primary action button"
    type="button"
  >
    Click me
  </button>
  <script type="module">
    document.querySelector('.btn-primary')
      .addEventListener('click', () => console.log('Optimized!'));
  <\/script>
</body>
</html>`;

const jsBefore = `function createButton() {
  return '<button onclick="alert()">Click</button>';
}`;

const jsAfter = `function createButton() {
  const button = document.createElement('button');
  button.textContent = 'Click me';
  button.className = 'btn-primary';
  button.type = 'button';
  button.setAttribute('aria-label', 'Primary action button');
  
  button.addEventListener('click', (event) => {
    event.preventDefault();
    handleClick();
  });
  
  return button;
}`;

function esc(s: string) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
---

<BaseLayout
  title="CodeEnhance AI – In-Browser Code Studio & Compiler"
  description="Inspect, compile, and enhance HTML, CSS, and modern JavaScript in your browser with real-time feedback and privacy-first local execution."
  canonical="https://ladestack.in/ai-code-viewer-ai"
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: 'CodeEnhance AI – In-Browser Code Studio & Compiler',
    description: 'Inspect, compile, and enhance HTML, CSS, and modern JavaScript in your browser with real-time feedback and privacy-first local execution.',
    url: 'https://ladestack.in/ai-code-viewer-ai',
    type: 'website',
    image: 'https://ladestack.in/AIcode.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'CodeEnhance AI - AI-Powered Frontend Development',
    description: 'Transform your frontend code with AI intelligence. Edit, compile, and enhance HTML, CSS & JS with real-time AI assistance.',
    image: 'https://ladestack.in/AIcode.png',
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background">
    {/* Hero Section */}
    <section class="relative pt-20 pb-16 border-b border-border bg-surface-muted/20 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <a href="/apps" class="inline-flex items-center gap-1.5 text-xs font-mono text-muted-foreground hover:text-brand transition-colors mb-6">
          <Icon name="arrow-left" class="w-3.5 h-3.5" />
          <span>Back to All Tools</span>
        </a>

        <div>
          <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold text-foreground tracking-tight leading-tight text-balance">
            Real-Time In-Browser Code Compiler & Enhancer
          </h1>
          <p class="mt-4 text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed text-pretty">
            Write, compile, inspect, and optimize HTML, CSS, and modern JavaScript directly in your browser. Powered by client-side intelligence.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
            <Button href="https://code.ladestack.in/" target="_blank" size="lg" class="w-full sm:w-auto">
              <span>Launch Studio IDE</span>
              <Icon name="arrow-up-right" class="w-4 h-4" />
            </Button>
            <Button type="button" data-demo-open variant="outline" size="lg" class="w-full sm:w-auto">
              <span>View Interactive Demo</span>
              <Icon name="sparkles" class="w-4 h-4 text-brand" />
            </Button>
          </div>
        </div>
      </div>
    </section>

    {/* 4 Feature Columns */}
    <section class="py-16 sm:py-20 border-b border-border bg-surface">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="sr-only">Key Capabilities</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            features.map((f) => (
              <div class="rounded-xl border border-border bg-background p-6 transition-all duration-200 hover:border-brand/40 hover:shadow-card">
                <div class="w-10 h-10 rounded-lg bg-brand/10 text-brand flex items-center justify-center mb-4">
                  <Icon name={f.icon} class="w-5 h-5" />
                </div>
                <h3 class="text-base font-semibold text-foreground mb-2">
                  {f.title}
                </h3>
                <p class="text-xs text-muted-foreground leading-relaxed">
                  {f.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Editor Side-by-Side Diff */}
    <section class="py-16 sm:py-20 border-b border-border bg-background">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          title="Automated code modernization"
          description="Watch how the in-browser AI engine injects missing accessibility labels, separates execution concerns, and secures handlers."
        />

        <div class="max-w-5xl mx-auto rounded-2xl border border-border bg-surface shadow-elevated overflow-hidden">
          <div class="flex items-center justify-between px-4 py-3 bg-surface-muted border-b border-border text-xs font-mono text-muted-foreground">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-border"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-border"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-border"></span>
              <span class="ml-2 text-foreground font-semibold">DiffViewer.html</span>
            </div>
            <span class="text-brand font-semibold">AST Refactor Complete</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-border bg-background p-4 sm:p-6 font-mono text-xs overflow-x-auto">
            <div class="p-2 sm:p-4">
              <div class="flex items-center justify-between mb-3 text-muted-foreground text-[11px]">
                <span class="text-destructive font-semibold">Original Legacy Source</span>
                <span>Inaccessible</span>
              </div>
              <pre class="text-muted-foreground leading-relaxed" set:html={esc(htmlBefore)} />
            </div>

            <div class="p-2 sm:p-4 bg-brand/[0.02]">
              <div class="flex items-center justify-between mb-3 text-muted-foreground text-[11px]">
                <span class="text-brand font-semibold">AI Optimized Output</span>
                <span class="text-emerald-500 font-semibold">WCAG AA Compliant</span>
              </div>
              <pre class="text-foreground leading-relaxed" set:html={esc(htmlAfter)} />
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Creator Note */}
    <section class="py-16 sm:py-20 border-b border-border bg-surface-muted/20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="sr-only">Founder Note</h2>
        <div class="rounded-2xl border border-border bg-surface p-8 sm:p-10 shadow-soft flex flex-col md:flex-row items-center gap-8">
          <img
            src="/img/girish.jpg"
            alt="Girish Lade, Founder of Lade Stack"
            width="96"
            height="96"
            loading="lazy"
            class="w-24 h-24 rounded-2xl object-cover object-top border border-brand/20 shadow-soft shrink-0"
          />
          <div class="text-center md:text-left">
            <h3 class="text-xl font-bold text-foreground">Girish Lade</h3>
            <p class="text-xs font-mono text-brand mb-3">Founder & Lead Engineer, Lade Stack</p>
            <p class="text-sm text-muted-foreground leading-relaxed">
              &quot;Lade Stack exists to democratize enterprise-grade developer utilities. No sign-up friction, zero cloud telemetry, and 100% in-browser performance for engineers worldwide.&quot;
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>

  {/* Demo Dialog */}
  <dialog data-ai-demo class="max-w-3xl w-[calc(100%-2rem)] max-h-[85vh] overflow-y-auto rounded-2xl border border-border bg-surface p-6 sm:p-8 text-foreground shadow-elevated backdrop:bg-black/60">
    <div class="flex items-center justify-between pb-4 border-b border-border">
      <div class="flex items-center gap-2">
        <Icon name="sparkles" class="w-5 h-5 text-brand" />
        <h3 class="text-lg font-bold">Interactive AI Enhancement Demo</h3>
      </div>
      <form method="dialog">
        <button type="button" class="p-1 text-muted-foreground hover:text-foreground rounded" aria-label="Close dialog">
          <Icon name="x" class="w-4 h-4" />
        </button>
      </form>
    </div>

    <div class="mt-6 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="text-xs font-mono text-muted-foreground mb-1.5 block">Input JavaScript</label>
          <pre class="p-3.5 rounded-lg border border-border bg-background font-mono text-xs text-muted-foreground overflow-auto h-40 leading-relaxed">{jsBefore}</pre>
        </div>
        <div>
          <span class="text-xs font-mono text-brand mb-1.5 block">Enhanced JavaScript</span>
          <pre class="p-3.5 rounded-lg border border-border bg-background font-mono text-xs text-foreground overflow-auto h-40 leading-relaxed">{jsAfter}</pre>
        </div>
      </div>

      <div class="p-4 rounded-xl border border-brand/30 bg-brand/5 text-xs space-y-1.5">
        <p class="font-semibold text-foreground">Optimizations Applied:</p>
        <p class="text-muted-foreground">✓ Converted innerHTML string concatenation to native DOM nodes</p>
        <p class="text-muted-foreground">✓ Added explicit <code class="font-mono text-brand">type="button"</code> and ARIA action labels</p>
        <p class="text-muted-foreground">✓ Separated inline event handler into modern event listener</p>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-border">
        <form method="dialog">
          <Button variant="outline" size="sm">Close</Button>
        </form>
        <Button href="https://code.ladestack.in/" target="_blank" size="sm">
          <span>Open Full Studio</span>
          <Icon name="arrow-up-right" class="w-3.5 h-3.5" />
        </Button>
      </div>
    </div>
  </dialog>

  <script is:inline>
    (function () {
      var demo = document.querySelector('[data-ai-demo]');
      document.querySelectorAll('[data-demo-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (demo && demo.showModal) demo.showModal();
        });
      });
    })();
  </script>
</BaseLayout>
