---
/**
 * /ai-code-viewer-ai — full port of src/pages/AICodeViewerAI.tsx.
 * Same hero, 4 features, editor preview, demo dialog, before/after,
 * creator card, newsletter/beta forms, CTA band, and the page's own
 * custom footer (global footer suppressed via hideFooter).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    aggregateRating: { '@type': 'AggregateRating', ratingCount: '156', ratingValue: '4.8' },
    applicationCategory: 'DeveloperApplication',
    creator: { '@type': 'Person', email: 'admin@ladestack.in', name: 'Girish Lade', url: 'https://ladestack.in' },
    description: 'AI-powered HTML, CSS & JS code viewer, compiler, editor, and enhancer for modern web development',
    name: 'CodeEnhance AI',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    operatingSystem: 'Web Browser',
    publisher: { '@type': 'Organization', name: 'Lade Stack', url: 'https://ladestack.in' },
    url: 'https://ladestack.in/ai-code-viewer-ai',
  },
];

const features = [
  { icon: 'brain', title: 'AI Enhancer', description: 'Intelligent code suggestions and automatic optimization powered by advanced AI algorithms.' },
  { icon: 'zap', title: 'Real-Time Compiler', description: 'Instant preview and error detection for HTML, CSS, and JavaScript with immediate feedback.' },
  { icon: 'code-2', title: 'Smart Editor', description: 'Built-in syntax highlighting, auto-completion, and code folding for professional development.' },
  { icon: 'eye', title: 'Code Viewer', description: 'Share and export compiled previews with beautiful formatting and responsive design.' },
];

const htmlBefore = `<!DOCTYPE html>
<html>
<head>
  <title>AI Enhanced</title>
</head>
<body>
  <button onclick="handleClick()">
    Click me
  </button>
</body>
</html>`;

const htmlAfter = `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Enhanced</title>
</head>
<body>
  <button 
    class="btn-primary"
    aria-label="Primary action button"
    onclick="handleClick()"
  >
    Click me
  </button>
  <script>
    function handleClick() {
      console.log('Button clicked!');
    }
  <\/script>
</body>
</html>`;

const jsBefore = `function createButton() {
  return '<button onclick="alert()">Click</button>';
}`;

const jsAfter = `function createButton() {
  const button = document.createElement('button');
  button.textContent = 'Click me';
  button.className = 'btn-primary';
  button.setAttribute('aria-label', 'Primary action button');
  
  button.addEventListener('click', (event) => {
    event.preventDefault();
    handleClick();
  });
  
  return button;
}`;

function esc(s: string) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
---

<BaseLayout
  title="CodeEnhance AI - AI-Powered HTML, CSS & JS Code Viewer, Compiler, Editor & Enhancer"
  description="Transform your frontend code with AI intelligence. Edit, compile, and enhance HTML, CSS & JS with real-time AI assistance. The ultimate development tool for modern web creators."
  canonical="https://ladestack.in/ai-code-viewer-ai"
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: 'CodeEnhance AI - AI-Powered Frontend Development Tool',
    description: 'Transform your frontend code with AI intelligence. Edit, compile, and enhance HTML, CSS & JS with real-time AI assistance.',
    url: 'https://ladestack.in/ai-code-viewer-ai',
    type: 'website',
    image: 'https://ladestack.in/AIcode.png',
