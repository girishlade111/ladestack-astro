---
/**
 * /sitemap — Human-Readable Site Index
 * Grouped logically: Main Pages, Tools & Utilities, Blog Archive (by category & date), Legal.
 * Accessible semantic links for search engine crawlers and users alike.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/ui/Badge.astro';
import { blogPosts } from '../data/blogPosts';
import appsData from '../data/apps.json';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    description: 'Human-readable directory of all pages, tools, and blog posts on Lade Stack.',
    name: 'Sitemap & Directory – Lade Stack',
    url: 'https://ladestack.in/sitemap',
  },
];

const mainRoutes = [
  { title: 'Home', href: '/', desc: 'Platform landing page with product overview and interactive code demo' },
  { title: 'About Lade Stack', href: '/about', desc: 'Founder story, vision, timeline, and core engineering philosophy' },
  { title: 'AI Code Studio', href: '/ai-code-viewer-ai', desc: 'Real-time in-browser code viewer, compiler, and AST enhancer' },
  { title: 'Apps & Tools Gallery', href: '/apps', desc: 'Comprehensive directory of all live and in-pipeline developer utilities' },
  { title: 'Documentation', href: '/docs', desc: 'Guides, API reference, architecture overviews, and changelog' },
  { title: 'Support Center', href: '/support', desc: 'Technical help, contact channels, and frequently asked questions' },
  { title: 'Contact Us', href: '/contact', desc: 'Direct communication channels and inquiry forms' },
];

const legalRoutes = [
  { title: 'Privacy Policy', href: '/privacy', desc: 'Client-side processing guarantees and zero-storage data policy' },
  { title: 'Terms of Service', href: '/terms', desc: 'Commercial usage rights, licensing terms, and liability disclaimers' },
];

// Group blog posts by category
const postsByCategory = blogPosts.reduce((acc, post) => {
  if (!acc[post.category]) acc[post.category] = [];
  acc[post.category].push(post);
  return acc;
}, {} as Record<string, typeof blogPosts>);
---

<BaseLayout
  title="Sitemap & Site Directory | Lade Stack"
  description="Explore the full directory of Lade Stack: developer tools, engineering articles, architecture guides, and platform resources."
  canonical="https://ladestack.in/sitemap"
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: 'Sitemap & Site Directory | Lade Stack',
    description: 'Explore the full directory of Lade Stack: developer tools, engineering articles, and documentation.',
    url: 'https://ladestack.in/sitemap',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Sitemap & Site Directory | Lade Stack',
    description: 'Explore the full directory of Lade Stack developer tools and engineering articles.',
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background">
    {/* Hero */}
    <section class="relative pt-20 pb-14 border-b border-border bg-surface-muted/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Badge variant="brand" size="md" dot={true} class="mb-4">
          Navigation Index
        </Badge>
        <h1 class="text-3xl sm:text-5xl font-bold text-foreground tracking-tight leading-tight">
          Site Index & Directory
        </h1>
        <p class="mt-4 text-base sm:text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed">
          A complete, accessible map of all pages, tools, documentation, and engineering publications.
        </p>
      </div>
    </section>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
      {/* ── SECTION 1: Core Platform ── */}
      <div>
        <div class="flex items-center gap-2 mb-6 pb-3 border-b border-border">
          <Icon name="home" class="w-4 h-4 text-brand" />
          <h2 class="text-lg font-bold text-foreground">Core Platform Routes</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            mainRoutes.map((route) => (
              <a
                href={route.href}
                class="rounded-xl border border-border bg-surface p-5 hover:border-brand/40 hover:shadow-soft transition-all duration-150 flex flex-col justify-between group"
              >
                <div>
                  <h3 class="text-sm font-semibold text-foreground group-hover:text-brand transition-colors">
                    {route.title}
                  </h3>
                  <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                    {route.desc}
                  </p>
                </div>
                <span class="mt-3 text-[11px] font-mono text-brand">
                  {route.href} →
                </span>
              </a>
            ))
          }
        </div>
      </div>

      {/* ── SECTION 2: Developer Tools & Apps ── */}
      <div>
        <div class="flex items-center gap-2 mb-6 pb-3 border-b border-border">
          <Icon name="layers" class="w-4 h-4 text-brand" />
          <h2 class="text-lg font-bold text-foreground">Developer Tools & Utilities</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {
            appsData.map((app) => (
              <a
                href={app.landingUrl}
                target={app.landingUrl.startsWith('http') ? '_blank' : undefined}
                rel={app.landingUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="rounded-xl border border-border bg-surface p-4 hover:border-brand/40 hover:shadow-soft transition-all duration-150 flex flex-col justify-between group"
              >
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[10px] font-mono text-brand font-semibold uppercase">{app.category}</span>
                    {app.comingSoon ? (
                      <span class="text-[10px] text-muted-foreground font-mono">Coming Soon</span>
                    ) : (
                      <span class="text-[10px] text-emerald-500 font-mono font-semibold">Live</span>
                    )}
                  </div>
                  <h3 class="text-sm font-semibold text-foreground group-hover:text-brand transition-colors">
                    {app.title}
                  </h3>
                  <p class="mt-1 text-xs text-muted-foreground line-clamp-2">
                    {app.tagline}
                  </p>
                </div>
                <span class="mt-3 text-[11px] font-mono text-muted-foreground group-hover:text-brand inline-flex items-center gap-1">
                  <span>Open Tool</span>
                  {app.landingUrl.startsWith('http') && <Icon name="arrow-up-right" class="w-3 h-3" />}
                </span>
              </a>
            ))
          }
        </div>
      </div>

      {/* ── SECTION 3: Engineering Blog Archive ── */}
      <div>
        <div class="flex items-center justify-between mb-6 pb-3 border-b border-border">
          <div class="flex items-center gap-2">
            <Icon name="file-text" class="w-4 h-4 text-brand" />
            <h2 class="text-lg font-bold text-foreground">Engineering Blog Archive ({blogPosts.length} Articles)</h2>
          </div>
          <a href="/blog" class="text-xs font-semibold text-brand hover:underline">
            Visit Blog Index →
          </a>
        </div>

        <div class="space-y-8">
          {
            Object.entries(postsByCategory).map(([category, posts]) => (
              <div>
                <h3 class="text-xs font-mono font-semibold text-brand uppercase tracking-wider mb-3">
                  {category} ({posts.length})
                </h3>
                <div class="divide-y divide-border rounded-xl border border-border bg-surface overflow-hidden">
                  {posts.map((post) => (
                    <a
                      href={`/blog/${post.slug}`}
                      class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-surface-muted/50 transition-colors group"
                    >
                      <span class="text-xs sm:text-sm font-medium text-foreground group-hover:text-brand transition-colors">
                        {post.title}
                      </span>
                      <div class="flex items-center gap-3 text-xs text-muted-foreground font-mono shrink-0">
                        <span>{new Date(post.date + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                        <span>·</span>
                        <span>{post.readTime}</span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      {/* ── SECTION 4: Legal & Policies ── */}
      <div>
        <div class="flex items-center gap-2 mb-6 pb-3 border-b border-border">
          <Icon name="shield" class="w-4 h-4 text-brand" />
          <h2 class="text-lg font-bold text-foreground">Legal & Privacy Governance</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            legalRoutes.map((route) => (
              <a
                href={route.href}
                class="rounded-xl border border-border bg-surface p-5 hover:border-brand/40 hover:shadow-soft transition-all duration-150 flex flex-col justify-between group"
              >
                <div>
                  <h3 class="text-sm font-semibold text-foreground group-hover:text-brand transition-colors">
                    {route.title}
                  </h3>
                  <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                    {route.desc}
                  </p>
                </div>
                <span class="mt-3 text-[11px] font-mono text-brand">
                  {route.href} →
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
