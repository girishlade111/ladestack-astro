---
/**
 * /about — About Lade Stack & Founder Story
 * Redesigned with Obsidian & Precision Emerald tokens,
 * structured milestone timeline, and core engineering philosophy.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: 'admin@ladestack.in' },
    description: 'AI-powered development tools ecosystem founded by Girish Lade, democratizing advanced development tools for creators and startups worldwide.',
    founder: {
      '@type': 'Person',
      description: 'Multi-disciplinary engineer and designer with expertise in AI systems, web development, and user experience',
      jobTitle: 'Founder & Lead Developer',
      name: 'Girish Lade',
      url: 'https://ladestack.in/about',
    },
    foundingDate: '2020',
    logo: 'https://ladestack.in/logo.png',
    name: 'Lade Stack',
    sameAs: [
      'https://www.instagram.com/girish_lade_/',
      'https://www.linkedin.com/in/girish-lade-075bba201/',
      'https://github.com/girishlade111',
      'https://codepen.io/Girish-Lade-the-looper',
    ],
    url: 'https://ladestack.in',
  },
];

const heroStats = [
  { value: '2020', label: 'Ecosystem Founded' },
  { value: '5+', label: 'Live Client Tools' },
  { value: '8K+', label: 'Active Developers' },
  { value: '100%', label: 'Free & In-Browser' },
];

const storyTimeline = [
  { year: '2020', title: 'The Genesis', text: 'Girish begins developing personal dev tools and local automation scripts to eliminate repetitive coding friction.' },
  { year: '2022', title: 'First Prototypes', text: 'Multi-LLM experiments and client-side processing algorithms establish the technical foundation.' },
  { year: '2024', title: 'Lade Stack Unified', text: 'The vision crystallizes into a unified developer platform: intelligent tools with zero cost and maximum privacy.' },
  { year: '2026', title: 'Full Web Suite', text: '5 tools in production, 4 upcoming modules in testing, and 8,000+ developers shipping faster daily.' },
];

const coreValues = [
  {
    icon: 'sparkles',
    title: 'AI-First Precision',
    description: 'We weave intelligent automation directly into workflow friction points — from syntax refactoring to instant resume parsing.',
  },
  {
    icon: 'shield-check',
    title: 'Client-Side Sovereignty',
    description: 'Your code and files are your property. We leverage WebAssembly so operations happen on your machine without server upload.',
  },
  {
    icon: 'award',
    title: 'Production Quality',
    description: 'We build fast, robust, and accessible systems with high uptime and zero bloat, adhering to strict web standards.',
  },
  {
    icon: 'eye',
    title: 'Transparent & Free Forever',
    description: 'No trial periods, no hidden upgrades, no forced credit card inputs. Core utilities are free for all developers permanently.',
  },
];

const teamSocials = [
  { icon: 'github', label: 'GitHub', href: 'https://github.com/girishlade111' },
  { icon: 'linkedin', label: 'LinkedIn', href: 'https://www.linkedin.com/in/girish-lade-075bba201/' },
  { icon: 'instagram', label: 'Instagram', href: 'https://www.instagram.com/girish_lade_/' },
];

const skills = ['AI Systems', 'WebAssembly', 'TypeScript', 'Astro', 'UX/UI Engineering', 'Full-Stack Architecture'];
---

<BaseLayout
  title="About Lade Stack - Empowering Developers Through AI Innovation & Visionary Leadership"
  description="Discover Lade Stack's inspiring journey from a developer's vision to an AI-powered development ecosystem. Founded by Girish Lade, we democratize advanced development tools for creators worldwide."
  canonical="https://ladestack.in/about"
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: 'About Lade Stack - Visionary AI Development Tools & Founder Story',
    description: 'Learn how Girish Lade transformed from a passionate developer to founding Lade Stack - an AI-powered ecosystem revolutionizing how creators build, test, and deploy modern applications.',
    url: 'https://ladestack.in/about',
    type: 'website',
    image: 'https://ladestack.in/og-about.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'About Lade Stack - AI Development Revolution & Founder Story',
    description: "Discover how Girish Lade's vision became Lade Stack - transforming developer workflows through AI-powered tools and innovation.",
    image: 'https://ladestack.in/og-about.png',
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background">
    {/* Hero */}
    <section class="relative pt-20 pb-16 border-b border-border bg-surface-muted/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold text-foreground tracking-tight leading-tight text-balance">
          Empowering developers through AI automation and privacy
        </h1>
        <p class="mt-4 text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed text-pretty">
          Lade Stack was created to eliminate the paywalls, latency, and cloud compromises that hinder modern software engineering.
        </p>

        <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto">
          {
            heroStats.map((s) => (
              <div class="p-4 rounded-xl border border-border bg-surface text-center shadow-soft">
                <p class="text-2xl sm:text-3xl font-bold font-mono text-foreground">{s.value}</p>
                <p class="text-xs text-muted-foreground mt-1">{s.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Story & Timeline */}
    <section class="py-16 sm:py-24 border-b border-border bg-background">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-6 space-y-6">
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
              Built from real engineering frustrations
            </h2>
            <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
              In 2020, Girish Lade — an engineer and product designer — started creating tools to streamline his own development workflows. What began as small client-side scripts to manipulate PDFs and preview code snippets grew into a broader mission.
            </p>
            <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
              Most developer utilities today require recurring monthly subscriptions, credit cards, or upload sensitive code and documents to third-party cloud servers. Lade Stack was architected on a different principle: modern browsers are powerful computing platforms. By running WebAssembly and contextual intelligence on the client device, tools can be instantaneous, 100% private, and permanently free.
            </p>
            <div class="pt-2">
              <Button href="/apps" size="md">
                <span>Explore the Platform</span>
                <Icon name="arrow-right" class="w-4 h-4" />
              </Button>
            </div>
          </div>

          <div class="lg:col-span-6 pl-0 lg:pl-8">
            <div class="relative border-l border-border pl-6 space-y-8">
              {
                storyTimeline.map((item) => (
                  <div class="relative">
                    <span class="absolute -left-[31px] top-1 w-3 h-3 rounded-full bg-brand ring-4 ring-background"></span>
                    <span class="text-xs font-mono font-bold text-brand uppercase">{item.year}</span>
                    <h3 class="text-base font-semibold text-foreground mt-0.5">{item.title}</h3>
                    <p class="text-xs sm:text-sm text-muted-foreground mt-1 leading-relaxed">{item.text}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Core Values */}
    <section class="py-16 sm:py-24 border-b border-border bg-surface-muted/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          title="Our Core Engineering Principles"
          description="How we build, deploy, and maintain every single tool in the Lade Stack ecosystem."
        />

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            coreValues.map((val) => (
              <div class="rounded-xl border border-border bg-surface p-6 shadow-soft flex flex-col justify-between">
                <div>
                  <div class="w-10 h-10 rounded-lg bg-brand/10 text-brand flex items-center justify-center mb-4">
                    <Icon name={val.icon} class="w-5 h-5" />
                  </div>
                  <h3 class="text-base font-semibold text-foreground mb-2">
                    {val.title}
                  </h3>
                  <p class="text-xs text-muted-foreground leading-relaxed">
                    {val.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Founder Card */}
    <section class="py-16 sm:py-24 bg-background">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-2xl border border-border bg-surface p-8 sm:p-12 shadow-card flex flex-col md:flex-row items-center gap-8">
          <div class="w-28 h-28 rounded-2xl bg-brand/10 border border-brand/20 flex items-center justify-center font-mono font-bold text-3xl text-brand shrink-0">
            GL
          </div>
          <div class="text-center md:text-left flex-1">
            <h3 class="text-2xl font-bold text-foreground">Girish Lade</h3>
            <p class="text-xs font-mono text-brand font-semibold mb-3">Founder & Principal Developer</p>
            <p class="text-sm text-muted-foreground leading-relaxed mb-5">
              Engineer and designer passionate about AI systems, browser performance, and developer ergonomics. Leading the design and architecture of Lade Stack.
            </p>

            <div class="flex flex-wrap gap-1.5 justify-center md:justify-start mb-6">
              {skills.map((s) => (
                <span class="text-[11px] font-mono px-2.5 py-0.5 rounded bg-surface-muted border border-border text-muted-foreground">
                  {s}
                </span>
              ))}
            </div>

            <div class="flex items-center justify-center md:justify-start gap-4">
              {teamSocials.map((soc) => (
                <a
                  href={soc.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={soc.label}
                  class="p-2 rounded-lg border border-border bg-surface hover:bg-surface-muted text-muted-foreground hover:text-foreground transition-colors"
                >
                  <Icon name={soc.icon} class="w-4 h-4" />
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
