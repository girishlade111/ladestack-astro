---
/**
 * /[locale]/about — Localized About Page Route
 * Statically renders localized About pages for all 8 non-default languages:
 * ja, ko, zh, ru, tr, fr, pt, es.
 */
import type { GetStaticPaths } from 'astro';
import AboutPage from '../../components/pages/AboutPage.astro';
import { NON_DEFAULT_LOCALES, type Locale } from '../../i18n/config';

export const getStaticPaths = (() => {
  return NON_DEFAULT_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<AboutPage locale={locale} />
