---
/**
 * /[locale]/faq — Localized FAQ Page (8 Non-Default Locales)
 */
import FaqPage from '../../components/pages/FaqPage.astro';
import { NON_DEFAULT_LOCALES, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
---

<FaqPage locale={locale} />

