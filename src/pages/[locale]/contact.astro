---
/**
 * /[locale]/contact — Localized Contact Page (8 Non-Default Locales)
 */
import ContactPage from '../../components/pages/ContactPage.astro';
import { NON_DEFAULT_LOCALES, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
---

<ContactPage locale={locale} />
