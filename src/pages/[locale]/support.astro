---
/**
 * /[locale]/support — Localized Support Center (8 Non-Default Locales)
 */
import SupportPage from '../../components/pages/SupportPage.astro';
import { NON_DEFAULT_LOCALES, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
---

<SupportPage locale={locale} />
