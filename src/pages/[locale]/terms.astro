---
/**
 * /[locale]/terms — Localized Terms of Service (8 Non-Default Locales)
 */
import TermsPage from '../../components/pages/TermsPage.astro';
import { NON_DEFAULT_LOCALES, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
---

<TermsPage locale={locale} />
