---
/**
 * /[locale]/privacy — Localized Privacy Policy (8 Non-Default Locales)
 */
import PrivacyPage from '../../components/pages/PrivacyPage.astro';
import { NON_DEFAULT_LOCALES, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
---

<PrivacyPage locale={locale} />
