---
/**
 * /[locale]/docs — Localized Documentation & Guides (8 Non-Default Locales)
 */
import DocsPage from '../../components/pages/DocsPage.astro';
import { NON_DEFAULT_LOCALES, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
---

<DocsPage locale={locale} />
