---
/**
 * /privacy — Privacy Policy
 * Styled with Obsidian & Precision Emerald design tokens.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/ui/Badge.astro';
---

<BaseLayout
  title="Privacy Policy - Lade Stack"
  description="Read our Privacy Policy to understand how we collect, use, and protect your personal information at Lade Stack."
  canonical="https://ladestack.in/privacy"
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: 'Privacy Policy - Lade Stack',
    description: 'Read our Privacy Policy to understand how we collect, use, and protect your personal information at Lade Stack.',
    url: 'https://ladestack.in/privacy',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Privacy Policy - Lade Stack',
    description: 'Read our Privacy Policy to understand how we collect, use, and protect your personal information at Lade Stack.',
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={[]}
>
  <div class="min-h-screen bg-background text-foreground">
    {/* Header */}
    <section class="pt-20 pb-12 border-b border-border bg-surface-muted/20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Badge variant="brand" size="md" dot={true} class="mb-4">
          Data Governance
        </Badge>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-foreground">
          Privacy Policy
        </h1>
        <p class="mt-3 text-xs font-mono text-muted-foreground">
          Last Updated: June 15, 2024 · Effective Immediately
        </p>
      </div>
    </section>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      {/* Guarantees */}
      <div class="flex flex-wrap justify-center gap-3 mb-12">
        <div class="inline-flex items-center gap-2 bg-surface border border-border px-4 py-2 rounded-lg text-xs font-mono text-foreground">
          <Icon name="shield-check" class="w-4 h-4 text-brand" />
          <span>Client-Side Isolation</span>
        </div>
        <div class="inline-flex items-center gap-2 bg-surface border border-border px-4 py-2 rounded-lg text-xs font-mono text-foreground">
          <Icon name="lock" class="w-4 h-4 text-brand" />
          <span>Zero Server Storage for Files</span>
        </div>
        <div class="inline-flex items-center gap-2 bg-surface border border-border px-4 py-2 rounded-lg text-xs font-mono text-foreground">
          <Icon name="check-circle" class="w-4 h-4 text-brand" />
          <span>GDPR & Privacy Aligned</span>
        </div>
      </div>

      <div class="space-y-8 text-sm sm:text-base leading-relaxed text-muted-foreground max-w-[72ch] mx-auto">
        <div class="rounded-xl border border-border bg-surface p-6 sm:p-8 space-y-4">
          <h2 class="text-lg font-bold text-foreground">1. Client-Side Processing Architecture</h2>
          <p>
            Unlike traditional cloud SaaS platforms that transmit user files to remote servers for processing, Lade Stack’s core utilities — including the LS PDF Toolkit, LS Image Compressor, and AI Code Studio — execute primarily on the client machine via WebAssembly and in-browser execution threads.
          </p>
          <p>
            Your PDFs, images, source code, and resumes do not transit through or reside on our servers during manipulation.
          </p>
        </div>

        <div class="rounded-xl border border-border bg-surface p-6 sm:p-8 space-y-4">
          <h2 class="text-lg font-bold text-foreground">2. Information We Collect</h2>
          <p>
            We do not require account registration or credit cards to use our core utilities. We collect only minimal diagnostic telemetry necessary to maintain site stability and security:
          </p>
          <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm">
            <li>Aggregated visit metrics and referrer data</li>
            <li>Browser user-agent for WebAssembly feature detection</li>
            <li>Voluntarily submitted contact inquiries (name and email)</li>
          </ul>
        </div>

        <div class="rounded-xl border border-border bg-surface p-6 sm:p-8 space-y-4">
          <h2 class="text-lg font-bold text-foreground">3. Cookies and Local Storage</h2>
          <p>
            Lade Stack uses local browser storage exclusively for user preferences, specifically your selected theme (dark/light) and temporary editor drafts. We do not use third-party tracking pixels or behavioral advertising cookies.
          </p>
        </div>

        <div class="rounded-xl border border-border bg-surface p-6 sm:p-8 space-y-4">
          <h2 class="text-lg font-bold text-foreground">4. Contact & Inquiries</h2>
          <p>
            For privacy inquiries, audit verification, or questions regarding data protection, contact us at:
          </p>
          <p class="font-mono text-xs text-brand">
            admin@ladestack.in
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
