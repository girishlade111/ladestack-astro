---
/**
 * 404 — Not Found Page
 * NON-INDEXABLE: robots index:false, follow:false.
 * Styled with Obsidian & Precision Emerald design tokens.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="404 - Page Not Found - Lade Stack"
  description={null}
  canonical="https://ladestack.in/404"
  robots={{ index: false, follow: false, custom: null }}
  openGraph={{
    title: '404 - Page Not Found - Lade Stack',
    description: null,
    url: 'https://ladestack.in/404',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: '404 - Page Not Found - Lade Stack',
    description: null,
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={[]}
>
  <div class="flex flex-1 items-center justify-center py-24 sm:py-32 bg-background relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 hero-glow -z-10" aria-hidden="true"></div>

    <div class="text-center px-4 max-w-md mx-auto">
      <span class="font-mono text-xs font-bold text-brand uppercase tracking-wider">
        Error 404 · Route Not Found
      </span>
      <h1 class="mt-2 text-4xl sm:text-5xl font-bold tracking-tight text-foreground">
        Lost in cyberspace
      </h1>
      <p class="mt-4 text-sm text-muted-foreground leading-relaxed">
        The route you requested does not exist or may have been consolidated.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <Button href="/" size="md" class="w-full sm:w-auto">
          <span>Return to Homepage</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </Button>
        <Button href="/apps" variant="outline" size="md" class="w-full sm:w-auto">
          <span>Browse Utilities</span>
        </Button>
      </div>
    </div>
  </div>
</BaseLayout>
