---
/**
 * /apps/admin — Apps Admin Dashboard (dark dashboard).
 * NON-INDEXABLE: robots noindex/nofollow + sitemap filter.
 * Styled with Obsidian & Precision Emerald design tokens.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import appsData from '../../data/apps.json';

const apps = appsData as Array<{
  id: string;
  slug: string;
  title: string;
  tagline: string;
  description: string;
  icon: string;
  category: string;
  features: string[];
  timeToValue: string;
  integrations: string[];
  lifetimeFree: boolean;
  landingUrl: string;
  createdAt: string;
  popularityScore: number;
  iconAlt: string;
  comingSoon?: boolean;
}>;

const inputCls = 'w-full h-10 px-3 rounded-lg bg-surface border border-border text-foreground text-sm placeholder:text-muted-foreground focus:outline-none focus:border-brand';
---

<BaseLayout
  title="Apps Admin Dashboard - Lade Stack"
  description={null}
  canonical="https://ladestack.in/apps/admin"
  robots={{ index: false, follow: false, custom: null }}
  openGraph={{
    title: 'Apps Admin Dashboard - Lade Stack',
    description: null,
    url: 'https://ladestack.in/apps/admin',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Apps Admin Dashboard - Lade Stack',
    description: null,
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={[]}
>
  <div class="min-h-screen bg-background text-foreground py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-border">
        <div>
          <h1 class="text-2xl font-bold text-foreground">Apps Admin Dashboard</h1>
          <p class="text-xs text-muted-foreground mt-1">Manage catalog entries and export updated JSON</p>
        </div>
        <div class="flex items-center gap-3">
          <a href="/apps" class="text-xs font-semibold text-brand hover:underline">
            View Live Apps →
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        {/* Form */}
        <div class="lg:col-span-7 rounded-xl border border-border bg-surface p-6 shadow-soft space-y-4">
          <h2 class="text-base font-semibold text-foreground">Add New Application</h2>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-foreground mb-1">Title</label>
              <input data-admin-field="title" class={inputCls} placeholder="AI Code Studio" />
            </div>
            <div>
              <label class="block text-xs font-medium text-foreground mb-1">Slug</label>
              <input data-admin-field="slug" class={inputCls} placeholder="ai-code-studio" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-medium text-foreground mb-1">Tagline</label>
            <input data-admin-field="tagline" class={inputCls} placeholder="Short summary" />
          </div>

          <div>
            <label class="block text-xs font-medium text-foreground mb-1">Description</label>
            <textarea data-admin-field="description" rows="3" class="w-full p-3 rounded-lg bg-surface border border-border text-foreground text-sm placeholder:text-muted-foreground focus:outline-none focus:border-brand" placeholder="Full overview"></textarea>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-foreground mb-1">Category</label>
              <input data-admin-field="category" class={inputCls} placeholder="Developer Tool" />
            </div>
            <div>
              <label class="block text-xs font-medium text-foreground mb-1">Icon Path</label>
              <input data-admin-field="icon" class={inputCls} placeholder="/ai-code-viewer-project.svg" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-foreground mb-1">Time to Value</label>
              <input data-admin-field="timeToValue" class={inputCls} placeholder="30 sec" />
            </div>
            <div>
              <label class="block text-xs font-medium text-foreground mb-1">Popularity (0-100)</label>
              <input data-admin-field="popularityScore" type="number" class={inputCls} value="90" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-medium text-foreground mb-1">Landing URL</label>
            <input data-admin-field="landingUrl" class={inputCls} placeholder="https://code.ladestack.in/" />
          </div>

          <div class="pt-4 border-t border-border flex items-center justify-between">
            <button
              type="button"
              data-admin-add
              class="px-4 py-2 rounded-lg bg-brand text-brand-foreground text-xs font-semibold hover:bg-brand-hover transition-colors"
            >
              Add Application Entry
            </button>
            <button
              type="button"
              data-admin-save
              class="px-4 py-2 rounded-lg border border-border bg-surface hover:bg-surface-muted text-xs font-semibold text-foreground transition-colors"
            >
              Download Exported JSON
            </button>
          </div>
        </div>

        {/* Current list */}
        <div class="lg:col-span-5 rounded-xl border border-border bg-surface p-6 shadow-soft">
          <h2 class="text-base font-semibold text-foreground mb-4">Catalog Entries ({apps.length})</h2>
          <div class="space-y-3 max-h-[500px] overflow-y-auto pr-2" data-admin-list>
            {
              apps.map((app) => (
                <div class="p-3 rounded-lg border border-border bg-background flex items-center justify-between text-xs">
                  <div>
                    <p class="font-semibold text-foreground">{app.title}</p>
                    <p class="text-[11px] text-muted-foreground">{app.category} · {app.timeToValue}</p>
                  </div>
                  <span class={`font-mono text-[10px] ${app.comingSoon ? 'text-amber-500' : 'text-emerald-500'}`}>
                    {app.comingSoon ? 'Pipeline' : 'Live'}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
