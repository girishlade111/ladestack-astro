---
/**
 * /apps — full port of src/pages/AppsGallery.tsx.
 * Same hero, sticky filter bar (search + category chips + mobile filter),
 * app cards with badges/popularity, integrations marquee, bottom CTA.
 * Search + category filtering run client-side over server-rendered cards.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import appsData from '../../data/apps.json';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    description: 'A curated gallery of AI-powered developer tools built by Lade Stack.',
    name: 'Apps Gallery – Lade Stack',
    url: 'https://ladestack.in/apps',
  },
];

interface AppData {
  id: string;
  slug: string;
  title: string;
  tagline: string;
  description: string;
  icon: string;
  category: string;
  features: string[];
  timeToValue: string;
  integrations: string[];
  lifetimeFree: boolean;
  landingUrl: string;
  createdAt: string;
  popularityScore: number;
  iconAlt: string;
  comingSoon?: boolean;
}

const apps = appsData as AppData[];
const categories = ['All', ...Array.from(new Set(apps.map((a) => a.category))).sort()];
const liveCount = apps.filter((a) => !a.comingSoon).length;
const comingCount = apps.filter((a) => a.comingSoon).length;
const allIntegrations = [...new Set(apps.flatMap((a) => a.integrations))];

const categoryAccent: Record<string, { bg: string; text: string; border: string; glow: string }> = {
  'Developer Tool': { bg: 'bg-violet-500/10', text: 'text-violet-500', border: 'border-violet-500/20', glow: 'rgba(139,92,246,0.12)' },
  'API Tool': { bg: 'bg-sky-500/10', text: 'text-sky-500', border: 'border-sky-500/20', glow: 'rgba(14,165,233,0.12)' },
  'No-Code': { bg: 'bg-orange-500/10', text: 'text-orange-500', border: 'border-orange-500/20', glow: 'rgba(249,115,22,0.12)' },
  Productivity: { bg: 'bg-emerald-500/10', text: 'text-emerald-500', border: 'border-emerald-500/20', glow: 'rgba(16,185,129,0.12)' },
  'Docs AI': { bg: 'bg-pink-500/10', text: 'text-pink-500', border: 'border-pink-500/20', glow: 'rgba(236,72,153,0.12)' },
};
const defaultAccent = { bg: 'bg-[#6E8F6A]/10', text: 'text-[#6E8F6A]', border: 'border-[#6E8F6A]/20', glow: 'rgba(110,143,106,0.12)' };
const getAccent = (cat: string) => categoryAccent[cat] ?? defaultAccent;
const isNewApp = (createdAt: string) => Date.now() - new Date(createdAt).getTime() < 90 * 24 * 3600 * 1000;
const cardHref = (app: AppData) =>
  !app.comingSoon && app.id === 'ai-code-viewer' ? 'https://code.ladestack.in/' : app.landingUrl;
const isExternalHref = (app: AppData) =>
  !app.comingSoon && (app.landingUrl.startsWith('http') || app.id === 'ai-code-viewer');
---

<BaseLayout
  title="Apps Gallery – Lade Stack AI Developer Tools"
  description="Explore Lade Stack's suite of AI-powered developer tools: code editor, API testing, website builder, file sharing, and documentation AI. All free forever."
  canonical="https://ladestack.in/apps"
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: 'Apps Gallery – Lade Stack AI Developer Tools',
    description: 'Explore and launch AI-powered developer tools built by Lade Stack.',
    url: 'https://ladestack.in/apps',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Apps Gallery – Lade Stack AI Developer Tools',
    description: 'Explore and launch AI-powered developer tools built by Lade Stack.',
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background">
    <div class="pt-16">
      {/* HERO */}
      <section class="relative pt-24 pb-16 overflow-hidden">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[520px] bg-[radial-gradient(ellipse_at_top,_rgba(110,143,106,0.10),_transparent_60%)]"></div>
          <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full bg-violet-500/5 blur-3xl"></div>
          <div class="absolute top-40 -left-20 w-72 h-72 rounded-full bg-sky-500/5 blur-3xl"></div>
        </div>
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative">
          <div class="max-w-3xl mx-auto text-center">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#6E8F6A]/10 border border-[#6E8F6A]/20 text-[#6E8F6A] text-xs font-semibold mb-6">
              <Icon name="sparkles" class="w-3.5 h-3.5" />
              {liveCount} Live · {comingCount} Coming Soon
            </div>
            <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-foreground tracking-tight leading-[1.1] mb-5">
              The AI developer
              <br />
              <span class="text-[#6E8F6A]">toolkit</span>
            </h1>
            <p class="text-base sm:text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed mb-10">
              Every tool you need to code, test, document, and ship —
              powered by AI and free forever.
            </p>
            <div class="flex flex-wrap justify-center gap-8 sm:gap-12">
              {
                [
                  { value: `${apps.length}+`, label: 'Tools' },
                  { value: '100%', label: 'Free forever' },
                  { value: '24/7', label: 'Uptime' },
                  { value: '8K+', label: 'Developers' },
                ].map((s) => (
                  <div class="text-center">
                    <p class="text-2xl sm:text-3xl font-extrabold text-foreground">{s.value}</p>
                    <p class="text-xs text-muted-foreground mt-0.5">{s.label}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      {/* STICKY FILTER BAR */}
      <div class="sticky top-16 z-30 bg-background/80 backdrop-blur-md border-b border-border">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-3">
          <div class="flex items-center gap-3">
            <div class="relative w-full max-w-xs">
              <Icon name="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground pointer-events-none" />
              <input
                type="text"
                data-apps-search
                placeholder="Search tools…"
                aria-label="Search tools"
                class="w-full pl-9 pr-8 h-9 text-sm rounded-xl bg-muted/40 border border-border text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-[#6E8F6A]/40"
              />
              <button
                type="button"
                data-apps-clear-search
                class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground"
                aria-label="Clear search"
              >
                <Icon name="x" class="w-3.5 h-3.5" />
              </button>
            </div>
            <div class="hidden sm:flex items-center gap-2" data-apps-cats>
              {
                categories.map((cat) => (
                  <button
                    type="button"
                    data-apps-cat={cat}
                    class={`px-3.5 py-1.5 rounded-full text-xs font-semibold border transition-all duration-200 ${cat === 'All' ? 'bg-[#6E8F6A] border-[#6E8F6A] text-white shadow-sm' : 'bg-transparent border-border text-muted-foreground hover:text-foreground hover:border-foreground/30'}`}
                  >
                    {cat}
                  </button>
                ))
              }
            </div>
            <button
              type="button"
              data-apps-filter-toggle
              class="sm:hidden flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-border text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-muted/40 transition-colors"
            >
              <Icon name="filter" class="w-3.5 h-3.5" />
              Filter
            </button>
            <span class="ml-auto flex-shrink-0 text-xs text-muted-foreground" data-apps-count></span>
          </div>
          <div data-apps-mobile-filters class="sm:hidden overflow-hidden hidden">
            <div class="flex flex-wrap gap-2 pt-3">
              {
                categories.map((cat) => (
                  <button
                    type="button"
                    data-apps-cat-m={cat}
                    class={`px-3 py-1.5 rounded-full text-xs font-semibold border transition-all duration-200 ${cat === 'All' ? 'bg-[#6E8F6A] border-[#6E8F6A] text-white' : 'bg-transparent border-border text-muted-foreground'}`}
                  >
                    {cat}
                  </button>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      {/* APPS GRID */}
      <section class="py-12">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 max-w-6xl mx-auto" data-apps-grid>
            {
              apps.map((app) => {
                const ac = getAccent(app.category);
                const isLive = !app.comingSoon;
                const href = cardHref(app);
                const external = isExternalHref(app);
                const searchText = [app.title, app.tagline, app.description, ...app.features, ...app.integrations].join(' ').toLowerCase();
                const card = (
                  <div class="group relative flex flex-col h-full rounded-2xl border border-border bg-background overflow-hidden hover:-translate-y-1.5 hover:shadow-md transition-all duration-200">
                    <div
                      class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
                      style={`background: radial-gradient(ellipse at 50% 0%, ${ac.glow}, transparent 70%);`}
                    ></div>
                    <div class={`h-[3px] w-full ${ac.bg.replace('/10', '/50')}`}></div>
                    <div class="flex flex-col flex-1 p-6">
                      <div class="flex items-start justify-between mb-5">
                        <div class="relative">
                          <div class={`w-14 h-14 rounded-2xl flex items-center justify-center border overflow-hidden ${ac.border} ${ac.bg}`}>
                            <img src={app.icon} alt={app.iconAlt} loading="lazy" class="w-8 h-8 object-contain" />
                          </div>
                          {isLive && (
                            <span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-emerald-500 border-2 border-background"></span>
                          )}
                        </div>
                        <div class="flex flex-col items-end gap-1.5">
                          {isLive ? (
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-[11px] font-semibold">
                              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                              Live
                            </span>
                          ) : (
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 text-[11px] font-semibold">
                              <Icon name="clock" class="w-3 h-3" />
                              Coming Soon
                            </span>
                          )}
                          {isNewApp(app.createdAt) && (
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-[#6E8F6A]/10 border border-[#6E8F6A]/20 text-[#6E8F6A] text-[10px] font-bold uppercase tracking-wide">
                              <Icon name="sparkles" class="w-2.5 h-2.5" />
                              New
                            </span>
                          )}
                        </div>
                      </div>
                      <div class="mb-3">
                        <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold border ${ac.bg} ${ac.text} ${ac.border}`}>
                          {app.category}
                        </span>
                      </div>
                      <h3 class="text-[15px] font-bold text-foreground leading-snug mb-2 line-clamp-2 group-hover:text-[#6E8F6A] transition-colors duration-200">
                        {app.title}
                      </h3>
                      <p class="text-xs text-muted-foreground leading-relaxed mb-4 line-clamp-2">{app.tagline}</p>
                      <div class="flex flex-wrap gap-1.5 mb-5">
                        {app.features.slice(0, 3).map((f) => (
                          <span class="inline-flex items-center gap-1 text-[11px] text-muted-foreground px-2 py-0.5 rounded-md bg-muted/60 border border-border">
                            <Icon name="check-circle" class="w-2.5 h-2.5 text-[#6E8F6A]" />
                            {f}
                          </span>
                        ))}
                      </div>
                      <div class="mb-5">
                        <span class="inline-flex items-center gap-1 text-[11px] text-muted-foreground font-medium mb-1.5">
                          <Icon name="star" class="w-3 h-3 text-amber-400 fill-amber-400" />
                          Popularity score
                        </span>
                        <div class="flex items-center gap-2">
                          <div class="flex-1 h-1 rounded-full bg-border overflow-hidden">
                            <div class="h-full rounded-full bg-[#6E8F6A]" style={`width: ${app.popularityScore}%;`}></div>
                          </div>
                          <span class="text-[11px] font-semibold text-muted-foreground tabular-nums w-7 text-right">
                            {app.popularityScore}
                          </span>
                        </div>
                      </div>
                      <div class="flex-1"></div>
                      <div class="pt-4 border-t border-border flex items-center justify-between">
                        <div class="flex items-center gap-3 text-[11px] text-muted-foreground">
                          <span class="flex items-center gap-1">
                            <Icon name="zap" class="w-3 h-3 text-[#6E8F6A]" />
                            {app.timeToValue} setup
                          </span>
                          {app.lifetimeFree && (
                            <span class="flex items-center gap-1 text-[#6E8F6A] font-semibold">
                              <Icon name="check-circle" class="w-3 h-3" />
                              Free
                            </span>
                          )}
                        </div>
                        <span class={`flex items-center gap-1 text-xs font-semibold transition-all duration-200 group-hover:gap-2 ${isLive ? 'text-[#6E8F6A]' : 'text-muted-foreground'}`}>
                          {isLive ? (
                            <><Icon name="external-link" class="w-3.5 h-3.5" />Launch</>
                          ) : (
                            <><Icon name="arrow-right" class="w-3.5 h-3.5" />Details</>
                          )}
                        </span>
                      </div>
                    </div>
                  </div>
                );
                return (
                  <div data-app-card data-category={app.category} data-search-text={searchText} class="h-full">
                    {external ? (
                      <a href={href} target="_blank" rel="noopener noreferrer" class="block h-full">{card}</a>
                    ) : (
                      <a href={href} class="block h-full">{card}</a>
                    )}
                  </div>
                );
              })
            }
          </div>
          <div data-apps-empty class="hidden max-w-sm mx-auto py-24 text-center">
            <div class="w-16 h-16 rounded-full bg-muted flex items-center justify-center mx-auto mb-5">
              <Icon name="search" class="w-7 h-7 text-muted-foreground" />
            </div>
            <h3 class="text-lg font-bold text-foreground mb-2">No tools found</h3>
            <p class="text-sm text-muted-foreground mb-6">Try a different search or category.</p>
            <button
              type="button"
              data-apps-reset
              class="px-5 py-2.5 rounded-xl bg-[#6E8F6A] text-white text-sm font-semibold hover:bg-[#5F7F63] transition-colors"
            >
              Clear filters
            </button>
          </div>
        </div>
      </section>

      {/* INTEGRATIONS MARQUEE */}
      <section class="py-12 border-t border-border overflow-hidden">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 mb-6 text-center">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">
            Works with your stack
          </p>
        </div>
        <div class="relative">
          <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-background to-transparent z-10 pointer-events-none"></div>
          <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-background to-transparent z-10 pointer-events-none"></div>
          <div class="flex gap-3 apps-marquee" style="width: max-content;">
            {
              [...allIntegrations, ...allIntegrations].map((item) => (
                <span class="flex-shrink-0 px-5 py-2.5 rounded-full border border-border bg-background text-sm font-medium text-muted-foreground">
                  {item}
                </span>
              ))
            }
          </div>
        </div>
      </section>

      {/* BOTTOM CTA */}
      <section class="py-16">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="relative max-w-4xl mx-auto rounded-3xl overflow-hidden border border-[#6E8F6A]/25 bg-gradient-to-br from-[#6E8F6A]/8 via-background to-background p-10 sm:p-14 text-center">
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-96 h-40 bg-[#6E8F6A]/10 blur-3xl pointer-events-none"></div>
            <div class="relative">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#6E8F6A]/10 border border-[#6E8F6A]/20 text-[#6E8F6A] text-xs font-semibold mb-5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#6E8F6A] animate-pulse"></span>
                All tools are free forever
              </div>
              <h3 class="text-2xl sm:text-3xl font-bold text-foreground mb-3">Ready to build smarter?</h3>
              <p class="text-sm text-muted-foreground mb-8 max-w-lg mx-auto">
                Start with the AI Code Viewer now — no signup required.
                More tools launching very soon.
              </p>
              <div class="flex flex-col sm:flex-row gap-3 justify-center">
                <a
                  href="https://code.ladestack.in/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 h-12 px-8 rounded-xl bg-[#6E8F6A] hover:bg-[#5F7F63] text-white text-sm font-semibold transition-colors duration-200"
                >
                  <Icon name="external-link" class="w-4 h-4" />
                  Launch AI Code Viewer
                </a>
                <a
                  href="/about"
                  class="inline-flex items-center justify-center gap-2 h-12 px-8 rounded-xl border border-border bg-background hover:bg-muted/40 text-foreground text-sm font-semibold transition-colors duration-200"
                >
                  About Lade Stack
                  <Icon name="chevron-right" class="w-4 h-4" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <style>
    @keyframes apps-marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    .apps-marquee { animation: apps-marquee 30s linear infinite; }
  </style>

  <script is:inline>
    (function () {
      var search = document.querySelector('[data-apps-search]');
      var clearSearch = document.querySelector('[data-apps-clear-search]');
      var count = document.querySelector('[data-apps-count]');
      var empty = document.querySelector('[data-apps-empty]');
      var grid = document.querySelector('[data-apps-grid]');
      var category = 'All';
      function paintCats() {
        document.querySelectorAll('[data-apps-cat]').forEach(function (b) {
          var on = b.getAttribute('data-apps-cat') === category;
          b.className =
            'px-3.5 py-1.5 rounded-full text-xs font-semibold border transition-all duration-200 ' +
            (on
              ? 'bg-[#6E8F6A] border-[#6E8F6A] text-white shadow-sm'
              : 'bg-transparent border-border text-muted-foreground hover:text-foreground hover:border-foreground/30');
        });
        document.querySelectorAll('[data-apps-cat-m]').forEach(function (b) {
          var on = b.getAttribute('data-apps-cat-m') === category;
          b.className =
            'px-3 py-1.5 rounded-full text-xs font-semibold border transition-all duration-200 ' +
            (on ? 'bg-[#6E8F6A] border-[#6E8F6A] text-white' : 'bg-transparent border-border text-muted-foreground');
        });
      }
      function apply() {
        var q = ((search && search.value) || '').toLowerCase().trim();
        var n = 0;
        document.querySelectorAll('[data-app-card]').forEach(function (card) {
          var okCat = category === 'All' || card.getAttribute('data-category') === category;
          var okQ = !q || (card.getAttribute('data-search-text') || '').indexOf(q) !== -1;
          var show = okCat && okQ;
          card.classList.toggle('hidden', !show);
          if (show) n++;
        });
        if (count) count.textContent = n + ' ' + (n === 1 ? 'tool' : 'tools');
        if (empty) empty.classList.toggle('hidden', n > 0);
        if (grid) grid.classList.toggle('hidden', n === 0);
        if (clearSearch) {
          var has = !!(search && search.value);
          clearSearch.classList.toggle('hidden', !has);
        }
      }
      function setCategory(c) {
        category = c;
        paintCats();
        apply();
      }
      if (search) {
        search.addEventListener('input', apply);
        if (clearSearch) {
          clearSearch.addEventListener('click', function () {
            search.value = '';
            apply();
          });
        }
      }
      document.querySelectorAll('[data-apps-cat]').forEach(function (b) {
        b.addEventListener('click', function () { setCategory(b.getAttribute('data-apps-cat')); });
      });
      var mobileWrap = document.querySelector('[data-apps-mobile-filters]');
      var toggle = document.querySelector('[data-apps-filter-toggle]');
      if (toggle && mobileWrap) {
        toggle.addEventListener('click', function () { mobileWrap.classList.toggle('hidden'); });
      }
      document.querySelectorAll('[data-apps-cat-m]').forEach(function (b) {
        b.addEventListener('click', function () {
          setCategory(b.getAttribute('data-apps-cat-m'));
          if (mobileWrap) mobileWrap.classList.add('hidden');
        });
      });
      var reset = document.querySelector('[data-apps-reset]');
      if (reset) {
        reset.addEventListener('click', function () {
          if (search) search.value = '';
          setCategory('All');
        });
      }
      apply();
    })();
  </script>
</BaseLayout>
