---
/**
 * /docs — Documentation & Guides
 * Redesigned with Obsidian & Precision Emerald tokens,
 * interactive category guides, article modals, and platform changelog.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    description: 'Comprehensive documentation for Lade Stack developer tools.',
    name: 'Lade Stack Documentation',
    publisher: { '@type': 'Organization', name: 'Lade Stack' },
    url: 'https://ladestack.in/docs',
  },
];

const docsCategories = [
  {
    id: 'getting-started', icon: 'book-open', title: 'Getting Started', description: 'Core principles, architecture overview, and launching your first tool',
    overview: 'Welcome to Lade Stack. This guide outlines how client-side WebAssembly execution operates without server roundtrips.',
    sections: [
      { title: 'Instant Browser Launch', content: 'Open any Lade Stack URL directly in your browser. All WASM workers initialize locally in memory.' },
      { title: 'Local Sandbox Guarantees', content: 'Zero telemetry exfiltration. Files remain on your machine inside isolated browser memory buffers.' },
      { title: 'Exporting Artifacts', content: 'Export clean PDF documents, compressed assets, or compiled HTML/CSS bundles immediately.' },
    ],
  },
  {
    id: 'code-studio', icon: 'code-2', title: 'Code Studio Engine', description: 'In-browser compilation, AST parsing, and live enhancement',
    overview: 'Deep dive into the Code Studio execution environment and AST refactoring.',
    sections: [
      { title: 'Real-time Compilation', content: 'Instant parsing for HTML5, CSS3, and ESNext with syntax diagnostic flags.' },
      { title: 'Accessibility Enforcement', content: 'Automated injection of missing ARIA attributes and semantic landmark verification.' },
      { title: 'Exporting Bundles', content: 'Download production-ready static bundles with zero framework dependencies.' },
    ],
  },
  {
    id: 'pdf-wasm', icon: 'file-text', title: 'LS PDF Toolkit', description: '17 client-side PDF tools operating under strict privacy',
    overview: 'How WebAssembly handles client-side PDF byte manipulation with zero server upload.',
    sections: [
      { title: 'Merging & Splitting', content: 'Concatenate multiple PDF documents or extract discrete page ranges without quality degradation.' },
      { title: 'In-Browser Compression', content: 'Optimizes stream objects and fonts locally to reduce document payload sizes.' },
      { title: 'Security & Encryption', content: 'Encrypt PDFs with standard password hashing entirely in client memory.' },
    ],
  },
  {
    id: 'image-engine', icon: 'image', title: 'LS Image Engine', description: 'High-ratio image compression across 9+ modern formats',
    overview: 'In-browser canvas and WebAssembly compression algorithms.',
    sections: [
      { title: 'Supported Formats', content: 'JPEG, PNG, WebP, AVIF, SVG, TIFF, BMP, ICO, and HEIC.' },
      { title: 'Quality Controls', content: 'Lossy and lossless conversion modes with live side-by-side visual difference inspectors.' },
    ],
  },
];

const docsArticles = [
  {
    id: 'client-side-privacy', title: 'Understanding Client-Side Privacy Architecture', category: 'Security', readTime: '4 min read',
    intro: 'How Lade Stack eliminates data leakage risks through client-side WebAssembly.',
    steps: ['Browser memory sandbox allocation.', 'Local WebWorker payload processing.', 'Zero network transmission verification.', 'Clean garbage collection upon tab close.'],
    summary: 'By keeping all data in client memory, compliance with GDPR, HIPAA, and strict internal NDAs is maintained effortlessly.',
  },
  {
    id: 'optimizing-assets', title: 'Best Practices for Web Asset Compression', category: 'Performance', readTime: '6 min read',
    intro: 'Techniques to achieve 90%+ image and document size reduction without perceptual artifacts.',
    steps: ['Select the modern AVIF/WebP target format.', 'Calibrate chroma subsampling thresholds.', 'Strip redundant EXIF/metadata bytes.', 'Verify LCP scores on mobile viewports.'],
    summary: 'Optimized assets dramatically improve Core Web Vitals and reduce CDN egress costs.',
  },
];

const changelog = [
  { version: 'v1.0.0', date: 'October 2026', type: 'Major Release', description: 'Complete Obsidian & Precision Emerald redesign with enhanced accessibility, dark mode fidelity, and zero-JS core.' },
  { version: 'v0.9.4', date: 'August 2026', type: 'Improvement', description: 'Added 4 new client-side tools to the LS PDF suite.' },
  { version: 'v0.9.0', date: 'June 2026', type: 'Feature', description: 'Initial public launch of Code Studio real-time in-browser compilation engine.' },
];
---

<BaseLayout
  title="Documentation – Guides & API Reference | Lade Stack"
  description="Comprehensive documentation for Lade Stack's developer tools. Step-by-step guides, API references, and tutorials to get started quickly."
  canonical="https://ladestack.in/docs"
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: 'Lade Stack Documentation',
    description: "Guides, API references, and tutorials for Lade Stack's AI developer tools.",
    url: 'https://ladestack.in/docs',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Lade Stack Documentation',
    description: "Guides, API references, and tutorials for Lade Stack's AI developer tools.",
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background">
    {/* Hero */}
    <section class="relative pt-20 pb-14 border-b border-border bg-surface-muted/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Badge variant="brand" size="md" dot={true} class="mb-4">
          Documentation & References
        </Badge>
        <h1 class="text-3xl sm:text-5xl font-bold text-foreground tracking-tight leading-tight">
          Developer Documentation
        </h1>
        <p class="mt-4 text-base sm:text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed">
          Technical specifications, architecture guides, and tutorials for the entire Lade Stack suite.
        </p>

        <div class="mt-8 max-w-md mx-auto relative">
          <Icon name="search" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground pointer-events-none" />
          <input
            type="text"
            data-docs-search
            placeholder="Search documentation, tools, guides…"
            class="w-full h-10 pl-10 pr-4 rounded-lg border border-border bg-surface text-xs sm:text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-brand transition"
          />
        </div>
      </div>
    </section>

    {/* Topic categories */}
    <section class="py-14 sm:py-20 border-b border-border bg-background">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-10 text-center sm:text-left">
          <h2 class="text-xl sm:text-2xl font-bold text-foreground">Core Tool Topics</h2>
          <p class="text-xs sm:text-sm text-muted-foreground mt-1">Select a category to view the architecture guide.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            docsCategories.map((cat) => (
              <button
                type="button"
                data-docs-cat={cat.id}
                data-search-text={`${cat.title} ${cat.description}`.toLowerCase()}
                class="text-left rounded-xl border border-border bg-surface p-6 shadow-soft hover:border-brand/40 hover:shadow-card transition-all duration-200 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
              >
                <div class="w-10 h-10 rounded-lg bg-brand/10 text-brand flex items-center justify-center mb-4 transition-transform group-hover:scale-105">
                  <Icon name={cat.icon} class="w-5 h-5" />
                </div>
                <h3 class="text-base font-semibold text-foreground mb-1 group-hover:text-brand transition-colors">
                  {cat.title}
                </h3>
                <p class="text-xs text-muted-foreground leading-relaxed mb-4">
                  {cat.description}
                </p>
                <span class="text-xs font-semibold text-brand inline-flex items-center gap-1">
                  <span>View Guide</span>
                  <Icon name="arrow-right" class="w-3.5 h-3.5" />
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    {/* Articles */}
    <section class="py-14 sm:py-20 border-b border-border bg-surface-muted/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
          <h2 class="text-xl sm:text-2xl font-bold text-foreground">Featured Technical Articles</h2>
          <p class="text-xs sm:text-sm text-muted-foreground mt-1">Step-by-step guides written for modern developers.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl">
          {
            docsArticles.map((art) => (
              <div class="rounded-xl border border-border bg-surface p-6 shadow-soft flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between mb-3">
                    <Badge variant="brand" size="sm">{art.category}</Badge>
                    <span class="text-xs font-mono text-muted-foreground">{art.readTime}</span>
                  </div>
                  <h3 class="text-base font-semibold text-foreground mb-2">
                    {art.title}
                  </h3>
                  <p class="text-xs text-muted-foreground leading-relaxed mb-6">
                    {art.intro}
                  </p>
                </div>
                <button
                  type="button"
                  data-docs-open-article={art.id}
                  class="text-xs font-semibold text-brand hover:underline inline-flex items-center gap-1 self-start"
                >
                  <span>Read Full Article</span>
                  <Icon name="arrow-right" class="w-3.5 h-3.5" />
                </button>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Platform Changelog */}
    <section class="py-14 sm:py-20 bg-background">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8 text-center sm:text-left">
          <h2 class="text-xl sm:text-2xl font-bold text-foreground">Platform Release History</h2>
          <p class="text-xs sm:text-sm text-muted-foreground mt-1">Recent updates, architectural shifts, and performance enhancements.</p>
        </div>

        <div class="rounded-xl border border-border bg-surface divide-y divide-border overflow-hidden">
          {
            changelog.map((c) => (
              <div class="p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <span class="font-mono text-xs font-bold text-brand bg-brand/10 px-2 py-0.5 rounded">
                    {c.version}
                  </span>
                  <span class="text-sm font-semibold text-foreground">{c.type}</span>
                  <span class="text-xs font-mono text-muted-foreground">{c.date}</span>
                </div>
                <p class="text-xs text-muted-foreground sm:max-w-md">{c.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  {/* Dialogs */}
  {
    docsCategories.map((category) => (
      <dialog data-docs-dialog={category.id} class="max-w-2xl w-[calc(100%-2rem)] max-h-[85vh] overflow-y-auto rounded-2xl border border-border bg-surface p-6 sm:p-8 text-foreground shadow-elevated backdrop:bg-black/60">
        <div class="flex items-center justify-between pb-4 border-b border-border">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-brand/10 text-brand flex items-center justify-center">
              <Icon name={category.icon} class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-lg font-bold">{category.title}</h3>
              <p class="text-xs text-muted-foreground">{category.description}</p>
            </div>
          </div>
          <form method="dialog">
            <button class="p-1 text-muted-foreground hover:text-foreground rounded" aria-label="Close dialog">
              <Icon name="x" class="w-4 h-4" />
            </button>
          </form>
        </div>

        <div class="mt-6 space-y-6">
          <div class="p-4 rounded-xl border border-border bg-background text-xs sm:text-sm leading-relaxed text-muted-foreground">
            {category.overview}
          </div>

          <div class="space-y-4">
            {category.sections.map((sec) => (
              <div class="rounded-lg border border-border bg-surface-muted/40 p-4">
                <h4 class="text-sm font-semibold text-foreground mb-1.5">{sec.title}</h4>
                <p class="text-xs text-muted-foreground leading-relaxed">{sec.content}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-border flex justify-end">
          <form method="dialog">
            <Button variant="outline" size="sm">Close Guide</Button>
          </form>
        </div>
      </dialog>
    ))
  }

  {
    docsArticles.map((art) => (
      <dialog data-docs-article-dialog={art.id} class="max-w-2xl w-[calc(100%-2rem)] max-h-[85vh] overflow-y-auto rounded-2xl border border-border bg-surface p-6 sm:p-8 text-foreground shadow-elevated backdrop:bg-black/60">
        <div class="flex items-center justify-between pb-4 border-b border-border">
          <div>
            <Badge variant="brand" size="sm">{art.category}</Badge>
            <h3 class="text-lg font-bold mt-2">{art.title}</h3>
          </div>
          <form method="dialog">
            <button class="p-1 text-muted-foreground hover:text-foreground rounded" aria-label="Close dialog">
              <Icon name="x" class="w-4 h-4" />
            </button>
          </form>
        </div>

        <div class="mt-6 space-y-4">
          <p class="text-sm text-foreground leading-relaxed">{art.intro}</p>
          <div class="space-y-2">
            <p class="text-xs font-mono font-semibold uppercase tracking-wider text-muted-foreground">Execution Steps:</p>
            {art.steps.map((st, i) => (
              <div class="flex items-center gap-3 p-3 rounded-lg border border-border bg-background text-xs">
                <span class="w-5 h-5 rounded-md bg-brand/10 text-brand font-mono font-bold flex items-center justify-center shrink-0">
                  {i + 1}
                </span>
                <span class="text-foreground">{st}</span>
              </div>
            ))}
          </div>
          <div class="p-3.5 rounded-lg border border-brand/20 bg-brand/5 text-xs text-muted-foreground">
            <span class="font-semibold text-foreground">Summary:</span> {art.summary}
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-border flex justify-end">
          <form method="dialog">
            <Button variant="outline" size="sm">Close Article</Button>
          </form>
        </div>
      </dialog>
    ))
  }

  <script is:inline>
    (function () {
      document.querySelectorAll('[data-docs-cat]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var d = document.querySelector('[data-docs-dialog="' + btn.getAttribute('data-docs-cat') + '"]');
          if (d && d.showModal) d.showModal();
        });
      });
      document.querySelectorAll('[data-docs-open-article]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var d = document.querySelector('[data-docs-article-dialog="' + btn.getAttribute('data-docs-open-article') + '"]');
          if (d && d.showModal) d.showModal();
        });
      });
    })();
  </script>
</BaseLayout>
