---
/**
 * /gb-coder — GB Coder Flagship Product Showcase
 * Comprehensive marketing page for LadeStack's flagship browser-based development studio.
 * Accurately reflects the live application capabilities at https://code.ladestack.in/.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Accordion from '../components/ui/Accordion.astro';
import AccordionItem from '../components/ui/AccordionItem.astro';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'GB Coder',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web Browser (Chromium, Firefox, Safari)',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
    author: {
      '@type': 'Person',
      name: 'Girish Lade',
      url: 'https://github.com/girishlade111',
    },
    publisher: {
      '@type': 'Organization',
      name: 'LadeStack',
      url: 'https://ladestack.in',
    },
    url: 'https://ladestack.in/gb-coder',
    description: 'GB Coder is a browser-first development studio with Monaco Editor, instant live DOM preview, and WebContainer full-stack Node.js execution.',
  },
];

const featurePillars = [
  {
    icon: 'code-2',
    title: 'Monaco Code Editor',
    badge: 'VS Code Engine',
    description: 'The same industry-standard code editor behind VS Code. Features TypeScript syntax validation, autocomplete, multi-cursor editing, bracket matching, and code folding.',
  },
  {
    icon: 'eye',
    title: 'Instant Live Preview',
    badge: 'Synchronized DOM',
    description: 'Instant preview renders your HTML, CSS, and modern JavaScript as you type. Includes detached popout preview windows and mobile QR code inspection on local networks.',
  },
  {
    icon: 'cpu',
    title: 'WebContainer Micro-OS',
    badge: 'Node.js in Memory',
    description: 'Execute genuine Node.js processes, run npm package scripts, boot Vite development servers, and prototype with full React and Vue starter architectures directly in browser memory.',
  },
  {
    icon: 'shield-check',
    title: 'Local-First Persistence',
    badge: '100% Client Privacy',
    description: 'Workspaces are saved securely to IndexedDB on your device. Zero telemetry uploads, no mandatory account signups, and zero third-party cloud data exposure.',
  },
  {
    icon: 'layers',
    title: 'Multi-File Architecture',
    badge: 'Modular Structure',
    description: 'Organize complex web components across multiple files and directories with clean file explorer navigation and tab management.',
  },
  {
    icon: 'download',
    title: 'Tamper-Proof Backups',
    badge: 'ZIP Archives',
    description: 'Export workspaces into standard ZIP archives anytime with full directory structures preserved. Restore previous projects with single-click import.',
  },
];

const faqs = [
  {
    q: 'How does GB Coder execute full-stack code without a remote server?',
    a: 'GB Coder uses WebContainer technology, which runs genuine Node.js processes and WebAssembly micro-environments directly inside your browser tab using SharedArrayBuffer and cross-origin isolation (COOP/COEP). Development servers and build steps run entirely on your local machine hardware.',
  },
  {
    q: 'What is the difference between the Static Editor and the WebContainer IDE?',
    a: 'The Static & Multi-File Editor provides instantaneous, zero-overhead DOM rendering for HTML, CSS, and vanilla/CDN JavaScript with universal browser support. The Advanced WebContainer IDE runs Node.js package managers, npm scripts, and modern frontend frameworks like React and Vue.',
  },
  {
    q: 'Are my source code and projects uploaded to LadeStack servers?',
    a: 'No. GB Coder operates on a strict local-first model. Your code, assets, and workspace states are saved directly to IndexedDB within your browser. LadeStack does not store or track your project code on remote servers.',
  },
  {
    q: 'What browsers support GB Coder?',
    a: 'The Static Editor works universally across all modern browsers including Safari, Chrome, Edge, and Firefox. The WebContainer full-stack environment requires browsers supporting SharedArrayBuffer and cross-origin isolation (Google Chrome v92+, Microsoft Edge v92+, Brave, and Mozilla Firefox v79+).',
  },
  {
    q: 'Is GB Coder completely free?',
    a: 'Yes, 100% free forever. There are no subscription tiers, no credit card requirements, and no daily compile quotas. It is developed and maintained by Girish Lade as part of the open LadeStack developer ecosystem.',
  },
];
---

<BaseLayout
  title="GB Coder — In-Browser IDE & Development Studio | LadeStack"
  description="Build, run, and preview web code instantly with GB Coder. Monaco Editor, live DOM preview, WebContainer Node.js execution, and local-first privacy. Free forever."
  canonical="https://ladestack.in/gb-coder"
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: 'GB Coder — In-Browser IDE & Development Studio | LadeStack',
    description: 'Build, run, and preview web code instantly with GB Coder. Monaco Editor, live DOM preview, WebContainer Node.js execution, and local-first privacy. Free forever.',
    url: 'https://ladestack.in/gb-coder',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'GB Coder — In-Browser IDE & Development Studio | LadeStack',
    description: 'Full-stack in-browser web development powered by Monaco Editor, WebContainer execution, and local-first data privacy.',
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background">
    {/* ── HERO SECTION ── */}
    <section class="relative pt-20 pb-20 sm:pt-28 sm:pb-32 overflow-hidden border-b border-border bg-surface-muted/20">
      <div class="pointer-events-none absolute inset-0 hero-glow -z-10" aria-hidden="true"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-brand/30 bg-brand/10 text-xs font-mono text-brand mb-6">
          <span class="w-2 h-2 rounded-full bg-brand"></span>
          Browser-First Web Development Studio
        </div>

        <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-foreground text-balance leading-[1.08] max-w-4xl mx-auto">
          Build, run, and ship code <span class="text-brand">instantly in your browser</span>.
        </h1>

        <p class="mt-6 text-base sm:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed text-pretty">
          From rapid HTML, CSS, and modern JavaScript prototyping to full-stack Node.js development with React and Vue starters. Powered by Monaco Editor, WebContainer execution, and local-first privacy.
        </p>

        {/* Primary CTAs */}
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <Button href="https://code.ladestack.in/app/projects" target="_blank" size="lg" class="w-full sm:w-auto">
            <span>Launch GB Coder Studio</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </Button>
          <Button href="https://code.ladestack.in/" target="_blank" variant="outline" size="lg" class="w-full sm:w-auto">
            <span>Visit code.ladestack.in</span>
            <Icon name="arrow-up-right" class="w-4 h-4 text-muted-foreground" />
          </Button>
        </div>

        {/* Trust Badges */}
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs text-muted-foreground font-mono">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="shield-check" class="w-4 h-4 text-brand" />
            100% In-Browser Privacy
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="zap" class="w-4 h-4 text-brand" />
            Sub-millisecond Compilation
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="gift" class="w-4 h-4 text-brand" />
            Free Forever · Zero Paywalls
          </span>
        </div>
      </div>
    </section>

    {/* ── TWO DEDICATED ENVIRONMENTS ── */}
    <section class="py-16 sm:py-24 border-b border-border bg-background">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="Dual Architecture"
          title="Two Dedicated Editing Environments"
          description="Choose the exact level of power your current project requires — zero setup friction."
        />

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {/* Card 1: Static Prototyping */}
          <div class="rounded-2xl border border-border bg-surface p-8 shadow-card flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <Badge variant="outline" size="md">Universal Support</Badge>
                <span class="text-xs font-mono text-muted-foreground">HTML · CSS · JS</span>
              </div>

              <h3 class="text-2xl font-bold text-foreground">Static &amp; Multi-File Editor</h3>
              <p class="mt-3 text-sm text-muted-foreground leading-relaxed">
                Immediate visual feedback for HTML5, CSS3, and modern JavaScript. Perfect for quick UI experimentation, landing pages, component testing, and external CDN scripts without waiting for build steps.
              </p>

              <div class="mt-6 space-y-2.5">
                <div class="flex items-center gap-2 text-xs text-foreground">
                  <Icon name="check-circle-2" class="w-4 h-4 text-brand shrink-0" />
                  <span>Sub-millisecond DOM synchronization as you type</span>
                </div>
                <div class="flex items-center gap-2 text-xs text-foreground">
                  <Icon name="check-circle-2" class="w-4 h-4 text-brand shrink-0" />
                  <span>External CDN library injection (Tailwind, Lucide, Bootstrap)</span>
                </div>
                <div class="flex items-center gap-2 text-xs text-foreground">
                  <Icon name="check-circle-2" class="w-4 h-4 text-brand shrink-0" />
                  <span>Works universally across Safari, Chrome, Edge, and Firefox</span>
                </div>
              </div>
            </div>

            <div class="mt-8 pt-6 border-t border-border flex items-center justify-between">
              <span class="text-xs font-mono text-muted-foreground">Zero build delay</span>
              <a href="https://code.ladestack.in/" target="_blank" class="text-xs font-semibold text-brand hover:underline inline-flex items-center gap-1">
                <span>Start Prototyping</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>

          {/* Card 2: Advanced WebContainer IDE */}
          <div class="rounded-2xl border border-brand/50 bg-surface p-8 shadow-card flex flex-col justify-between relative overflow-hidden">
            <div class="absolute -top-12 -right-12 w-32 h-32 rounded-full bg-brand/10 blur-2xl pointer-events-none"></div>

            <div>
              <div class="flex items-center justify-between mb-4">
                <Badge variant="brand" size="md">Full-Stack Micro-OS</Badge>
                <span class="text-xs font-mono text-brand font-semibold">Node.js In-Browser</span>
              </div>

              <h3 class="text-2xl font-bold text-foreground">Advanced WebContainer IDE</h3>
              <p class="mt-3 text-sm text-muted-foreground leading-relaxed">
                Full-stack Node.js environment running directly in browser memory. Run npm install, execute package scripts, boot Vite development servers, and work with full React and Vue starter architectures.
              </p>

              <div class="mt-6 space-y-2.5">
                <div class="flex items-center gap-2 text-xs text-foreground">
                  <Icon name="check-circle-2" class="w-4 h-4 text-brand shrink-0" />
                  <span>Execute Node.js runtimes and npm package installations</span>
                </div>
                <div class="flex items-center gap-2 text-xs text-foreground">
                  <Icon name="check-circle-2" class="w-4 h-4 text-brand shrink-0" />
                  <span>React &amp; Vue starter templates with hot module reloading</span>
                </div>
                <div class="flex items-center gap-2 text-xs text-foreground">
                  <Icon name="check-circle-2" class="w-4 h-4 text-brand shrink-0" />
                  <span>SharedArrayBuffer &amp; Web Worker isolated sandbox</span>
                </div>
              </div>
            </div>

            <div class="mt-8 pt-6 border-t border-border flex items-center justify-between">
              <span class="text-xs font-mono text-muted-foreground">Chromium &amp; Firefox</span>
              <a href="https://code.ladestack.in/app/projects" target="_blank" class="text-xs font-semibold text-brand hover:underline inline-flex items-center gap-1">
                <span>Launch WebContainer IDE</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── CORE CAPABILITIES GRID ── */}
    <section class="py-16 sm:py-24 border-b border-border bg-surface-muted/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="Feature Pillars"
          title="Engineered for Precision, Speed, and Privacy"
          description="Every feature in GB Coder was built to deliver enterprise coding capabilities inside your browser."
        />

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            featurePillars.map((feat) => (
              <div class="rounded-xl border border-border bg-surface p-6 shadow-soft flex flex-col justify-between hover:border-brand/40 transition-colors">
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <div class="w-10 h-10 rounded-lg bg-brand/10 text-brand flex items-center justify-center">
                      <Icon name={feat.icon} class="w-5 h-5" />
                    </div>
                    <Badge variant="outline" size="sm">
                      {feat.badge}
                    </Badge>
                  </div>
                  <h3 class="text-lg font-bold text-foreground">
                    {feat.title}
                  </h3>
                  <p class="mt-2 text-xs text-muted-foreground leading-relaxed">
                    {feat.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ── BROWSER SUPPORT TRANSPARENCY ── */}
    <section class="py-16 sm:py-24 border-b border-border bg-background">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-2xl border border-border bg-surface p-8 sm:p-12 shadow-card">
          <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
            <div class="space-y-3 max-w-xl">
              <span class="text-xs font-mono font-semibold uppercase tracking-wider text-brand">
                Technical Guardrails &amp; Boundaries
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight">
                WebContainer Runtime &amp; Browser Compatibility
              </h2>
              <p class="text-sm text-muted-foreground leading-relaxed">
                GB Coder leverages WebContainers for running genuine Node.js processes inside modern browsers that support SharedArrayBuffer and cross-origin isolation (COOP/COEP).
              </p>
              <p class="text-sm text-muted-foreground leading-relaxed">
                For lightweight prototyping or browsers where WebContainer isolation headers are restricted, our Static Editor provides an instant fallback with zero external dependencies, ensuring seamless coding across every modern operating system.
              </p>
            </div>

            <div class="w-full lg:w-72 p-5 rounded-xl border border-border bg-surface-muted/50 space-y-3 font-mono text-xs">
              <p class="font-semibold text-foreground uppercase tracking-wider text-[11px]">
                Supported Environments
              </p>
              <div class="space-y-2 text-muted-foreground">
                <div class="flex items-center justify-between">
                  <span>Google Chrome</span>
                  <span class="text-brand font-semibold">v92+</span>
                </div>
                <div class="flex items-center justify-between">
                  <span>Microsoft Edge</span>
                  <span class="text-brand font-semibold">v92+</span>
                </div>
                <div class="flex items-center justify-between">
                  <span>Brave Browser</span>
                  <span class="text-brand font-semibold">Supported</span>
                </div>
                <div class="flex items-center justify-between">
                  <span>Mozilla Firefox</span>
                  <span class="text-brand font-semibold">v79+</span>
                </div>
                <div class="flex items-center justify-between">
                  <span>Apple Safari</span>
                  <span class="text-foreground font-semibold">Static Mode</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── FAQ SECTION ── */}
    <section class="py-16 sm:py-24 border-b border-border bg-surface-muted/20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="Technical Q&amp;A"
          title="Frequently Asked Questions"
          description="Clear, honest details regarding GB Coder's capabilities, architecture, and runtime boundaries."
        />

        <Accordion>
          {
            faqs.map((faq, index) => (
              <AccordionItem question={faq.q} open={index === 0}>
                <p>{faq.a}</p>
              </AccordionItem>
            ))
          }
        </Accordion>
      </div>
    </section>

    {/* ── CLOSING CTA ── */}
    <section class="py-16 sm:py-24 bg-background">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-foreground">
          Ready to experience browser-first web coding?
        </h2>
        <p class="text-base text-muted-foreground max-w-xl mx-auto leading-relaxed">
          No credit card, no sign-up form, and no server configuration required. Jump straight into the workspace.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
          <Button href="https://code.ladestack.in/app/projects" target="_blank" size="lg" class="w-full sm:w-auto">
            <span>Launch GB Coder Studio</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </Button>
          <Button href="/apps" variant="outline" size="lg" class="w-full sm:w-auto">
            <span>Explore All Utilities</span>
            <Icon name="layers" class="w-4 h-4 text-muted-foreground" />
          </Button>
        </div>

        <p class="text-xs font-mono text-muted-foreground pt-4">
          GB Coder by LadeStack · 100% In-Browser · Free Forever
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
