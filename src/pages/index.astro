---
/**
 * / — Homepage
 * Redesigned with Obsidian & Precision Emerald design system,
 * zero-JS Astro architecture, and complete SEO / structured data.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import FeaturesBento from '../components/sections/FeaturesBento.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import UseCases from '../components/sections/UseCases.astro';
import ProductShowcase from '../components/sections/ProductShowcase.astro';
import DeveloperFaq, { faqs } from '../components/sections/DeveloperFaq.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    applicationCategory: 'DeveloperApplication',
    description:
      'AI-powered developer platform with in-browser code editor, 17-in-1 PDF toolkit, image compressor, and productivity utilities.',
    name: 'Lade Stack',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    operatingSystem: 'Web Browser',
    url: 'https://ladestack.in',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    contactPoint: {
      '@type': 'ContactPoint',
      availableLanguage: 'English',
      contactType: 'customer support',
      email: 'admin@ladestack.in',
    },
    description: 'AI-powered developer tools and SaaS solutions for modern engineering teams.',
    founder: { '@type': 'Person', name: 'Girish Lade', url: 'https://github.com/girishlade111' },
    logo: 'https://ladestack.in/favicon.ico',
    name: 'Lade Stack',
    sameAs: [
      'https://github.com/girishlade111',
      'https://www.linkedin.com/in/girish-lade-075bba201/',
      'https://www.instagram.com/girish_lade_/',
      'https://codepen.io/Girish-Lade-the-looper',
    ],
    url: 'https://ladestack.in',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    aggregateRating: { '@type': 'AggregateRating', ratingCount: '150', ratingValue: '4.8' },
    applicationCategory: 'DeveloperApplication',
    author: { '@type': 'Person', name: 'Girish Lade', url: 'https://github.com/girishlade111' },
    description:
      'AI-powered developer tools including in-browser code editor, PDF toolkit, image optimizer, and ATS resume builder.',
    name: 'Lade Stack',
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      price: '0',
      priceCurrency: 'USD',
    },
    operatingSystem: 'Web Browser',
    url: 'https://ladestack.in',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    description: 'AI-Powered Developer Tools & In-Browser Utilities',
    name: 'Lade Stack',
    publisher: { '@type': 'Organization', name: 'Lade Stack' },
    url: 'https://ladestack.in',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];
---

<BaseLayout
  title="Lade Stack – AI Developer Platform | Code Studio, PDF Toolkit & Developer Utilities"
  description="The complete AI developer ecosystem. In-browser code editing, 17-in-1 private PDF toolkit, high-ratio image compression, and career utilities — free forever."
  canonical="https://ladestack.in/"
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: 'Lade Stack – AI-Powered Developer Ecosystem',
    description:
      'In-browser AI code studio, private PDF tools, image compressor, and productivity utilities for 10x developer productivity. Free forever.',
    url: 'https://ladestack.in/',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Lade Stack – AI-Powered Developer Ecosystem',
    description:
      'In-browser AI code studio, private PDF tools, image compressor, and productivity utilities for 10x developer productivity. Free forever.',
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={structuredData}
>
  <HeroSection />
  <FeaturesBento />
  <HowItWorks />
  <UseCases />
  <ProductShowcase />
  <DeveloperFaq />
  <CtaBanner />
</BaseLayout>
