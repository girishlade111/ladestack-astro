---
/**
 * / — Homepage
 * Redesigned with Obsidian & Precision Emerald design system,
 * zero-JS Astro architecture, and complete SEO / structured data.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import FeaturesBento from '../components/sections/FeaturesBento.astro';
import MissionVisionSection from '../components/sections/MissionVisionSection.astro';
import CoreValuesSection from '../components/sections/CoreValuesSection.astro';
import MetricsImpactSection from '../components/sections/MetricsImpactSection.astro';
import FreeForeverSection from '../components/sections/FreeForeverSection.astro';
import DeveloperCommunitySection from '../components/sections/DeveloperCommunitySection.astro';
import DeveloperFaq, { faqs } from '../components/sections/DeveloperFaq.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';
import { LOCALES, type Locale } from '../i18n/config';
import { getHreflangLinks, useTranslations } from '../i18n/utils';

const locale: Locale = 'en';
const t = useTranslations(locale);
const hreflangs = getHreflangLinks('/', LOCALES);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    contactPoint: {
      '@type': 'ContactPoint',
      availableLanguage: 'English',
      contactType: 'customer support',
      email: 'admin@ladestack.in',
    },
    description: 'AI-powered developer tools and browser utilities for modern engineering workflows.',
    founder: { '@type': 'Person', name: 'Girish Lade', url: 'https://github.com/girishlade111' },
    logo: 'https://ladestack.in/logo.png',
    name: 'Lade Stack',
    sameAs: [
      'https://github.com/girishlade111',
      'https://www.linkedin.com/in/girish-lade-075bba201/',
      'https://www.instagram.com/girish_lade_/',
      'https://codepen.io/Girish-Lade-the-looper',
    ],
    url: 'https://ladestack.in',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    applicationCategory: 'DeveloperApplication',
    author: { '@type': 'Person', name: 'Girish Lade', url: 'https://github.com/girishlade111' },
    description:
      'In-browser developer tools including code editor, PDF toolkit, image optimizer, and productivity utilities.',
    name: 'Lade Stack',
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      price: '0',
      priceCurrency: 'USD',
    },
    operatingSystem: 'Web Browser',
    url: 'https://ladestack.in',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    description: 'AI-Powered Developer Tools & In-Browser Utilities',
    name: 'Lade Stack',
    publisher: { '@type': 'Organization', name: 'Lade Stack' },
    url: 'https://ladestack.in',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];
---

<BaseLayout
  title={t('seo.homeTitle')}
  description={t('seo.homeDescription')}
  canonical="https://ladestack.in"
  hreflangs={hreflangs}
  locale={locale}
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: t('seo.ogTitle'),
    description: t('seo.ogDescription'),
    url: 'https://ladestack.in',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: t('seo.ogTitle'),
    description: t('seo.ogDescription'),
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={structuredData}
>
  <HeroSection locale={locale} />
  <FeaturesBento locale={locale} />
  <MissionVisionSection locale={locale} />
  <CoreValuesSection locale={locale} />
  <MetricsImpactSection locale={locale} />
  <FreeForeverSection locale={locale} />
  <DeveloperCommunitySection locale={locale} />
  <DeveloperFaq locale={locale} />
  <CtaBanner locale={locale} />
</BaseLayout>
