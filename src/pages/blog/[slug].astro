---
/**
 * /blog/:slug — Single Post Layout
 * Strictly adheres to 65-75ch readable measure, sticky Table of Contents (TOC),
 * token-based syntax blocks, share links, and related articles.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Badge from '../../components/ui/Badge.astro';
import { blogPosts } from '../../data/blogPosts';
import { blogContent } from '../../data/blogContent';
import { categoryColors, FALLBACK_IMAGE } from '../../data/categories';
import { renderArticle, extractHeadings } from '../../lib/markdown';

export function getStaticPaths() {
  return blogPosts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const canonical = `https://ladestack.in/blog/${post.slug}`;
const title = `${post.title} | Lade Stack Blog`;
const coverImage = `https://ladestack.in/blog-covers/${post.image}.svg`;
const rawContent = blogContent[post.slug] ?? '';
const bodyHtml = renderArticle(rawContent);
const headings = extractHeadings(rawContent);
const c = categoryColors(post.category);

const dateLong = new Date(post.date + 'T00:00:00').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const dateShort = new Date(post.date + 'T00:00:00').toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const relatedPosts = blogPosts.filter((p) => p.id !== post.id && p.category === post.category).slice(0, 3);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    articleSection: post.category,
    author: { '@type': 'Person', name: post.author, url: 'https://ladestack.in/about' },
    dateModified: post.date,
    datePublished: post.date,
    description: post.excerpt,
    headline: post.title,
    image: coverImage,
    keywords: post.keywords.join(', '),
    mainEntityOfPage: { '@id': canonical, '@type': 'WebPage' },
    publisher: {
      '@type': 'Organization',
      logo: { '@type': 'ImageObject', url: 'https://ladestack.in/logo.png' },
      name: 'Lade Stack',
    },
  },
];
---

<BaseLayout
  title={title}
  description={post.excerpt}
  canonical={canonical}
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{ title, description: post.excerpt, url: canonical, type: 'article', image: coverImage }}
  twitter={{ card: 'summary_large_image', title, description: post.excerpt, image: coverImage }}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background">
    {/* Article Header & Hero */}
    <header class="pt-12 pb-8 border-b border-border bg-surface-muted/20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Breadcrumb */}
        <nav class="flex items-center gap-1.5 text-xs text-muted-foreground mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-foreground transition-colors">Home</a>
          <span>/</span>
          <a href="/blog" class="hover:text-foreground transition-colors">Blog</a>
          <span>/</span>
          <span class="text-foreground font-medium truncate max-w-[200px]">{post.category}</span>
        </nav>

        <div class="flex items-center gap-2 mb-4">
          <Badge variant="brand" size="sm">
            {post.category}
          </Badge>
          <span class="text-xs font-mono text-muted-foreground">
            {post.readTime}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-foreground leading-[1.15] tracking-tight mb-4 text-balance">
          {post.title}
        </h1>

        <p class="text-base sm:text-lg text-muted-foreground leading-relaxed mb-6 text-pretty">
          {post.excerpt}
        </p>

        <div class="flex items-center justify-between pt-4 border-t border-border/80 text-xs text-muted-foreground">
          <div class="flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-full bg-brand/10 text-brand font-semibold flex items-center justify-center font-mono">
              GL
            </div>
            <div>
              <span class="font-medium text-foreground">{post.author}</span>
              <span class="mx-1.5">·</span>
              <span>{dateLong}</span>
            </div>
          </div>

          <button
            type="button"
            data-copy-link
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-border bg-surface hover:bg-surface-muted text-foreground transition-colors"
          >
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span data-copy-label>Share Link</span>
          </button>
        </div>
      </div>
    </header>

    {/* Cover Art Banner */}
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 my-8">
      <div class="rounded-2xl border border-border bg-surface-muted overflow-hidden aspect-[16/8] shadow-card">
        <img
          src={`/blog-covers/${post.image}.svg`}
          alt={post.title}
          data-cover-fallback
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    {/* Reading Layout (Readable Measure 65-75ch + Sticky TOC) */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 xl:gap-14">
        {/* Main Article Body: 65–75ch measure */}
        <article class="lg:col-span-8 max-w-[72ch] min-w-0">
          <div class="prose-clean text-foreground" set:html={bodyHtml} />

          {/* Keywords */}
          {
            post.keywords.length > 0 && (
              <div class="mt-12 pt-6 border-t border-border">
                <p class="text-xs font-mono font-semibold text-muted-foreground uppercase tracking-wider mb-2.5">
                  Indexed Keywords
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {post.keywords.map((kw) => (
                    <span class="text-xs font-mono px-2.5 py-1 rounded-md border border-border bg-surface-muted text-muted-foreground">
                      #{kw}
                    </span>
                  ))}
                </div>
              </div>
            )
          }

          {/* Share & Back */}
          <div class="mt-10 pt-6 border-t border-border flex items-center justify-between">
            <button
              type="button"
              data-copy-link
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-border bg-surface hover:bg-surface-muted text-xs font-medium text-foreground transition-colors"
            >
              <Icon name="copy" class="w-4 h-4" />
              <span data-copy-label>Copy Article Link</span>
            </button>

            <a
              href="/blog"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand hover:underline"
            >
              <Icon name="arrow-left" class="w-3.5 h-3.5" />
              <span>Back to Articles</span>
            </a>
          </div>
        </article>

        {/* Sidebar: Table of Contents + Metadata */}
        <aside class="hidden lg:block lg:col-span-4">
          <div class="sticky top-24 space-y-6">
            {/* TOC Card */}
            {headings.length > 0 && (
              <div class="rounded-xl border border-border bg-surface p-5">
                <p class="text-xs font-mono font-semibold uppercase tracking-wider text-muted-foreground mb-3 flex items-center gap-2">
                  <Icon name="list" class="w-3.5 h-3.5 text-brand" />
                  Table of Contents
                </p>
                <nav class="space-y-1.5 text-xs" aria-label="Table of Contents">
                  {headings.map((h) => (
                    <a
                      href={`#${h.id}`}
                      class={`block text-muted-foreground hover:text-brand transition-colors leading-snug ${
                        h.level === 3 ? 'pl-3 text-[11px]' : 'font-medium'
                      }`}
                    >
                      {h.text}
                    </a>
                  ))}
                </nav>
              </div>
            )}

            {/* Author details */}
            <div class="rounded-xl border border-border bg-surface p-5">
              <p class="text-xs font-mono font-semibold uppercase tracking-wider text-muted-foreground mb-3">
                Author & Engineering Team
              </p>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-brand/10 border border-brand/20 text-brand flex items-center justify-center font-mono font-bold">
                  GL
                </div>
                <div>
                  <p class="text-sm font-semibold text-foreground">{post.author}</p>
                  <p class="text-xs text-muted-foreground">Founder & Lead Engineer</p>
                </div>
              </div>
              <p class="mt-3 text-xs text-muted-foreground leading-relaxed">
                Building client-side AI developer tools at Lade Stack.
              </p>
            </div>
          </div>
        </aside>
      </div>
    </div>

    {/* Related Articles Strip */}
    {
      relatedPosts.length > 0 && (
        <section class="py-14 border-t border-border bg-surface-muted/20">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between mb-8">
              <h2 class="text-xl font-bold tracking-tight text-foreground">
                More in {post.category}
              </h2>
              <a href="/blog" class="text-xs font-semibold text-brand hover:underline inline-flex items-center gap-1">
                <span>View all articles</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5" />
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {relatedPosts.map((rp) => (
                <a
                  href={`/blog/${rp.slug}`}
                  class="group rounded-xl border border-border bg-surface p-5 hover:border-brand/40 hover:shadow-card transition-all duration-200 flex flex-col justify-between"
                >
                  <div>
                    <div class="flex items-center justify-between mb-3">
                      <span class="text-[11px] font-mono text-brand font-semibold uppercase">
                        {rp.category}
                      </span>
                      <span class="text-xs text-muted-foreground font-mono">{rp.readTime}</span>
                    </div>
                    <h3 class="text-sm font-semibold text-foreground line-clamp-2 mb-2 group-hover:text-brand transition-colors">
                      {rp.title}
                    </h3>
                    <p class="text-xs text-muted-foreground line-clamp-2 leading-relaxed">
                      {rp.excerpt}
                    </p>
                  </div>
                  <div class="mt-4 pt-3 border-t border-border/60 text-xs font-medium text-brand">
                    Read Post →
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </div>

  <script is:inline define:vars={{ fallback: FALLBACK_IMAGE }}>
    (function (fallback) {
      document.querySelectorAll('[data-copy-link]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var label = btn.querySelector('[data-copy-label]');
          var orig = label ? label.textContent : '';
          var done = function () {
            if (label) label.textContent = 'Copied to Clipboard!';
            setTimeout(function () {
              if (label) label.textContent = orig;
            }, 2000);
          };
          if (navigator.clipboard) {
            navigator.clipboard.writeText(window.location.href).then(done, done);
          } else {
            done();
          }
        });
      });

      document.querySelectorAll('img[data-cover-fallback]').forEach(function (img) {
        img.addEventListener('error', function () {
          if (img.src !== fallback) img.src = fallback;
        });
      });
    })(fallback);
  </script>
</BaseLayout>
