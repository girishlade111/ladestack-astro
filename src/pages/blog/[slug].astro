---
/**
 * /blog/[slug] — English Article Route
 * Sourced from Astro Content Collections ('blog')
 * Preserves legacy article fallback to guarantee zero 404 drops during Phase 3.
 */
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../components/blog/BlogPostLayout.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Badge from '../../components/ui/Badge.astro';
import { blogPosts, type BlogPost } from '../../data/blogPosts';
import { blogContent } from '../../data/blogContent';
import { renderArticle, extractHeadings } from '../../lib/markdown';
import type { BlogEntry } from '../../lib/blogUtils';

export async function getStaticPaths() {
  // 1. Fetch all published English markdown posts
  const allBlogEntries = await getCollection('blog', ({ data }) => !data.draft);
  const englishMarkdownPosts = allBlogEntries.filter((p) => p.data.locale === 'en');

  // Slugs covered by new Markdown system
  const markdownSlugs = new Set(englishMarkdownPosts.map((p) => p.data.slug));

  const paths = [];

  // Generate paths for Markdown posts
  for (const post of englishMarkdownPosts) {
    const allTranslations = allBlogEntries.filter(
      (entry) => entry.data.translationKey === post.data.translationKey
    );
    const relatedPosts = englishMarkdownPosts
      .filter((p) => p.id !== post.id && (p.data.category === post.data.category || p.data.relatedProduct === post.data.relatedProduct))
      .slice(0, 3);

    paths.push({
      params: { slug: post.data.slug },
      props: {
        type: 'markdown' as const,
        entry: post,
        allTranslations,
        relatedPosts,
        legacyPost: null,
      },
    });
  }

  // Generate fallback paths for legacy posts not yet rewritten in Markdown
  for (const legacy of blogPosts) {
    if (!markdownSlugs.has(legacy.slug)) {
      paths.push({
        params: { slug: legacy.slug },
        props: {
          type: 'legacy' as const,
          entry: null,
          allTranslations: [],
          relatedPosts: [],
          legacyPost: legacy,
        },
      });
    }
  }

  return paths;
}

interface Props {
  type: 'markdown' | 'legacy';
  entry: BlogEntry | null;
  allTranslations: BlogEntry[];
  relatedPosts: BlogEntry[];
  legacyPost: BlogPost | null;
}

const { type, entry, allTranslations, relatedPosts, legacyPost } = Astro.props;

let ContentComponent = null;
let headingsList = [];

if (type === 'markdown' && entry) {
  const rendered = await render(entry);
  ContentComponent = rendered.Content;
  headingsList = rendered.headings;
}

// Fallback legacy data if type === 'legacy'
const legacyRawContent = legacyPost ? blogContent[legacyPost.slug] ?? '' : '';
const legacyBodyHtml = legacyPost ? renderArticle(legacyRawContent) : '';
const legacyHeadings = legacyPost ? extractHeadings(legacyRawContent) : [];
const legacyCanonical = legacyPost ? `https://ladestack.in/blog/${legacyPost.slug}` : '';
---

{
  type === 'markdown' && entry && ContentComponent ? (
    <BlogPostLayout
      entry={entry}
      headings={headingsList}
      allTranslations={allTranslations}
      relatedPosts={relatedPosts}
    >
      <ContentComponent />
    </BlogPostLayout>
  ) : legacyPost ? (
    <BaseLayout
      title={`${legacyPost.title} | Lade Stack Blog`}
      description={legacyPost.excerpt}
      canonical={legacyCanonical}
      openGraph={{
        title: legacyPost.title,
        description: legacyPost.excerpt,
        url: legacyCanonical,
        type: 'article',
        image: `https://ladestack.in/blog-covers/${legacyPost.image}.svg`,
      }}
    >
      <div class="min-h-screen bg-background text-foreground py-12">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <nav class="flex items-center gap-1.5 text-xs text-muted-foreground mb-6" aria-label="Breadcrumb">
            <a href="/" class="hover:text-foreground transition-colors">Home</a>
            <span>/</span>
            <a href="/blog" class="hover:text-foreground transition-colors">Blog</a>
            <span>/</span>
            <span class="text-foreground font-medium">{legacyPost.category}</span>
          </nav>

          <div class="flex items-center gap-2 mb-4">
            <Badge variant="brand" size="sm">
              {legacyPost.category}
            </Badge>
            <span class="text-xs font-mono text-muted-foreground">
              {legacyPost.readTime}
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-4">
            {legacyPost.title}
          </h1>

          <p class="text-lg text-muted-foreground mb-8">
            {legacyPost.excerpt}
          </p>

          <article class="prose prose-invert prose-emerald max-w-none pt-8 border-t border-border" set:html={legacyBodyHtml} />
        </div>
      </div>
    </BaseLayout>
  ) : null
}
