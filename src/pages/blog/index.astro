---
/**
 * /blog — Engineering Blog Index
 * Redesigned with Obsidian & Precision Emerald tokens,
 * client-side instant category filtering & search over server-rendered articles.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Badge from '../../components/ui/Badge.astro';
import { blogPosts } from '../../data/blogPosts';
import { categories, FALLBACK_IMAGE } from '../../data/categories';

const POSTS_PER_PAGE = 6;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    description: 'AI development insights, tutorials, and engineering best practices.',
    name: 'Lade Stack Blog',
    publisher: { '@type': 'Organization', name: 'Lade Stack', url: 'https://ladestack.in' },
    url: 'https://ladestack.in/blog',
  },
];

function fmtDate(d: string, opts: Intl.DateTimeFormatOptions) {
  return new Date(d + 'T00:00:00').toLocaleDateString('en-US', opts);
}
---

<BaseLayout
  title="Blog – AI Development Insights & Tutorials | Lade Stack"
  description="Explore the latest insights, tutorials, and trends in AI software development, API testing, and developer productivity from the Lade Stack team."
  canonical="https://ladestack.in/blog"
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: 'Lade Stack Blog - AI Development Insights',
    description: 'Expert tutorials, guides, and insights on AI-powered development, API testing, and modern software engineering.',
    url: 'https://ladestack.in/blog',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Lade Stack Blog - AI Development Insights',
    description: 'Expert tutorials, guides, and insights on AI-powered development, API testing, and modern software engineering.',
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background">
    {/* Hero */}
    <section class="relative pt-20 pb-14 border-b border-border bg-surface-muted/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Badge variant="brand" size="md" dot={true} class="mb-4">
          {blogPosts.length} Engineering Articles
        </Badge>
        <h1 class="text-3xl sm:text-5xl font-bold text-foreground tracking-tight leading-tight">
          Engineering Insights & Guides
        </h1>
        <p class="mt-4 text-base sm:text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed">
          Deep-dives into AI engineering, WebAssembly optimizations, client-side security, and developer productivity.
        </p>

        <div class="mt-8 max-w-md mx-auto relative">
          <Icon name="search" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground pointer-events-none" />
          <input
            type="text"
            data-blog-search
            placeholder="Search articles, tutorials, architectures…"
            class="w-full h-10 pl-10 pr-9 rounded-lg border border-border bg-surface text-xs sm:text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-brand transition"
          />
          <button
            type="button"
            data-blog-clear-search
            class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground"
            aria-label="Clear search"
          >
            <Icon name="x" class="w-3.5 h-3.5" />
          </button>
        </div>
      </div>
    </section>

    {/* Sticky category bar */}
    <section class="sticky top-16 z-30 border-b border-border bg-background/90 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-1.5 py-3 overflow-x-auto" data-blog-cats>
          {
            categories.map((cat) => (
              <button
                type="button"
                data-blog-cat={cat}
                class={`flex-shrink-0 rounded-lg px-3 py-1.5 text-xs font-medium border transition-colors ${
                  cat === 'All'
                    ? 'bg-brand border-brand text-brand-foreground shadow-soft'
                    : 'bg-surface border-border text-muted-foreground hover:text-foreground hover:bg-surface-muted'
                }`}
              >
                {cat === 'All' ? 'All Posts' : cat}
              </button>
            ))
          }
        </div>
      </div>
    </section>

    {/* Articles Grid */}
    <section class="py-12 sm:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-8">
          <p class="text-xs font-mono text-muted-foreground" data-blog-count></p>
          <button
            type="button"
            data-blog-clear-filters
            class="hidden items-center gap-1.5 text-xs font-medium text-brand hover:underline"
          >
            <Icon name="x" class="w-3 h-3" /> Reset filters
          </button>
        </div>

        <div data-blog-featured class="mb-8"></div>
        <div data-blog-grid class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12"></div>
        <div data-blog-pagination class="flex items-center justify-center gap-1.5"></div>

        {/* Empty state */}
        <div data-blog-empty class="hidden text-center py-20">
          <div class="w-12 h-12 rounded-xl bg-surface-muted border border-border flex items-center justify-center mx-auto mb-3 text-muted-foreground">
            <Icon name="search" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-semibold text-foreground mb-1">No articles found</h3>
          <p class="text-xs text-muted-foreground">Try adjusting your search terms or category selection.</p>
        </div>

        {/* Raw post data for client filter script (rendered server-side for SEO) */}
        <div class="hidden" data-blog-data>
          {
            blogPosts.map((post) => (
              <article
                data-slug={post.slug}
                data-category={post.category}
                data-title={post.title.toLowerCase()}
                data-excerpt={post.excerpt.toLowerCase()}
              >
                <a href={`/blog/${post.slug}`} data-card-link>
                  <span data-card-category>{post.category}</span>
                  <img src={`/blog-covers/${post.image}.svg`} alt={post.title} loading="lazy" data-card-img />
                  <h2 data-card-title>{post.title}</h2>
                  <p data-card-excerpt>{post.excerpt}</p>
                  <span data-card-date>{fmtDate(post.date, { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                  <span data-card-readtime>{post.readTime}</span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ perPage: POSTS_PER_PAGE, fallback: FALLBACK_IMAGE }}>
    (function (perPage, fallback) {
      var dataHost = document.querySelector('[data-blog-data]');
      var posts = [];
      if (dataHost) {
        dataHost.querySelectorAll('article').forEach(function (el) {
          posts.push({
            slug: el.getAttribute('data-slug'),
            category: el.getAttribute('data-category'),
            title: el.getAttribute('data-title'),
            excerpt: el.getAttribute('data-excerpt'),
            displayTitle: el.querySelector('[data-card-title]').textContent,
            displayExcerpt: el.querySelector('[data-card-excerpt]').textContent,
            date: el.querySelector('[data-card-date]').textContent,
            readTime: el.querySelector('[data-card-readtime]').textContent,
            img: el.querySelector('[data-card-img]').getAttribute('src'),
            alt: el.querySelector('[data-card-img]').getAttribute('alt'),
          });
        });
        dataHost.remove();
      }

      var category = 'All';
      var query = '';
      var page = 1;
      var searchInput = document.querySelector('[data-blog-search]');
      var clearSearch = document.querySelector('[data-blog-clear-search]');
      var countEl = document.querySelector('[data-blog-count]');
      var clearFilters = document.querySelector('[data-blog-clear-filters]');
      var featuredHost = document.querySelector('[data-blog-featured]');
      var grid = document.querySelector('[data-blog-grid]');
      var pager = document.querySelector('[data-blog-pagination]');
      var empty = document.querySelector('[data-blog-empty]');

      function filtered() {
        return posts.filter(function (p) {
          var okCat = category === 'All' || p.category === category;
          var okQ = !query || p.title.indexOf(query) !== -1 || p.excerpt.indexOf(query) !== -1;
          return okCat && okQ;
        });
      }

      function esc(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      function featuredCard(p) {
        return (
          '<div class="group rounded-xl overflow-hidden border border-border bg-surface hover:border-brand/40 transition-all duration-200 shadow-soft">' +
          '<div class="grid md:grid-cols-2 min-h-[320px]">' +
          '<div class="relative overflow-hidden bg-surface-muted min-h-[200px] md:min-h-0 border-b md:border-b-0 md:border-r border-border">' +
          '<img src="' + p.img + '" alt="' + esc(p.alt) + '" loading="lazy" onerror="this.src=\'' + fallback + '\'" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"/>' +
          '</div>' +
          '<div class="flex flex-col justify-center p-6 sm:p-8">' +
          '<div class="mb-3"><span class="text-xs font-mono font-semibold text-brand uppercase tracking-wider">' + esc(p.category) + '</span></div>' +
          '<h2 class="text-xl sm:text-2xl font-bold text-foreground mb-3 leading-snug group-hover:text-brand transition-colors">' + esc(p.displayTitle) + '</h2>' +
          '<p class="text-sm text-muted-foreground leading-relaxed mb-6 line-clamp-3">' + esc(p.displayExcerpt) + '</p>' +
          '<div class="flex items-center justify-between text-xs text-muted-foreground pt-4 border-t border-border">' +
          '<span>' + esc(p.date) + ' · ' + esc(p.readTime) + '</span>' +
          '<a href="/blog/' + p.slug + '" class="font-semibold text-brand hover:underline inline-flex items-center gap-1">Read Post →</a>' +
          '</div>' +
          '</div></div></div>'
        );
      }

      function gridCard(p) {
        return (
          '<div class="group flex flex-col rounded-xl overflow-hidden border border-border bg-surface hover:border-brand/40 transition-all duration-200 shadow-soft hover:-translate-y-0.5">' +
          '<div class="relative overflow-hidden bg-surface-muted aspect-[16/9] border-b border-border">' +
          '<img src="' + p.img + '" alt="' + esc(p.alt) + '" loading="lazy" onerror="this.src=\'' + fallback + '\'" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"/>' +
          '</div>' +
          '<div class="flex flex-col flex-1 p-5 sm:p-6">' +
          '<div class="mb-2"><span class="text-[11px] font-mono text-brand font-semibold uppercase tracking-wider">' + esc(p.category) + '</span></div>' +
          '<h3 class="text-base font-semibold text-foreground mb-2 line-clamp-2 leading-snug group-hover:text-brand transition-colors">' + esc(p.displayTitle) + '</h3>' +
          '<p class="text-xs text-muted-foreground leading-relaxed line-clamp-2 flex-1 mb-4">' + esc(p.displayExcerpt) + '</p>' +
          '<div class="pt-3 border-t border-border flex items-center justify-between text-xs text-muted-foreground">' +
          '<span>' + esc(p.date) + '</span>' +
          '<a href="/blog/' + p.slug + '" class="font-semibold text-brand hover:underline">Read →</a>' +
          '</div>' +
          '</div></div>'
        );
      }

      function render() {
        var list = filtered();
        var totalPages = Math.max(1, Math.ceil(list.length / perPage));
        if (page > totalPages) page = totalPages;
        var start = (page - 1) * perPage;
        var visible = list.slice(start, start + perPage);
        var defaultView = category === 'All' && !query && page === 1;
        var featured = defaultView ? visible[0] : null;
        var rest = defaultView ? visible.slice(1) : visible;

        featuredHost.innerHTML = featured ? featuredCard(featured) : '';
        grid.innerHTML = rest.map(gridCard).join('');
        empty.classList.toggle('hidden', list.length > 0);

        countEl.textContent =
          list.length === posts.length
            ? 'Showing all ' + posts.length + ' articles'
            : list.length + ' article' + (list.length !== 1 ? 's' : '') + ' found';

        var showClear = !!(query || category !== 'All');
        clearFilters.classList.toggle('hidden', !showClear);
        clearFilters.classList.toggle('inline-flex', showClear);

        pager.innerHTML = '';
        if (totalPages > 1) {
          for (var i = 1; i <= totalPages; i++) {
            (function (n) {
              var b = document.createElement('button');
              b.type = 'button';
              b.textContent = String(n);
              b.className =
                'w-8 h-8 flex items-center justify-center rounded-lg text-xs font-medium border transition-colors ' +
                (n === page
                  ? 'bg-brand text-brand-foreground border-brand'
                  : 'bg-surface border-border text-muted-foreground hover:text-foreground hover:bg-surface-muted');
              b.addEventListener('click', function () {
                page = n;
                window.scrollTo({ top: 0, behavior: 'smooth' });
                render();
              });
              pager.appendChild(b);
            })(i);
          }
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', function () {
          query = searchInput.value.trim().toLowerCase();
          page = 1;
          var has = !!searchInput.value;
          clearSearch.classList.toggle('hidden', !has);
          clearSearch.classList.toggle('inline-flex', has);
          render();
        });
        clearSearch.addEventListener('click', function () {
          searchInput.value = '';
          query = '';
          page = 1;
          clearSearch.classList.add('hidden');
          clearSearch.classList.remove('inline-flex');
          render();
        });
      }

      document.querySelectorAll('[data-blog-cat]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          category = btn.getAttribute('data-blog-cat');
          page = 1;
          document.querySelectorAll('[data-blog-cat]').forEach(function (b) {
            var on = b === btn;
            b.className =
              'flex-shrink-0 rounded-lg px-3 py-1.5 text-xs font-medium border transition-colors ' +
              (on
                ? 'bg-brand border-brand text-brand-foreground shadow-soft'
                : 'bg-surface border-border text-muted-foreground hover:text-foreground hover:bg-surface-muted');
          });
          render();
        });
      });

      if (clearFilters) {
        clearFilters.addEventListener('click', function () {
          category = 'All';
          query = '';
          page = 1;
          if (searchInput) searchInput.value = '';
          document.querySelectorAll('[data-blog-cat]').forEach(function (b) {
            var on = b.getAttribute('data-blog-cat') === 'All';
            b.className =
              'flex-shrink-0 rounded-lg px-3 py-1.5 text-xs font-medium border transition-colors ' +
              (on
                ? 'bg-brand border-brand text-brand-foreground shadow-soft'
                : 'bg-surface border-border text-muted-foreground hover:text-foreground hover:bg-surface-muted');
          });
          render();
        });
      }

      render();
    })(perPage, fallback);
  </script>
</BaseLayout>
