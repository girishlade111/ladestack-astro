---
/**
 * /blog — full port of src/pages/Blog.tsx.
 * Same hero, search, category pills, featured card, grid, pagination,
 * newsletter. Filtering/search/pagination run client-side over the
 * server-rendered post set (6 per page, like the source).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { blogPosts } from '../../data/blogPosts';
import { categories, categoryColors, FALLBACK_IMAGE } from '../../data/categories';

const POSTS_PER_PAGE = 6;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    description: 'AI development insights, tutorials, and engineering best practices.',
    name: 'Lade Stack Blog',
    publisher: { '@type': 'Organization', name: 'Lade Stack', url: 'https://ladestack.in' },
    url: 'https://ladestack.in/blog',
  },
];

function fmtDate(d: string, opts: Intl.DateTimeFormatOptions) {
  return new Date(d + 'T00:00:00').toLocaleDateString('en-US', opts);
}
---

<BaseLayout
  title="Blog – AI Development Insights & Tutorials | Lade Stack"
  description="Explore the latest insights, tutorials, and trends in AI software development, API testing, and developer productivity from the Lade Stack team."
  canonical="https://ladestack.in/blog"
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: 'Lade Stack Blog - AI Development Insights',
    description: 'Expert tutorials, guides, and insights on AI-powered development, API testing, and modern software engineering.',
    url: 'https://ladestack.in/blog',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Lade Stack Blog - AI Development Insights',
    description: 'Expert tutorials, guides, and insights on AI-powered development, API testing, and modern software engineering.',
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background">
    <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10" aria-hidden="true">
      <div class="absolute top-0 left-[15%] w-[600px] h-[500px] bg-[radial-gradient(ellipse_at_center,rgba(110,143,106,0.08),transparent_65%)]"></div>
      <div class="absolute top-[40%] right-[5%] w-[400px] h-[400px] bg-[radial-gradient(ellipse_at_center,rgba(99,102,241,0.06),transparent_60%)]"></div>
      <div class="absolute bottom-0 left-0 w-[500px] h-[300px] bg-[radial-gradient(ellipse_at_center,rgba(110,143,106,0.05),transparent_55%)]"></div>
    </div>

    <div class="pt-16">
      {/* Hero */}
      <section class="relative py-20 lg:py-28 border-b border-border overflow-hidden">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-3xl mx-auto text-center">
            <div class="inline-flex items-center gap-2 rounded-full border border-[#6E8F6A]/30 bg-[#6E8F6A]/10 text-[#6E8F6A] text-xs font-semibold px-4 py-1.5 mb-6">
              <Icon name="rss" class="w-3.5 h-3.5" />
              {blogPosts.length} Articles & Counting
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-foreground mb-5 leading-tight tracking-tight">
              Insights for the{' '}
              <span class="relative inline-block">
                <span class="relative z-10 text-[#6E8F6A]">Modern Developer</span>
                <svg class="absolute -bottom-1.5 left-0 w-full" height="6" viewBox="0 0 200 6" fill="none" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 5 Q50 1 100 4 Q150 7 200 3" stroke="#6E8F6A" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.6"></path>
                </svg>
              </span>
            </h1>
            <p class="text-lg text-muted-foreground max-w-2xl mx-auto mb-10">
              Discover the latest trends, tutorials, and best practices in AI-powered software development.
            </p>
            <div class="relative max-w-lg mx-auto">
              <Icon name="search" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground pointer-events-none" />
              <input
                type="text"
                data-blog-search
                placeholder="Search articles, topics, technologies…"
                class="w-full h-12 pl-11 pr-10 rounded-2xl border border-border bg-card/80 backdrop-blur-sm text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-[#6E8F6A]/40 focus:border-[#6E8F6A]/60 transition"
              />
              <button
                type="button"
                data-blog-clear-search
                class="hidden absolute right-3 top-1/2 -translate-y-1/2 w-6 h-6 items-center justify-center rounded-full bg-muted hover:bg-muted/80 transition"
                aria-label="Clear search"
              >
                <Icon name="x" class="w-3.5 h-3.5 text-muted-foreground" />
              </button>
            </div>
            <div class="flex items-center justify-center gap-6 mt-8 text-xs text-muted-foreground">
              <span class="flex items-center gap-1.5"><Icon name="book-open" class="w-3.5 h-3.5 text-[#6E8F6A]" />{blogPosts.length} Articles</span>
              <span class="flex items-center gap-1.5"><Icon name="tag" class="w-3.5 h-3.5 text-[#6E8F6A]" />{categories.length - 1} Categories</span>
              <span class="flex items-center gap-1.5"><Icon name="trending-up" class="w-3.5 h-3.5 text-[#6E8F6A]" />Weekly Updates</span>
            </div>
          </div>
        </div>
      </section>

      {/* Category pills */}
      <section class="sticky top-16 z-30 border-b border-border bg-background/90 backdrop-blur-md">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center gap-2 py-3 overflow-x-auto" data-blog-cats>
            {
              categories.map((cat) => (
                <button
                  type="button"
                  data-blog-cat={cat}
                  class={`flex-shrink-0 rounded-full px-3.5 py-1.5 text-xs font-medium border transition-all duration-200 ${cat === 'All' ? 'bg-[#6E8F6A]/15 text-[#6E8F6A] border-[#6E8F6A]/30' : 'border-transparent text-muted-foreground hover:text-foreground hover:bg-muted'}`}
                >
                  {cat === 'All' ? 'All Posts' : cat}
                </button>
              ))
            }
          </div>
        </div>
      </section>

      {/* Articles */}
      <section class="py-14 sm:py-20">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-6xl mx-auto">
            <div class="flex items-center justify-between mb-8">
              <p class="text-sm text-muted-foreground" data-blog-count></p>
              <button
                type="button"
                data-blog-clear-filters
                class="hidden items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground border border-border rounded-full px-3 py-1 transition hover:bg-muted"
              >
                <Icon name="x" class="w-3 h-3" /> Clear filters
              </button>
            </div>

            <div data-blog-featured class="mb-10"></div>
            <div data-blog-grid class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-14"></div>
            <div data-blog-pagination class="flex items-center justify-center gap-2"></div>

            <div data-blog-empty class="hidden text-center py-24">
              <div class="w-16 h-16 rounded-2xl bg-muted flex items-center justify-center mx-auto mb-4">
                <Icon name="search" class="w-7 h-7 text-muted-foreground" />
              </div>
              <h3 class="text-lg font-semibold text-foreground mb-2">No articles found</h3>
              <p class="text-muted-foreground mb-6">Try adjusting your search or filter criteria.</p>
            </div>

            {/* Server-rendered post data for the client filter (SEO: all posts in initial HTML) */}
            <div class="hidden" data-blog-data>
              {
                blogPosts.map((post) => {
                  const cc = categoryColors(post.category);
                  return (
                    <article
                      data-slug={post.slug}
                      data-category={post.category}
                      data-title={post.title.toLowerCase()}
                      data-excerpt={post.excerpt.toLowerCase()}
                    >
                      <a href={`/blog/${post.slug}`} data-card-link>
                        <span data-card-category class={`${cc.bg} ${cc.text} ${cc.border}`}>{post.category}</span>
                        <img src={`/blog-covers/${post.image}.svg`} alt={post.title} loading="lazy" data-card-img />
                        <span data-card-dot class={cc.dot}></span>
                        <h2 data-card-title>{post.title}</h2>
                        <p data-card-excerpt>{post.excerpt}</p>
                        <span data-card-date>{fmtDate(post.date, { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                        <span data-card-readtime>{post.readTime}</span>
                      </a>
                    </article>
                  );
                })
              }
            </div>
          </div>
        </div>
      </section>

      {/* Newsletter */}
      <section class="py-16 sm:py-20 border-t border-border">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="relative max-w-3xl mx-auto rounded-3xl overflow-hidden border border-[#6E8F6A]/20 bg-gradient-to-br from-[#6E8F6A]/8 via-background to-violet-500/5 p-10 lg:p-14 text-center">
            <div class="absolute top-0 right-0 w-64 h-64 bg-[radial-gradient(ellipse_at_top_right,rgba(110,143,106,0.15),transparent_65%)] pointer-events-none"></div>
            <div class="absolute bottom-0 left-0 w-48 h-48 bg-[radial-gradient(ellipse_at_bottom_left,rgba(99,102,241,0.1),transparent_60%)] pointer-events-none"></div>
            <div class="relative z-10">
              <div class="inline-flex items-center gap-2 rounded-full border border-[#6E8F6A]/30 bg-[#6E8F6A]/10 text-[#6E8F6A] text-xs font-semibold px-4 py-1.5 mb-5">
                <Icon name="rss" class="w-3.5 h-3.5" /> Newsletter
              </div>
              <h2 class="text-3xl sm:text-4xl font-bold text-foreground mb-3 leading-tight">Subscribe to Our Newsletter</h2>
              <p class="text-muted-foreground max-w-xl mx-auto mb-8">
                Get the latest articles, tutorials, and updates delivered straight to your inbox. No spam, ever.
              </p>
              <form data-blog-newsletter class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
                <input
                  type="email"
                  required
                  placeholder="Enter your email"
                  aria-label="Email address"
                  class="flex-1 h-11 px-4 rounded-xl border border-border bg-background/80 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-[#6E8F6A]/40 focus:border-[#6E8F6A]/60 transition"
                />
                <button class="h-11 px-6 rounded-xl bg-[#6E8F6A] hover:bg-[#5a7856] text-white text-sm font-semibold transition-colors whitespace-nowrap">
                  Subscribe
                </button>
              </form>
              <p class="mt-4 text-xs text-muted-foreground/70">
                Join {blogPosts.length}+ subscribers · Unsubscribe at any time
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <script is:inline define:vars={{ perPage: POSTS_PER_PAGE, fallback: FALLBACK_IMAGE }}>
    (function (perPage, fallback) {
      var dataHost = document.querySelector('[data-blog-data]');
      var posts = [];
      if (dataHost) {
        dataHost.querySelectorAll('article').forEach(function (el) {
          var link = el.querySelector('[data-card-link]');
          posts.push({
            slug: el.getAttribute('data-slug'),
            category: el.getAttribute('data-category'),
            title: el.getAttribute('data-title'),
            excerpt: el.getAttribute('data-excerpt'),
            displayTitle: el.querySelector('[data-card-title]').textContent,
            displayExcerpt: el.querySelector('[data-card-excerpt]').textContent,
            date: el.querySelector('[data-card-date]').textContent,
            readTime: el.querySelector('[data-card-readtime]').textContent,
            img: el.querySelector('[data-card-img]').getAttribute('src'),
            alt: el.querySelector('[data-card-img]').getAttribute('alt'),
            catCls: el.querySelector('[data-card-category]').className,
            dotCls: el.querySelector('[data-card-dot]').className,
          });
        });
        dataHost.remove();
      }
      var category = 'All';
      var query = '';
      var page = 1;
      var searchInput = document.querySelector('[data-blog-search]');
      var clearSearch = document.querySelector('[data-blog-clear-search]');
      var countEl = document.querySelector('[data-blog-count]');
      var clearFilters = document.querySelector('[data-blog-clear-filters]');
      var featuredHost = document.querySelector('[data-blog-featured]');
      var grid = document.querySelector('[data-blog-grid]');
      var pager = document.querySelector('[data-blog-pagination]');
      var empty = document.querySelector('[data-blog-empty]');

      function filtered() {
        return posts.filter(function (p) {
          var okCat = category === 'All' || p.category === category;
          var okQ = !query || p.title.indexOf(query) !== -1 || p.excerpt.indexOf(query) !== -1;
          return okCat && okQ;
        });
      }
      function esc(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }
      function featuredCard(p) {
        return (
          '<div class="group relative rounded-3xl overflow-hidden border border-border bg-card hover:border-primary/40 transition-colors duration-300 shadow-sm hover:shadow-xl">' +
          '<div class="grid md:grid-cols-2 min-h-[380px]">' +
          '<div class="relative overflow-hidden bg-muted min-h-[220px] md:min-h-0">' +
          '<div class="absolute inset-0 bg-gradient-to-r from-transparent to-card/40 z-10 hidden md:block"></div>' +
          '<img src="' + p.img + '" alt="' + esc(p.alt) + '" loading="lazy" onerror="this.src=\'' + fallback + '\'" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"/>' +
          '<div class="absolute top-4 left-4 z-20"><span class="inline-flex items-center gap-1.5 rounded-full bg-[#6E8F6A] text-white text-xs font-semibold px-3 py-1 shadow-lg">Featured</span></div>' +
          '</div>' +
          '<div class="flex flex-col justify-center p-8 lg:p-10">' +
          '<div class="mb-4"><span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-medium ' + p.catCls + '"><span class="w-1.5 h-1.5 rounded-full flex-shrink-0 ' + p.dotCls + '"></span>' + esc(p.category) + '</span></div>' +
          '<h2 class="text-2xl lg:text-3xl font-bold text-foreground mb-4 leading-tight">' + esc(p.displayTitle) + '</h2>' +
          '<p class="text-muted-foreground leading-relaxed mb-6 line-clamp-3">' + esc(p.displayExcerpt) + '</p>' +
          '<div class="flex items-center gap-4 text-xs text-muted-foreground mb-6"><span>' + esc(p.date) + '</span><span>' + esc(p.readTime) + '</span></div>' +
          '<div><a href="/blog/' + p.slug + '" class="inline-flex items-center gap-2 rounded-xl bg-[#6E8F6A] hover:bg-[#5a7856] text-white font-semibold text-sm px-5 py-2.5 transition-colors duration-200">Read Article →</a></div>' +
          '</div></div></div>'
        );
      }
      function gridCard(p) {
        return (
          '<div class="group flex flex-col rounded-2xl overflow-hidden border border-border bg-card hover:border-primary/30 hover:shadow-lg transition-all duration-300">' +
          '<div class="h-1 w-full ' + p.dotCls + '"></div>' +
          '<div class="relative overflow-hidden bg-muted aspect-[16/9]">' +
          '<div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent z-10"></div>' +
          '<img src="' + p.img + '" alt="' + esc(p.alt) + '" loading="lazy" onerror="this.src=\'' + fallback + '\'" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-600"/>' +
          '<div class="absolute bottom-3 left-3 z-20"><span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[10px] font-medium ' + p.catCls + '"><span class="w-1.5 h-1.5 rounded-full flex-shrink-0 ' + p.dotCls + '"></span>' + esc(p.category) + '</span></div>' +
          '</div>' +
          '<div class="flex flex-col flex-1 p-5">' +
          '<div class="flex items-center gap-3 text-[11px] text-muted-foreground mb-3"><span>' + esc(p.date) + '</span><span class="w-1 h-1 rounded-full bg-muted-foreground/40"></span><span>' + esc(p.readTime) + '</span></div>' +
          '<h3 class="text-base font-bold text-foreground mb-2 line-clamp-2 leading-snug">' + esc(p.displayTitle) + '</h3>' +
          '<p class="text-sm text-muted-foreground leading-relaxed line-clamp-3 flex-1 mb-4">' + esc(p.displayExcerpt) + '</p>' +
          '<a href="/blog/' + p.slug + '" class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#6E8F6A] hover:text-[#5a7856] transition-colors">Read Article →</a>' +
          '</div></div>'
        );
      }
      function render() {
        var list = filtered();
        var totalPages = Math.max(1, Math.ceil(list.length / perPage));
        if (page > totalPages) page = totalPages;
        var start = (page - 1) * perPage;
        var visible = list.slice(start, start + perPage);
        var defaultView = category === 'All' && !query && page === 1;
        var featured = defaultView ? visible[0] : null;
        var rest = defaultView ? visible.slice(1) : visible;
        featuredHost.innerHTML = featured ? featuredCard(featured) : '';
        grid.innerHTML = rest.map(gridCard).join('');
        empty.classList.toggle('hidden', list.length > 0);
        countEl.textContent =
          list.length === posts.length
            ? 'Showing all ' + posts.length + ' articles'
            : list.length + ' article' + (list.length !== 1 ? 's' : '') + ' found';
        var showClear = !!(query || category !== 'All');
        clearFilters.classList.toggle('hidden', !showClear);
        clearFilters.classList.toggle('inline-flex', showClear);
        pager.innerHTML = '';
        if (totalPages > 1) {
          for (var i = 1; i <= totalPages; i++) {
            (function (n) {
              var b = document.createElement('button');
              b.type = 'button';
              b.textContent = String(n);
              b.className =
                'w-9 h-9 flex items-center justify-center rounded-xl text-sm font-medium border transition ' +
                (n === page
                  ? 'bg-[#6E8F6A] text-white border-[#6E8F6A]'
                  : 'border-border text-muted-foreground hover:text-foreground hover:bg-muted');
              b.addEventListener('click', function () {
                page = n;
                window.scrollTo({ top: 0, behavior: 'smooth' });
                render();
              });
              pager.appendChild(b);
            })(i);
          }
        }
      }
      if (searchInput) {
        searchInput.addEventListener('input', function () {
          query = searchInput.value.trim().toLowerCase();
          page = 1;
          var has = !!searchInput.value;
          clearSearch.classList.toggle('hidden', !has);
          clearSearch.classList.toggle('inline-flex', has);
          render();
        });
        clearSearch.addEventListener('click', function () {
          searchInput.value = '';
          query = '';
          page = 1;
          clearSearch.classList.add('hidden');
          clearSearch.classList.remove('inline-flex');
          render();
        });
      }
      document.querySelectorAll('[data-blog-cat]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          category = btn.getAttribute('data-blog-cat');
          page = 1;
          document.querySelectorAll('[data-blog-cat]').forEach(function (b) {
            var on = b === btn;
            b.className =
              'flex-shrink-0 rounded-full px-3.5 py-1.5 text-xs font-medium border transition-all duration-200 ' +
              (on
                ? 'bg-[#6E8F6A]/15 text-[#6E8F6A] border-[#6E8F6A]/30'
                : 'border-transparent text-muted-foreground hover:text-foreground hover:bg-muted');
          });
          render();
        });
      });
      if (clearFilters) {
        clearFilters.addEventListener('click', function () {
          category = 'All';
          query = '';
          page = 1;
          if (searchInput) searchInput.value = '';
          document.querySelectorAll('[data-blog-cat]').forEach(function (b) {
            var on = b.getAttribute('data-blog-cat') === 'All';
            b.className =
              'flex-shrink-0 rounded-full px-3.5 py-1.5 text-xs font-medium border transition-all duration-200 ' +
              (on
                ? 'bg-[#6E8F6A]/15 text-[#6E8F6A] border-[#6E8F6A]/30'
                : 'border-transparent text-muted-foreground hover:text-foreground hover:bg-muted');
          });
          render();
        });
      }
      var nl = document.querySelector('[data-blog-newsletter]');
      if (nl) {
        nl.addEventListener('submit', function (e) {
          e.preventDefault();
          var btn = nl.querySelector('button');
          if (btn) {
            btn.textContent = "You're subscribed!";
            btn.disabled = true;
          }
          nl.reset();
        });
      }
      render();
    })(perPage, fallback);
  </script>
</BaseLayout>
