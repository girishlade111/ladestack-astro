---
/**
 * /terms — Terms of Service
 * Styled with Obsidian & Precision Emerald design tokens.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/ui/Badge.astro';
---

<BaseLayout
  title="Terms of Service - Lade Stack"
  description="Read our Terms of Service to understand the rules and regulations for using Lade Stack's services."
  canonical="https://ladestack.in/terms"
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: 'Terms of Service - Lade Stack',
    description: "Read our Terms of Service to understand the rules and regulations for using Lade Stack's services.",
    url: 'https://ladestack.in/terms',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Terms of Service - Lade Stack',
    description: "Read our Terms of Service to understand the rules and regulations for using Lade Stack's services.",
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={[]}
>
  <div class="min-h-screen bg-background text-foreground">
    {/* Header */}
    <section class="pt-20 pb-12 border-b border-border bg-surface-muted/20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Badge variant="brand" size="md" dot={true} class="mb-4">
          Legal Agreement
        </Badge>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-foreground">
          Terms of Service
        </h1>
        <p class="mt-3 text-xs font-mono text-muted-foreground">
          Last Updated: June 15, 2024 · Effective Immediately
        </p>
      </div>
    </section>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="space-y-8 text-sm sm:text-base leading-relaxed text-muted-foreground max-w-[72ch] mx-auto">
        <div class="rounded-xl border border-border bg-surface p-6 sm:p-8 space-y-4">
          <h2 class="text-lg font-bold text-foreground">1. Agreement to Terms</h2>
          <p>
            By accessing or using the Lade Stack platform ([ladestack.in](https://ladestack.in)), including all associated subdomains and in-browser utilities, you agree to be bound by these Terms of Service. If you disagree with any part of these terms, you may not access our services.
          </p>
        </div>

        <div class="rounded-xl border border-border bg-surface p-6 sm:p-8 space-y-4">
          <h2 class="text-lg font-bold text-foreground">2. Permitted Use & Commercial Rights</h2>
          <p>
            You are granted a worldwide, royalty-free, non-exclusive license to use Lade Stack tools for personal, academic, open-source, and commercial deliverables. Any code compiled or files generated by our tools belong 100% to you.
          </p>
        </div>

        <div class="rounded-xl border border-border bg-surface p-6 sm:p-8 space-y-4">
          <h2 class="text-lg font-bold text-foreground">3. Disclaimers & Limitation of Liability</h2>
          <p>
            Lade Stack provides all tools on an &quot;AS IS&quot; and &quot;AS AVAILABLE&quot; basis without warranties of any kind. While our tools undergo extensive testing, we do not warrant that execution will be uninterrupted or error-free.
          </p>
        </div>

        <div class="rounded-xl border border-border bg-surface p-6 sm:p-8 space-y-4">
          <h2 class="text-lg font-bold text-foreground">4. Changes to Terms</h2>
          <p>
            We reserve the right to modify these terms at any time. When modifications are made, the &quot;Last Updated&quot; timestamp at the top of this document will be updated.
          </p>
          <p class="pt-2 text-xs font-mono text-muted-foreground">
            Questions? Contact <a href="mailto:admin@ladestack.in" class="text-brand underline">admin@ladestack.in</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
