---
/**
 * /contact — Contact & Support Page
 * Redesigned with Obsidian & Precision Emerald tokens,
 * accessible form fields, direct contact channels, and FAQ.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Accordion from '../components/ui/Accordion.astro';
import AccordionItem from '../components/ui/AccordionItem.astro';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    description: 'Get in touch with Lade Stack for AI development support, technical assistance, and enterprise solutions.',
    mainEntity: {
      '@type': 'Organization',
      address: { '@type': 'PostalAddress', addressCountry: 'IN', addressLocality: 'Mumbai', addressRegion: 'Maharashtra' },
      contactPoint: { '@type': 'ContactPoint', availableLanguage: 'English', contactType: 'customer support', email: 'admin@ladestack.in' },
      name: 'Lade Stack',
    },
    name: 'Contact Lade Stack',
    url: 'https://ladestack.in/contact',
  },
];

const contactCards = [
  { icon: 'mail', label: 'Direct Email', title: 'admin@ladestack.in', sub: 'Responses within 24 hours', href: 'mailto:admin@ladestack.in' },
  { icon: 'message-square', label: 'Developer Support', title: 'Technical Help', sub: 'Architecture & bug reports', href: 'mailto:admin@ladestack.in' },
  { icon: 'map-pin', label: 'Headquarters', title: 'Mumbai, India', sub: 'Global remote operations', href: null },
  { icon: 'clock', label: 'Availability', title: '24 / 7 Monitoring', sub: 'Evergreen uptime SLA', href: null },
];

const socials = [
  { icon: 'github', label: 'GitHub', href: 'https://github.com/girishlade111' },
  { icon: 'linkedin', label: 'LinkedIn', href: 'https://www.linkedin.com/in/girish-lade-075bba201/' },
  { icon: 'instagram', label: 'Instagram', href: 'https://www.instagram.com/girish_lade_/' },
];

const faqs = [
  { q: 'How quickly can I expect a response?', a: 'We typically respond within a few hours. For complex architectural or bug reports, response times may take up to 24 hours.' },
  { q: 'Can I report a bug or request a feature?', a: 'Yes! Please email admin@ladestack.in or open an issue on our GitHub repository at github.com/girishlade111.' },
  { q: 'Do you offer custom integrations for teams?', a: 'Yes. If your engineering team needs self-hosted versions of our client-side tools or specialized workflows, reach out directly.' },
  { q: 'Is Lade Stack available globally without restrictions?', a: 'Yes, our platform is 100% cloud-accessible globally with no regional geo-blocking.' },
];
---

<BaseLayout
  title="Contact Lade Stack – Get in Touch for AI Development Support"
  description="Contact Lade Stack for AI development support, technical assistance, and enterprise solutions. We operate 24/7 and respond within hours. Based in Mumbai, India."
  canonical="https://ladestack.in/contact"
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: 'Contact Lade Stack – AI Development Support',
    description: 'Get in touch with Lade Stack for AI development support, technical assistance, and enterprise solutions.',
    url: 'https://ladestack.in/contact',
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Contact Lade Stack – AI Development Support',
    description: 'Get in touch for AI development support and technical assistance. 24/7 availability.',
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background">
    {/* Hero */}
    <section class="relative pt-20 pb-14 border-b border-border bg-surface-muted/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Badge variant="brand" size="md" dot={true} class="mb-4">
          Support & Inquiries
        </Badge>
        <h1 class="text-3xl sm:text-5xl font-bold text-foreground tracking-tight leading-tight">
          Get in Touch
        </h1>
        <p class="mt-4 text-base sm:text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed">
          Questions about our client-side tools, feature proposals, or enterprise needs? Drop us a note.
        </p>
      </div>
    </section>

    {/* Contact Cards */}
    <section class="py-12 border-b border-border bg-background">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {
            contactCards.map((card) => {
              const content = (
                <div class="rounded-xl border border-border bg-surface p-6 shadow-soft h-full hover:border-brand/40 transition-colors">
                  <div class="w-10 h-10 rounded-lg bg-brand/10 text-brand flex items-center justify-center mb-4">
                    <Icon name={card.icon} class="w-5 h-5" />
                  </div>
                  <p class="text-[11px] font-mono uppercase tracking-wider text-muted-foreground mb-1">{card.label}</p>
                  <p class="text-base font-semibold text-foreground mb-1">{card.title}</p>
                  <p class="text-xs text-muted-foreground">{card.sub}</p>
                </div>
              );
              return card.href ? (
                <a href={card.href} class="block h-full">{content}</a>
              ) : (
                <div class="h-full">{content}</div>
              );
            })
          }
        </div>
      </div>
    </section>

    {/* Form & Channels */}
    <section class="py-16 sm:py-24 border-b border-border bg-surface-muted/10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
          {/* Form */}
          <div class="lg:col-span-7 rounded-2xl border border-border bg-surface p-6 sm:p-8 shadow-card">
            <h2 class="text-xl font-bold text-foreground mb-2">Send a Message</h2>
            <p class="text-xs text-muted-foreground mb-6">We read every message and respond directly to your inbox.</p>

            <form data-contact-form class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label for="firstName" class="block text-xs font-medium text-foreground">First Name</label>
                  <input id="firstName" required placeholder="Girish" class="w-full text-xs sm:text-sm h-10 px-3 rounded-lg border border-border bg-background text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand" />
                </div>
                <div class="space-y-1.5">
                  <label for="lastName" class="block text-xs font-medium text-foreground">Last Name</label>
                  <input id="lastName" placeholder="Lade" class="w-full text-xs sm:text-sm h-10 px-3 rounded-lg border border-border bg-background text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand" />
                </div>
              </div>

              <div class="space-y-1.5">
                <label for="email" class="block text-xs font-medium text-foreground">Work Email</label>
                <input id="email" type="email" required placeholder="developer@company.com" class="w-full text-xs sm:text-sm h-10 px-3 rounded-lg border border-border bg-background text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand" />
              </div>

              <div class="space-y-1.5">
                <label for="message" class="block text-xs font-medium text-foreground">Message</label>
                <textarea id="message" rows="5" required placeholder="How can we help your team?" class="w-full text-xs sm:text-sm p-3 rounded-lg border border-border bg-background text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"></textarea>
              </div>

              <Button type="submit" size="md" class="w-full justify-center">
                <span>Send Message</span>
                <Icon name="arrow-right" class="w-4 h-4" />
              </Button>
            </form>
          </div>

          {/* Direct channels */}
          <div class="lg:col-span-5 space-y-6">
            <div class="rounded-xl border border-border bg-surface p-6 shadow-soft space-y-4">
              <h3 class="text-sm font-semibold text-foreground">Direct Email</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                For security vulnerabilities, critical issues, or urgent inquiries:
              </p>
              <a href="mailto:admin@ladestack.in" class="inline-flex items-center gap-2 text-xs font-mono font-semibold text-brand hover:underline">
                <Icon name="mail" class="w-4 h-4" />
                admin@ladestack.in
              </a>
            </div>

            <div class="rounded-xl border border-border bg-surface p-6 shadow-soft space-y-3">
              <h3 class="text-sm font-semibold text-foreground">Follow & Connect</h3>
              <div class="flex gap-2">
                {
                  socials.map((s) => (
                    <a
                      href={s.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="p-2 rounded-lg border border-border bg-surface-muted hover:bg-surface text-muted-foreground hover:text-foreground transition-colors"
                      aria-label={s.label}
                    >
                      <Icon name={s.icon} class="w-4 h-4" />
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Contact FAQ */}
    <section class="py-16 sm:py-24 bg-background">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-foreground text-center mb-8">
          Support FAQ
        </h2>
        <Accordion>
          {
            faqs.map((f, i) => (
              <AccordionItem question={f.q} open={i === 0}>
                <p>{f.a}</p>
              </AccordionItem>
            ))
          }
        </Accordion>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var f = document.querySelector('[data-contact-form]');
      if (f) {
        f.addEventListener('submit', function (e) {
          e.preventDefault();
          var btn = f.querySelector('button[type="submit"]');
          if (btn) {
            btn.innerHTML = '<span>Message Delivered!</span>';
            btn.disabled = true;
          }
          f.reset();
          setTimeout(function () {
            if (btn) {
              btn.innerHTML = '<span>Send Message</span>';
              btn.disabled = false;
            }
          }, 3500);
        });
      }
    })();
  </script>
</BaseLayout>
