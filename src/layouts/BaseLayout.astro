---
/**
 * BaseLayout.astro — shared document shell.
 * Strict token styling, accessible skip link, optimized font loading with
 * font-display: swap, SEO meta integration, theme persistence guard.
 */
import SEO, {
  type RobotsMeta,
  type OpenGraphMeta,
  type TwitterMeta,
  type HreflangMeta,
} from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string | null;
  canonical: string;
  robots?: RobotsMeta;
  openGraph?: OpenGraphMeta;
  twitter?: TwitterMeta;
  hreflangs?: HreflangMeta[];
  structuredData?: Record<string, unknown>[];
  lang?: string;
  /** Pages with their own custom footer (e.g. /ai-code-viewer-ai) set this. */
  hideFooter?: boolean;
}

const {
  title,
  description,
  canonical,
  robots,
  openGraph,
  twitter,
  hreflangs,
  structuredData,
  lang = 'en',
  hideFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('ladestack-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      robots={robots}
      openGraph={openGraph}
      twitter={twitter}
      hreflangs={hreflangs}
      structuredData={structuredData}
      lang={lang}
    />
  </head>
  <body class="bg-background text-foreground antialiased flex flex-col min-h-screen">
    {/* Accessible skip link */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-brand focus:text-brand-foreground focus:rounded-lg focus:shadow-elevated focus:outline-none"
    >
      Skip to main content
    </a>

    <Header currentLang={lang} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    {!hideFooter && <Footer />}

    <script is:inline>
      (function () {
        document.addEventListener('click', function (e) {
          var t = e.target.closest('[data-theme-toggle]');
          if (!t) return;
          var el = document.documentElement;
          var isDark = el.classList.toggle('dark');
          try {
            localStorage.setItem('ladestack-theme', isDark ? 'dark' : 'light');
          } catch (err) {}
        });
      })();
    </script>
  </body>
</html>
