---
/**
 * BaseLayout.astro — shared document shell.
 * Strict token styling, accessible skip link, optimized font loading with
 * font-display: swap, SEO meta integration, theme persistence guard.
 */
import SEO, {
  type RobotsMeta,
  type OpenGraphMeta,
  type TwitterMeta,
  type HreflangMeta,
} from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { DEFAULT_LOCALE, LOCALE_CONFIG, isValidLocale, type Locale } from '../i18n/config';
import { getLangFromUrl } from '../i18n/utils';

export interface Props {
  title: string;
  description?: string | null;
  canonical: string;
  robots?: RobotsMeta;
  openGraph?: OpenGraphMeta;
  twitter?: TwitterMeta;
  hreflangs?: HreflangMeta[];
  structuredData?: Record<string, unknown>[];
  lang?: string;
  locale?: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
  /** Pages with their own custom footer (e.g. /gb-coder) set this. */
  hideFooter?: boolean;
}

const {
  title,
  description,
  canonical,
  robots,
  openGraph,
  twitter,
  hreflangs,
  structuredData,
  lang,
  locale,
  alternateUrls,
  hideFooter = false,
} = Astro.props;

const currentLocale: Locale =
  locale ?? (isValidLocale(lang) ? lang : getLangFromUrl(Astro.url));
const dir = LOCALE_CONFIG[currentLocale]?.dir ?? 'ltr';
---

<!doctype html>
<html lang={currentLocale} dir={dir} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          // ── 1. THEME: Universal OS/Device/Browser Sync (Windows, macOS, iOS, Android, Linux) ──
          var media = window.matchMedia('(prefers-color-scheme: dark)');
          var storedTheme = null;
          try {
            storedTheme = localStorage.getItem('ladestack-theme') || localStorage.getItem('theme');
          } catch (err) {}

          function applyTheme(isDark) {
            if (isDark) {
              document.documentElement.classList.add('dark');
            } else {
              document.documentElement.classList.remove('dark');
            }
          }

          if (storedTheme === 'dark') {
            applyTheme(true);
          } else if (storedTheme === 'light') {
            applyTheme(false);
          } else {
            // Unconditionally match device / OS preference
            applyTheme(media.matches);
          }

          var handleThemeChange = function (e) {
            try {
              var currentStored = localStorage.getItem('ladestack-theme') || localStorage.getItem('theme');
              if (!currentStored) {
                applyTheme(e.matches);
              }
            } catch (err) {}
          };

          if (typeof media.addEventListener === 'function') {
            media.addEventListener('change', handleThemeChange);
          } else if (typeof media.addListener === 'function') {
            media.addListener(handleThemeChange);
          }

          // ── 2. LANGUAGE: Device/Browser Locale Auto-Detection & Persistence ──
          var isBot = /bot|googlebot|crawler|spider|robot|crawling/i.test(navigator.userAgent || '');
          if (!isBot) {
            var supportedLocales = ['en', 'ja', 'ko', 'zh', 'ru', 'tr', 'fr', 'pt', 'es'];
            var storedLocale = null;
            try {
              storedLocale = localStorage.getItem('ladestack-locale');
            } catch (err) {}

            var pathname = window.location.pathname || '/';
            var segments = pathname.replace(/^\/+/, '').split('/');
            var firstSegment = segments[0] || '';
            var currentUrlLocale = (supportedLocales.indexOf(firstSegment) !== -1 && firstSegment !== 'en')
              ? firstSegment
              : 'en';

            var targetLocale = null;
            if (storedLocale && supportedLocales.indexOf(storedLocale) !== -1) {
              targetLocale = storedLocale;
            } else {
              var navLangs = navigator.languages || [navigator.language || 'en'];
              for (var i = 0; i < navLangs.length; i++) {
                var rawLang = (navLangs[i] || '').toLowerCase().trim();
                var primary = rawLang.split('-')[0];
                if (supportedLocales.indexOf(primary) !== -1) {
                  targetLocale = primary;
                  break;
                }
              }
              if (!targetLocale) {
                targetLocale = 'en';
              }
            }

            // Only redirect if current route differs from target locale
            if (targetLocale && targetLocale !== currentUrlLocale) {
              var cleanPath = currentUrlLocale === 'en'
                ? pathname
                : '/' + segments.slice(1).join('/');
              if (!cleanPath.startsWith('/')) cleanPath = '/' + cleanPath;
              if (cleanPath.length > 1 && cleanPath.endsWith('/')) {
                cleanPath = cleanPath.slice(0, -1);
              }

              var destination = targetLocale === 'en'
                ? cleanPath
                : (cleanPath === '/' ? '/' + targetLocale : '/' + targetLocale + cleanPath);

              var searchParams = window.location.search || '';
              if (destination !== pathname && searchParams.indexOf('no-redirect') === -1) {
                window.location.replace(destination + searchParams + (window.location.hash || ''));
              }
            }
          }
        } catch (e) {}
      })();
    </script>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      robots={robots}
      openGraph={openGraph}
      twitter={twitter}
      hreflangs={hreflangs}
      structuredData={structuredData}
      lang={currentLocale}
    />
  </head>
  <body class="bg-background text-foreground antialiased flex flex-col min-h-screen">
    {/* Accessible skip link */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-brand focus:text-brand-foreground focus:rounded-lg focus:shadow-elevated focus:outline-none"
    >
      Skip to main content
    </a>

    <Header currentLang={currentLocale} locale={currentLocale} alternateUrls={alternateUrls} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    {!hideFooter && <Footer locale={currentLocale} />}

    <script>
      import { executeThemeTransition, type TransitionVariant } from '../components/ui/animated-theme-toggler';

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const btn = target?.closest('[data-theme-toggle]') as HTMLElement | null;
        if (!btn) return;

        const variant = (btn.getAttribute('data-vt-variant') || 'circle') as TransitionVariant;
        const duration = parseInt(btn.getAttribute('data-vt-duration') || '400', 10);
        const fromCenter = btn.getAttribute('data-vt-from-center') === 'true';

        executeThemeTransition({
          button: btn,
          variant,
          duration,
          fromCenter,
        });
      });
    </script>
  </body>
</html>
