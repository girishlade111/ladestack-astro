---
/**
 * BaseLayout.astro — shared document shell.
 * Strict token styling, accessible skip link, optimized font loading with
 * font-display: swap, SEO meta integration, theme persistence guard.
 */
import SEO, {
  type RobotsMeta,
  type OpenGraphMeta,
  type TwitterMeta,
  type HreflangMeta,
} from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnalyticsManager from '../components/analytics/AnalyticsManager.astro';
import '../styles/global.css';
import { DEFAULT_LOCALE, LOCALE_CONFIG, isValidLocale, type Locale } from '../i18n/config';
import { getLangFromUrl } from '../i18n/utils';

export interface Props {
  title: string;
  description?: string | null;
  canonical: string;
  robots?: RobotsMeta;
  openGraph?: OpenGraphMeta;
  twitter?: TwitterMeta;
  hreflangs?: HreflangMeta[];
  structuredData?: Record<string, unknown>[];
  lang?: string;
  locale?: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
  /** Pages with their own custom footer (e.g. /gb-coder) set this. */
  hideFooter?: boolean;
}

const {
  title,
  description,
  canonical,
  robots,
  openGraph,
  twitter,
  hreflangs,
  structuredData,
  lang,
  locale,
  alternateUrls,
  hideFooter = false,
} = Astro.props;

const currentLocale: Locale =
  locale ?? (isValidLocale(lang) ? lang : getLangFromUrl(Astro.url));
const dir = LOCALE_CONFIG[currentLocale]?.dir ?? 'ltr';
---

<!doctype html>
<html lang={currentLocale} dir={dir} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.onload=null;this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600;700&display=swap"
      />
    </noscript>
    <script is:inline>
      (function () {
        try {
          // ── 1. THEME: Universal OS/Device/Browser Sync (Windows, macOS, iOS, Android, Linux) ──
          var media = window.matchMedia('(prefers-color-scheme: dark)');
          var storedTheme = null;
          try {
            storedTheme = localStorage.getItem('ladestack-theme') || localStorage.getItem('theme');
          } catch (err) {}

          function applyTheme(isDark) {
            if (isDark) {
              document.documentElement.classList.add('dark');
            } else {
              document.documentElement.classList.remove('dark');
            }
          }

          if (storedTheme === 'dark') {
            applyTheme(true);
          } else if (storedTheme === 'light') {
            applyTheme(false);
          } else {
            // Unconditionally match device / OS preference
            applyTheme(media.matches);
          }

          var handleThemeChange = function (e) {
            try {
              var currentStored = localStorage.getItem('ladestack-theme') || localStorage.getItem('theme');
              if (!currentStored) {
                applyTheme(e.matches);
              }
            } catch (err) {}
          };

          if (typeof media.addEventListener === 'function') {
            media.addEventListener('change', handleThemeChange);
          } else if (typeof media.addListener === 'function') {
            media.addListener(handleThemeChange);
          }

        } catch (e) {}
      })();
    </script>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      robots={robots}
      openGraph={openGraph}
      twitter={twitter}
      hreflangs={hreflangs}
      structuredData={structuredData}
      lang={currentLocale}
    />
  </head>
  <body class="bg-background text-foreground antialiased flex flex-col min-h-screen">
    {/* Accessible skip link */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-brand focus:text-brand-foreground focus:rounded-lg focus:shadow-elevated focus:outline-none"
    >
      Skip to main content
    </a>

    <Header currentLang={currentLocale} locale={currentLocale} alternateUrls={alternateUrls} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    {!hideFooter && <Footer locale={currentLocale} />}

    <script>
      import { executeThemeTransition, type TransitionVariant } from '../components/ui/animated-theme-toggler';

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const btn = target?.closest('[data-theme-toggle]') as HTMLElement | null;
        if (!btn) return;

        const variant = (btn.getAttribute('data-vt-variant') || 'circle') as TransitionVariant;
        const duration = parseInt(btn.getAttribute('data-vt-duration') || '750', 10);
        const fromCenter = btn.getAttribute('data-vt-from-center') === 'true';

        executeThemeTransition({
          button: btn,
          variant,
          duration,
          fromCenter,
        });
      });
    </script>
    <AnalyticsManager locale={currentLocale} />
  </body>
</html>
