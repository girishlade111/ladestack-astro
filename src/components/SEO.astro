---
/**
 * SEO.astro — Complete reusable head-metadata component.
 * Supports canonical URLs, extensible hreflang alternates (rendered only when
 * genuine localized pages exist), OpenGraph with dimensions, Twitter Cards,
 * theme-color, and schema.org JSON-LD injections.
 */

export interface RobotsMeta {
  index: boolean;
  follow: boolean;
  custom?: string | null;
}

export interface OpenGraphMeta {
  title?: string | null;
  description?: string | null;
  url?: string | null;
  type?: string | null;
  image?: string | null;
  width?: number;
  height?: number;
  alt?: string | null;
}

export interface TwitterMeta {
  card?: string | null;
  title?: string | null;
  description?: string | null;
  image?: string | null;
  alt?: string | null;
  site?: string | null;
  creator?: string | null;
}

export interface HreflangMeta {
  lang: string;
  href: string;
}

export interface Props {
  title: string;
  description?: string | null;
  canonical: string;
  robots?: RobotsMeta;
  openGraph?: OpenGraphMeta;
  twitter?: TwitterMeta;
  hreflangs?: HreflangMeta[];
  structuredData?: Record<string, unknown>[];
  siteName?: string;
  lang?: string;
  locale?: string;
}

const {
  title,
  description = null,
  canonical,
  robots = { index: true, follow: true, custom: null },
  openGraph = {},
  twitter = {},
  hreflangs = [],
  structuredData = [],
  siteName = 'Lade Stack',
  lang = 'en',
  locale = 'en_US',
} = Astro.props;

const robotsContent = [
  robots.index ? 'index' : 'noindex',
  robots.follow ? 'follow' : 'nofollow',
  robots.custom ?? '',
]
  .filter(Boolean)
  .join(', ');

const ogImage = openGraph.image ?? 'https://ladestack.in/og-image.png';
const twitterImage = twitter.image ?? ogImage;
const ogAlt = openGraph.alt ?? title;
const ogWidth = openGraph.width ?? 1200;
const ogHeight = openGraph.height ?? 630;
---

<title>{title}</title>
{description && <meta name="description" content={description} />}
<meta name="robots" content={robotsContent} />
<link rel="canonical" href={canonical} />

{/* Theme Color adaptation for mobile browser chrome */}
<meta name="theme-color" content="#090D16" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#F8FAFC" media="(prefers-color-scheme: light)" />

{/* Extensible localized alternates — only rendered when authentic translated URLs are provided */}
{hreflangs.length > 0 && hreflangs.map((h) => (
  <link rel="alternate" hreflang={h.lang} href={h.href} />
))}

{/* Open Graph */}
<meta property="og:title" content={openGraph.title ?? title} />
{description && <meta property="og:description" content={openGraph.description ?? description} />}
<meta property="og:url" content={openGraph.url ?? canonical} />
<meta property="og:type" content={openGraph.type ?? 'website'} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(ogWidth)} />
<meta property="og:image:height" content={String(ogHeight)} />
<meta property="og:image:alt" content={ogAlt} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale} />

{/* Twitter Card */}
<meta name="twitter:card" content={twitter.card ?? 'summary_large_image'} />
<meta name="twitter:title" content={twitter.title ?? title} />
{description && <meta name="twitter:description" content={twitter.description ?? description} />}
<meta name="twitter:image" content={twitterImage} />
<meta name="twitter:image:alt" content={twitter.alt ?? ogAlt} />
{twitter.site && <meta name="twitter:site" content={twitter.site} />}
{twitter.creator && <meta name="twitter:creator" content={twitter.creator} />}

{/* Structured Data (JSON-LD) */}
{structuredData.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
