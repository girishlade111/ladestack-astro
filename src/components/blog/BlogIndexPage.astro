---
/**
 * BlogIndexPage.astro
 * Premium editorial blog landing page for LadeStack.
 * Supports:
 * - 9-locale dynamic filtering and localized routing
 * - Instant client-side search by title, tags, description
 * - Category filter pills
 * - Featured article spotlight
 * - Responsive grid with cover images, reading times, publication dates
 * - Empty states & no-results feedback
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import Badge from '../ui/Badge.astro';
import type { BlogEntry } from '../../lib/blogUtils';
import type { BlogPost } from '../../data/blogPosts';
import { estimateReadingTime, formatBlogDate, getPostPath, getPostUrl } from '../../lib/blogUtils';
import { LOCALES, type Locale } from '../../i18n/config';
import { useTranslations, getLocalizedPath, getHreflangLinks } from '../../i18n/utils';

export interface Props {
  locale: Locale;
  posts: BlogEntry[];
  legacyPosts?: BlogPost[];
}

const { locale, posts, legacyPosts = [] } = Astro.props;
const t = useTranslations(locale);

// Sort posts: featured first, then newest publishedAt
const sortedPosts = [...posts].sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  const dateA = new Date(a.data.publishedAt).getTime();
  const dateB = new Date(b.data.publishedAt).getTime();
  return dateB - dateA;
});

// Identify featured post for the hero spotlight (if any)
const featuredPost = sortedPosts.find((p) => p.data.featured) ?? sortedPosts[0];
const standardPosts = featuredPost
  ? sortedPosts.filter((p) => p.id !== featuredPost.id)
  : sortedPosts;

// Extract unique categories for this locale
const availableCategories = ['All', ...new Set(posts.map((p) => p.data.category))];

const canonical = locale === 'en' ? 'https://ladestack.in/blog' : `https://ladestack.in/${locale}/blog`;
const hreflangs = getHreflangLinks('/blog');

// Structured Data for Blog
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'LadeStack Engineering Blog',
    description: 'Technical deep-dives into client-side architecture, WebAssembly, browser IDEs, and performance engineering.',
    url: canonical,
    inLanguage: locale,
    publisher: {
      '@type': 'Organization',
      name: 'LadeStack',
      url: 'https://ladestack.in',
      logo: {
        '@type': 'ImageObject',
        url: 'https://ladestack.in/logo.png',
      },
    },
  },
];
---

<BaseLayout
  title={`Blog – Engineering Insights & Technical Guides | LadeStack`}
  description="Explore technical architecture deep-dives, WebAssembly benchmarks, client-side security guides, and developer tooling insights from the LadeStack team."
  canonical={canonical}
  locale={locale}
  hreflangs={hreflangs}
  structuredData={structuredData}
  openGraph={{
    title: 'LadeStack Engineering Blog',
    description: 'Technical architecture deep-dives, WebAssembly benchmarks, client-side security guides, and developer tooling insights.',
    url: canonical,
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'LadeStack Engineering Blog',
    description: 'Technical architecture deep-dives, WebAssembly benchmarks, client-side security guides, and developer tooling insights.',
    image: 'https://ladestack.in/og-image.png',
  }}
>
  <div class="min-h-screen bg-background text-foreground" data-blog-container>
    {/* Hero Section */}
    <section class="relative pt-16 pb-12 border-b border-border bg-surface-muted/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-brand/30 bg-brand/10 text-brand text-xs font-mono font-medium mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-brand animate-pulse"></span>
          <span>LadeStack Technical Editorial</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-bold text-foreground tracking-tight leading-tight max-w-3xl mx-auto">
          Engineering Insights & Architecture
        </h1>

        <p class="mt-4 text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
          Deep-dives into in-browser code execution, WebAssembly data processing, client-side security, and high-performance developer utilities.
        </p>

        {/* Live Search Input */}
        <div class="mt-8 max-w-md mx-auto relative">
          <Icon
            name="search"
            class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground pointer-events-none"
          />
          <input
            type="text"
            data-blog-search
            placeholder="Search articles, architectures, keywords…"
            aria-label="Search articles by title, tags or content"
            class="w-full h-11 pl-10 pr-9 rounded-xl border border-border bg-surface text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-brand shadow-soft transition"
          />
          <button
            type="button"
            data-blog-clear-search
            class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground p-1"
            aria-label="Clear search query"
          >
            <Icon name="x" class="w-4 h-4" />
          </button>
        </div>
      </div>
    </section>

    {/* Sticky Category Filter Bar */}
    <section class="sticky top-16 z-30 border-b border-border bg-background/90 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-2 py-3 overflow-x-auto scrollbar-none" data-blog-cats>
          {
            availableCategories.map((cat) => (
              <button
                type="button"
                data-blog-cat={cat}
                class={`flex-shrink-0 rounded-lg px-3.5 py-1.5 text-xs font-medium border transition-colors ${
                  cat === 'All'
                    ? 'bg-brand border-brand text-brand-foreground shadow-soft active-cat'
                    : 'bg-surface border-border text-muted-foreground hover:text-foreground hover:bg-surface-muted'
                }`}
              >
                {cat === 'All' ? 'All Articles' : cat}
              </button>
            ))
          }
        </div>
      </div>
    </section>

    {/* Main Blog Content Area */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      {/* Featured Article Hero Card (Visible on Default View) */}
      {
        featuredPost && (
          <div data-featured-section class="mb-12">
            <p class="text-xs font-mono uppercase tracking-wider text-brand font-semibold mb-3 flex items-center gap-1.5">
              <Icon name="star" class="w-3.5 h-3.5 text-brand" />
              Featured Deep-Dive
            </p>
            <a
              href={getPostPath(featuredPost.data.slug, locale)}
              class="group grid grid-cols-1 lg:grid-cols-12 rounded-2xl border border-border bg-surface overflow-hidden hover:border-brand/40 transition-all shadow-elevated"
            >
              <div class="lg:col-span-7 aspect-video lg:aspect-auto overflow-hidden bg-surface-muted">
                <img
                  src={featuredPost.data.coverImage}
                  alt={featuredPost.data.coverAlt}
                  width="700"
                  height="400"
                  loading="eager"
                  decoding="async"
                  class="w-full h-full object-cover object-center group-hover:scale-102 transition-transform duration-500"
                />
              </div>
              <div class="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-2 mb-3">
                    <Badge variant="brand" size="sm">
                      {featuredPost.data.category}
                    </Badge>
                    <span class="text-xs font-mono text-muted-foreground">
                      {estimateReadingTime(featuredPost.body ?? '', locale)}
                    </span>
                  </div>
                  <h2 class="text-2xl sm:text-3xl font-bold text-foreground group-hover:text-brand transition-colors leading-tight mb-3">
                    {featuredPost.data.title}
                  </h2>
                  <p class="text-sm text-muted-foreground leading-relaxed line-clamp-3 mb-6">
                    {featuredPost.data.description}
                  </p>
                </div>
                <div class="pt-4 border-t border-border flex items-center justify-between">
                  <div class="text-xs">
                    <span class="font-medium text-foreground">{featuredPost.data.author}</span>
                    <span class="text-muted-foreground"> · {formatBlogDate(featuredPost.data.publishedAt, locale)}</span>
                  </div>
                  <span class="inline-flex items-center gap-1 text-xs font-semibold text-brand group-hover:translate-x-0.5 transition-transform">
                    <span>Read Article</span>
                    <Icon name="arrow-right" class="w-3.5 h-3.5" />
                  </span>
                </div>
              </div>
            </a>
          </div>
        )
      }

      {/* Grid of Articles */}
      <div
        data-blog-grid
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
      >
        {
          sortedPosts.map((post) => (
            <article
              data-post-card
              data-category={post.data.category}
              data-title={post.data.title.toLowerCase()}
              data-description={post.data.description.toLowerCase()}
              data-tags={post.data.tags.join(' ').toLowerCase()}
              class="flex flex-col rounded-xl border border-border bg-surface overflow-hidden hover:border-brand/40 transition-all shadow-soft group"
            >
              <a
                href={getPostPath(post.data.slug, locale)}
                class="block aspect-[16/9] overflow-hidden bg-surface-muted"
                tabindex="-1"
                aria-hidden="true"
              >
                <img
                  src={post.data.coverImage}
                  alt={post.data.coverAlt}
                  width="400"
                  height="225"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover object-center group-hover:scale-102 transition-transform duration-300"
                />
              </a>

              <div class="p-5 flex-1 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2.5">
                    <span class="text-[11px] font-mono font-semibold text-brand uppercase tracking-wider">
                      {post.data.category}
                    </span>
                    <span class="text-xs font-mono text-muted-foreground flex items-center gap-1">
                      <Icon name="clock" class="w-3 h-3" />
                      {estimateReadingTime(post.body ?? '', locale)}
                    </span>
                  </div>

                  <h3 class="text-base font-bold text-foreground leading-snug group-hover:text-brand transition-colors mb-2 line-clamp-2">
                    <a href={getPostPath(post.data.slug, locale)}>
                      {post.data.title}
                    </a>
                  </h3>

                  <p class="text-xs text-muted-foreground leading-relaxed line-clamp-3 mb-4">
                    {post.data.description}
                  </p>
                </div>

                <div class="pt-3 border-t border-border flex items-center justify-between text-[11px] text-muted-foreground">
                  <span>{formatBlogDate(post.data.publishedAt, locale)}</span>
                  <span class="text-foreground font-medium">{post.data.author}</span>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      {/* Legacy Technical Archive (English Only) */}
      {
        locale === 'en' && legacyPosts.length > 0 && (
          <section data-legacy-archive-section class="mt-20 pt-12 border-t border-border">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
              <div>
                <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border border-border bg-surface-muted text-[11px] font-mono text-muted-foreground mb-2">
                  <Icon name="archive" class="w-3.5 h-3.5 text-muted-foreground" />
                  <span>Historical Documentation</span>
                </div>
                <h2 class="text-2xl font-bold text-foreground tracking-tight">
                  Legacy Article Archive
                </h2>
                <p class="text-sm text-muted-foreground mt-1 max-w-2xl">
                  Foundational engineering guides and architectural overviews from the initial LadeStack publication system. All articles remain accessible under their canonical URLs as they are scheduled for Markdown modernization.
                </p>
              </div>
              <span class="text-xs font-mono text-muted-foreground bg-surface px-3 py-1.5 rounded-lg border border-border shrink-0 self-start sm:self-auto">
                {legacyPosts.length} Legacy Articles
              </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" data-legacy-grid>
              {legacyPosts.map((post) => (
                <article
                  data-legacy-card
                  data-title={post.title.toLowerCase()}
                  data-description={post.excerpt.toLowerCase()}
                  data-category={post.category}
                  class="flex flex-col rounded-xl border border-border bg-surface/70 hover:bg-surface p-5 transition-all hover:border-brand/40 shadow-soft group"
                >
                  <div class="flex items-center justify-between gap-2 mb-2.5">
                    <span class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-surface-muted text-muted-foreground border border-border/60">
                      {post.category}
                    </span>
                    <span class="text-[11px] font-mono text-muted-foreground">
                      {post.readTime}
                    </span>
                  </div>

                  <h3 class="text-base font-semibold text-foreground group-hover:text-brand transition-colors line-clamp-2 mb-2 leading-snug">
                    <a href={`/blog/${post.slug}`} class="focus:outline-none">
                      {post.title}
                    </a>
                  </h3>

                  <p class="text-xs text-muted-foreground line-clamp-3 leading-relaxed mb-4 flex-1">
                    {post.excerpt}
                  </p>

                  <div class="pt-3 border-t border-border/60 flex items-center justify-between text-[11px] text-muted-foreground">
                    <span>{post.date}</span>
                    <span class="inline-flex items-center gap-1 font-medium text-brand group-hover:translate-x-0.5 transition-transform">
                      <span>Read</span>
                      <Icon name="arrow-right" class="w-3 h-3" />
                    </span>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )
      }

      {/* No Results Empty State */}
      <div
        data-no-results
        class="hidden py-16 text-center border border-dashed border-border rounded-2xl bg-surface/40 my-8"
      >
        <div class="w-12 h-12 rounded-full bg-surface-muted flex items-center justify-center mx-auto mb-4 text-muted-foreground">
          <Icon name="search" class="w-6 h-6" />
        </div>
        <h3 class="text-lg font-bold text-foreground mb-1">No matching articles found</h3>
        <p class="text-sm text-muted-foreground max-w-sm mx-auto mb-4">
          We couldn't find any articles matching your search query or category filter.
        </p>
        <button
          type="button"
          data-reset-filter
          class="px-4 py-2 rounded-lg border border-border bg-surface hover:bg-surface-muted text-xs font-medium text-foreground transition-colors"
        >
          Reset Filters
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var searchInput = document.querySelector('[data-blog-search]');
    var clearBtn = document.querySelector('[data-blog-clear-search]');
    var catButtons = document.querySelectorAll('[data-blog-cat]');
    var postCards = document.querySelectorAll('[data-post-card]');
    var legacyCards = document.querySelectorAll('[data-legacy-card]');
    var legacySection = document.querySelector('[data-legacy-archive-section]');
    var noResults = document.querySelector('[data-no-results]');
    var featuredSection = document.querySelector('[data-featured-section]');
    var resetBtn = document.querySelector('[data-reset-filter]');

    var activeCategory = 'All';
    var searchQuery = '';

    function filterPosts() {
      var query = searchQuery.trim().toLowerCase();
      var visibleCount = 0;
      var visibleLegacyCount = 0;

      // Hide featured banner if a search is active or category is filtered
      if (featuredSection) {
        if (query.length > 0 || activeCategory !== 'All') {
          featuredSection.style.display = 'none';
        } else {
          featuredSection.style.display = '';
        }
      }

      postCards.forEach(function (card) {
        var cardCategory = card.getAttribute('data-category') || '';
        var cardTitle = card.getAttribute('data-title') || '';
        var cardDesc = card.getAttribute('data-description') || '';
        var cardTags = card.getAttribute('data-tags') || '';

        var matchesCategory = activeCategory === 'All' || cardCategory === activeCategory;
        var matchesSearch =
          query.length === 0 ||
          cardTitle.indexOf(query) !== -1 ||
          cardDesc.indexOf(query) !== -1 ||
          cardTags.indexOf(query) !== -1;

        if (matchesCategory && matchesSearch) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      legacyCards.forEach(function (card) {
        var cardCategory = card.getAttribute('data-category') || '';
        var cardTitle = card.getAttribute('data-title') || '';
        var cardDesc = card.getAttribute('data-description') || '';

        var matchesCategory = activeCategory === 'All' || cardCategory.toLowerCase() === activeCategory.toLowerCase();
        var matchesSearch =
          query.length === 0 ||
          cardTitle.indexOf(query) !== -1 ||
          cardDesc.indexOf(query) !== -1;

        if (matchesCategory && matchesSearch) {
          card.style.display = '';
          visibleLegacyCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (legacySection) {
        legacySection.style.display = visibleLegacyCount > 0 ? '' : 'none';
      }

      if (noResults) {
        if (visibleCount === 0 && visibleLegacyCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', function (e) {
        searchQuery = e.target.value;
        if (clearBtn) {
          if (searchQuery.length > 0) {
            clearBtn.classList.remove('hidden');
          } else {
            clearBtn.classList.add('hidden');
          }
        }
        filterPosts();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        if (searchInput) {
          searchInput.value = '';
          searchQuery = '';
          clearBtn.classList.add('hidden');
          searchInput.focus();
          filterPosts();
        }
      });
    }

    catButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var cat = btn.getAttribute('data-blog-cat');
        activeCategory = cat || 'All';

        catButtons.forEach(function (b) {
          b.classList.remove('bg-brand', 'border-brand', 'text-brand-foreground', 'shadow-soft');
          b.classList.add('bg-surface', 'border-border', 'text-muted-foreground');
        });

        btn.classList.add('bg-brand', 'border-brand', 'text-brand-foreground', 'shadow-soft');
        btn.classList.remove('bg-surface', 'border-border', 'text-muted-foreground');

        filterPosts();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        activeCategory = 'All';
        searchQuery = '';
        if (searchInput) searchInput.value = '';
        if (clearBtn) clearBtn.classList.add('hidden');

        catButtons.forEach(function (b) {
          var isAll = b.getAttribute('data-blog-cat') === 'All';
          if (isAll) {
            b.classList.add('bg-brand', 'border-brand', 'text-brand-foreground', 'shadow-soft');
            b.classList.remove('bg-surface', 'border-border', 'text-muted-foreground');
          } else {
            b.classList.remove('bg-brand', 'border-brand', 'text-brand-foreground', 'shadow-soft');
            b.classList.add('bg-surface', 'border-border', 'text-muted-foreground');
          }
        });

        filterPosts();
      });
    }
  })();
</script>
