---
/**
 * LanguageSwitcher.astro
 * Accessible, zero-JS compatible language switcher supporting all nine languages.
 * Links work with standard <a> tags without requiring client-side JS.
 * Identifies active language visually and accessibly.
 */
import Icon from './Icon.astro';
import { LOCALES, LOCALE_CONFIG, DEFAULT_LOCALE, type Locale } from '../i18n/config';
import {
  getLocalizedPath,
  stripLocaleFromPath,
  isRouteAvailableInLocale,
  getAvailableLocalesForRoute,
  useTranslations,
} from '../i18n/utils';

export interface Props {
  currentLocale?: Locale;
  currentPath?: string;
  alternateUrls?: Partial<Record<Locale, string>>;
  direction?: 'down' | 'up';
  class?: string;
}

const {
  currentLocale = DEFAULT_LOCALE,
  currentPath = Astro.url.pathname,
  alternateUrls,
  direction = 'down',
  class: className = '',
} = Astro.props;

const currentConfig = LOCALE_CONFIG[currentLocale] ?? LOCALE_CONFIG[DEFAULT_LOCALE];
const basePath = stripLocaleFromPath(currentPath);
const t = useTranslations(currentLocale);

const availableLocales = alternateUrls
  ? (Object.keys(alternateUrls) as Locale[])
  : getAvailableLocalesForRoute(basePath);
const isFullyTranslated = availableLocales.length === LOCALES.length;

const menuPositionClass = direction === 'up'
  ? 'bottom-full mb-2 right-0'
  : 'top-full mt-2 right-0';
---

<div class={`relative inline-block text-left ${className}`} data-language-switcher>
  <button
    type="button"
    data-lang-trigger
    class="inline-flex items-center gap-1.5 h-9 px-2.5 rounded-lg border border-border bg-surface-muted/60 hover:bg-surface-muted text-muted-foreground hover:text-foreground text-xs font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label={`${currentLocale.toUpperCase()} - ${t('nav.languageSelect')}: ${currentConfig.name}`}
  >
    <Icon name="globe" class="w-3.5 h-3.5 text-brand" />
    <span class="font-mono text-[11px] font-semibold uppercase">{currentLocale}</span>
    <Icon name="chevron-down" class="w-3 h-3 text-muted-foreground/70 transition-transform duration-200" data-lang-chevron />
  </button>

  <div
    data-lang-menu
    class={`hidden absolute ${menuPositionClass} w-64 rounded-xl border border-border bg-surface p-1.5 shadow-elevated z-50 focus:outline-none`}
    role="menu"
    aria-orientation="vertical"
    tabindex="-1"
  >
    <div class="px-3 py-1.5 border-b border-border flex items-center justify-between text-[10px] font-mono uppercase tracking-wider text-muted-foreground">
      <span>{t('nav.languageSelect')}</span>
      <span class="text-brand font-semibold">9 Locales</span>
    </div>

    {
      !isFullyTranslated && (
        <div class="px-3 py-1.5 bg-surface-muted/40 border-b border-border/60 text-[10px] text-muted-foreground leading-tight">
          {alternateUrls
            ? 'Article is available in selected languages. Other options navigate to the localized blog index.'
            : 'This section is currently available in selected languages.'}
        </div>
      )
    }

    <div class="py-1 max-h-72 overflow-y-auto">
      {
        LOCALES.map((loc) => {
          const cfg = LOCALE_CONFIG[loc];
          const isCurrent = loc === currentLocale;

          let targetUrl: string;
          let hasDirectTranslation: boolean;
          let fallbackLabel: string;

          if (alternateUrls) {
            if (alternateUrls[loc]) {
              targetUrl = alternateUrls[loc]!;
              hasDirectTranslation = true;
              fallbackLabel = '';
            } else {
              targetUrl = getLocalizedPath('/blog', loc);
              hasDirectTranslation = false;
              fallbackLabel = 'Blog';
            }
          } else {
            hasDirectTranslation = isRouteAvailableInLocale(basePath, loc);
            targetUrl = hasDirectTranslation
              ? getLocalizedPath(basePath, loc)
              : getLocalizedPath('/', loc);
            fallbackLabel = 'Home';
          }

          const titleAttr = !hasDirectTranslation
            ? `${cfg.name}: Navigates to ${fallbackLabel.toLowerCase()}`
            : `${cfg.name} (${cfg.englishName})`;

          return (
            <a
              href={targetUrl}
              role="menuitem"
              lang={loc}
              data-lang-choice={loc}
              title={titleAttr}
              class={`flex items-center justify-between px-3 py-2 text-xs rounded-lg transition-colors group ${
                isCurrent
                  ? 'bg-brand/10 text-brand font-semibold'
                  : 'text-foreground hover:bg-surface-muted hover:text-foreground'
              }`}
              aria-current={isCurrent ? 'true' : undefined}
            >
              <div class="flex items-center gap-2">
                {isCurrent && <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>}
                <span class={isCurrent ? 'font-semibold' : ''}>{cfg.name}</span>
                <span class="text-[11px] text-muted-foreground">({cfg.englishName})</span>
              </div>
              <div class="flex items-center gap-1.5">
                {!hasDirectTranslation && (
                  <span class="text-[9px] font-mono px-1.5 py-0.2 rounded bg-surface-muted text-muted-foreground">
                    {fallbackLabel}
                  </span>
                )}
                <span class="font-mono text-[10px] text-muted-foreground uppercase">{loc}</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    function initLanguageSwitchers() {
      document.querySelectorAll('[data-language-switcher]').forEach(function (container) {
        if (container.__langInitialized) return;
        container.__langInitialized = true;

        var trigger = container.querySelector('[data-lang-trigger]');
        var menu = container.querySelector('[data-lang-menu]');
        var chevron = container.querySelector('[data-lang-chevron]');
        if (!trigger || !menu) return;

        function openMenu() {
          menu.classList.remove('hidden');
          trigger.setAttribute('aria-expanded', 'true');
          if (chevron) chevron.classList.add('rotate-180');
        }

        function closeMenu() {
          menu.classList.add('hidden');
          trigger.setAttribute('aria-expanded', 'false');
          if (chevron) chevron.classList.remove('rotate-180');
        }

        trigger.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var isOpen = trigger.getAttribute('aria-expanded') === 'true';

          // Close any other open switchers on the page
          document.querySelectorAll('[data-language-switcher]').forEach(function (other) {
            if (other !== container) {
              var otherTrigger = other.querySelector('[data-lang-trigger]');
              var otherMenu = other.querySelector('[data-lang-menu]');
              var otherChevron = other.querySelector('[data-lang-chevron]');
              if (otherMenu) otherMenu.classList.add('hidden');
              if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
              if (otherChevron) otherChevron.classList.remove('rotate-180');
            }
          });

          if (isOpen) {
            closeMenu();
          } else {
            openMenu();
          }
        });

        document.addEventListener('click', function (e) {
          if (!container.contains(e.target)) {
            closeMenu();
          }
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
            closeMenu();
            trigger.focus();
          }
        });
      });
    }

    // Persist language selection when user clicks a language option
    document.addEventListener('click', function (e) {
      var target = e.target && e.target.closest ? e.target.closest('[data-lang-choice]') : null;
      if (target) {
        var choice = target.getAttribute('data-lang-choice');
        if (choice) {
          try {
            localStorage.setItem('ladestack-locale', choice);
          } catch (err) {}
        }
      }
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLanguageSwitchers);
    } else {
      initLanguageSwitchers();
    }
    document.addEventListener('astro:page-load', initLanguageSwitchers);
  })();
</script>
