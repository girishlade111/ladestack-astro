---
/**
 * Icon.astro — exact Lucide + brand SVGs as inline markup.
 * Stroke icons: lucide-static (?raw). Brands: simple-icons (GitHub,
 * Instagram) + canonical LinkedIn path (removed upstream) — sized via
 * the `class` prop exactly like lucide-react's className.
 */
import alertCircle from 'lucide-static/icons/alert-circle.svg?raw';
import arrowLeft from 'lucide-static/icons/arrow-left.svg?raw';
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import award from 'lucide-static/icons/award.svg?raw';
import barChart3 from 'lucide-static/icons/bar-chart-3.svg?raw';
import bookOpen from 'lucide-static/icons/book-open.svg?raw';
import bot from 'lucide-static/icons/bot.svg?raw';
import brain from 'lucide-static/icons/brain.svg?raw';
import calendar from 'lucide-static/icons/calendar.svg?raw';
import check from 'lucide-static/icons/check.svg?raw';
import checkCircle from 'lucide-static/icons/check-circle.svg?raw';
import checkCircle2 from 'lucide-static/icons/check-circle-2.svg?raw';
import chevronDown from 'lucide-static/icons/chevron-down.svg?raw';
