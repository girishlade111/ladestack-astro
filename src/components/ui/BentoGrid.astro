---
export interface Props {
  class?: string;
  cols?: 2 | 3 | 4;
}

const {
  class: className = '',
  cols = 3,
} = Astro.props;

const colStyles = {
  2: 'grid-cols-1 md:grid-cols-2',
  3: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4',
};
---

<div class={`grid gap-5 sm:gap-6 ${colStyles[cols]} ${className}`.trim()}>
  <slot />
</div>
