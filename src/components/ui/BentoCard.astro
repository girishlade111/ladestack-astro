---
export interface Props {
  title: string;
  description: string;
  class?: string;
  href?: string;
  colSpan?: string;
  badge?: string;
}

const {
  title,
  description,
  class: className = '',
  href,
  colSpan = 'col-span-1',
  badge,
} = Astro.props;

const Component = href ? 'a' : 'div';
---

<Component
  href={href}
  target={href?.startsWith('http') ? '_blank' : undefined}
  rel={href?.startsWith('http') ? 'noopener noreferrer' : undefined}
  class={`group relative overflow-hidden rounded-xl border border-border bg-surface p-6 sm:p-7 flex flex-col justify-between transition-all duration-200 hover:border-brand/40 hover:shadow-card hover:-translate-y-0.5 ${colSpan} ${className}`.trim()}
>
  <div class="relative z-10">
    <div class="flex items-center justify-between gap-4 mb-4">
      <div class="flex items-center gap-2">
        <slot name="icon" />
      </div>
      {badge && (
        <span class="inline-flex items-center text-[11px] font-medium px-2 py-0.5 rounded-full bg-brand/10 text-brand border border-brand/20">
          {badge}
        </span>
      )}
    </div>

    <h3 class="text-lg sm:text-xl font-semibold tracking-tight text-foreground group-hover:text-brand transition-colors">
      {title}
    </h3>
    <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
      {description}
    </p>
  </div>

  <div class="mt-6 pt-4 border-t border-border/40 relative z-10">
    <slot name="visual" />
    <slot />
  </div>

  {/* Subtle hover gradient bloom behind the card content */}
  <div
    class="pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 -z-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_0%,_hsl(var(--brand)/0.06),_transparent_70%)]"
    aria-hidden="true"
  ></div>
</Component>
