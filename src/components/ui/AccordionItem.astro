---
import Icon from '../Icon.astro';

export interface Props {
  question: string;
  open?: boolean;
  class?: string;
}

const { question, open = false, class: className = '' } = Astro.props;
---

<details
  class={`accordion-item group p-5 sm:p-6 transition-colors duration-200 hover:bg-surface-muted/40 ${className}`.trim()}
  open={open}
  data-state={open ? 'open' : 'closed'}
>
  <summary class="accordion-trigger flex w-full items-center justify-between gap-4 text-left font-medium text-foreground cursor-pointer list-none select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 rounded-md">
    <span class="text-base sm:text-lg tracking-tight font-medium text-foreground group-hover:text-foreground">
      {question}
    </span>
    <span class="accordion-chevron flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-border bg-surface/50 text-muted-foreground group-hover:text-foreground group-hover:border-border transition-all duration-300">
      <Icon name="chevron-down" class="h-4 w-4" />
    </span>
  </summary>
  <div class="accordion-content grid">
    <div class="accordion-inner overflow-hidden">
      <div class="pt-3.5 text-sm sm:text-base text-muted-foreground leading-relaxed text-pretty pr-6">
        <slot />
      </div>
    </div>
  </div>
</details>

<style>
  /* Hide native summary marker */
  .accordion-trigger::-webkit-details-marker {
    display: none;
  }
  .accordion-trigger::marker {
    display: none;
    content: "";
  }

  /* Smooth grid-template-rows expansion */
  .accordion-content {
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 300ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 240ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: grid-template-rows, opacity;
  }

  /* Open state */
  details.accordion-item[data-state="open"] > .accordion-content,
  details.accordion-item[open]:not([data-state="closed"]):not([data-state="closing"]) > .accordion-content {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  /* Closed and closing states */
  details.accordion-item[data-state="closed"] > .accordion-content,
  details.accordion-item[data-state="closing"] > .accordion-content {
    grid-template-rows: 0fr;
    opacity: 0;
  }

  /* Smooth chevron rotation */
  .accordion-chevron {
    transition:
      transform 300ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 200ms ease,
      background-color 200ms ease,
      color 200ms ease;
    will-change: transform;
  }

  details.accordion-item[data-state="open"] .accordion-chevron,
  details.accordion-item[open]:not([data-state="closed"]):not([data-state="closing"]) .accordion-chevron {
    transform: rotate(180deg);
  }

  details.accordion-item[data-state="closed"] .accordion-chevron,
  details.accordion-item[data-state="closing"] .accordion-chevron {
    transform: rotate(0deg);
  }

  .accordion-inner {
    min-height: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion-content,
    .accordion-chevron {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  function setupAccordions() {
    const items = document.querySelectorAll<HTMLDetailsElement>('details.accordion-item');

    items.forEach((details) => {
      if (details.dataset.accordionInit === 'true') return;
      details.dataset.accordionInit = 'true';

      const summary = details.querySelector<HTMLElement>('.accordion-trigger');
      const content = details.querySelector<HTMLElement>('.accordion-content');
      if (!summary || !content) return;

      // Sync initial state with server-rendered open attribute
      if (details.open) {
        details.setAttribute('data-state', 'open');
      } else {
        details.setAttribute('data-state', 'closed');
      }

      let timer: number | null = null;

      summary.addEventListener('click', (e) => {
        e.preventDefault();

        const state = details.getAttribute('data-state');

        if (state === 'open') {
          // Collapse smoothly
          if (timer) clearTimeout(timer);
          details.setAttribute('data-state', 'closing');

          const handleTransitionEnd = (ev: TransitionEvent) => {
            if (ev.propertyName === 'grid-template-rows' && details.getAttribute('data-state') === 'closing') {
              content.removeEventListener('transitionend', handleTransitionEnd);
              if (timer) clearTimeout(timer);
              details.removeAttribute('open');
              details.setAttribute('data-state', 'closed');
            }
          };

          content.addEventListener('transitionend', handleTransitionEnd);

          timer = window.setTimeout(() => {
            content.removeEventListener('transitionend', handleTransitionEnd);
            if (details.getAttribute('data-state') === 'closing') {
              details.removeAttribute('open');
              details.setAttribute('data-state', 'closed');
            }
          }, 350);
        } else {
          // Expand smoothly
          if (timer) {
            clearTimeout(timer);
            timer = null;
          }

          if (!details.open) {
            details.setAttribute('open', '');
            details.setAttribute('data-state', 'closed');
            void content.offsetHeight; // Force reflow
          }

          requestAnimationFrame(() => {
            details.setAttribute('data-state', 'open');
          });
        }
      });
    });
  }

  // Run on initial load and on Astro view transition / client navigation
  if (typeof document !== 'undefined') {
    setupAccordions();
    document.addEventListener('astro:page-load', setupAccordions);
  }
</script>
