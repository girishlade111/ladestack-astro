---
import Icon from '../Icon.astro';

export interface Props {
  question: string;
  open?: boolean;
  class?: string;
}

const { question, open = false, class: className = '' } = Astro.props;
---

<details class={`group p-5 sm:p-6 transition-colors hover:bg-surface-muted/40 ${className}`.trim()} open={open}>
  <summary class="flex w-full items-center justify-between gap-4 text-left font-medium text-foreground cursor-pointer list-none select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 rounded-md">
    <span class="text-base sm:text-lg tracking-tight font-medium">
      {question}
    </span>
    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-border text-muted-foreground group-hover:text-foreground transition-transform duration-200 group-open:rotate-180">
      <Icon name="chevron-down" class="h-4 w-4" />
    </span>
  </summary>
  <div class="mt-3.5 text-sm sm:text-base text-muted-foreground leading-relaxed text-pretty pr-6">
    <slot />
  </div>
</details>
