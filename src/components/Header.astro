---
/**
 * Header.astro
 * Streamlined technical header with tokens only, language switcher,
 * search trigger (Cmd+K), theme toggle, and accessible mobile sheet.
 */
import Icon from './Icon.astro';
import Button from './ui/Button.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import AnimatedThemeToggler from './ui/animated-theme-toggler.astro';
import AnimatedShinyText from './ui/animated-shiny-text.astro';
import { DEFAULT_LOCALE, isValidLocale, type Locale } from '../i18n/config';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

export interface Props {
  currentLang?: string;
  locale?: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
}

const { currentLang, locale, alternateUrls } = Astro.props;
const activeLocale: Locale =
  locale ?? (isValidLocale(currentLang) ? currentLang : DEFAULT_LOCALE);

const t = useTranslations(activeLocale);
const homeHref = getLocalizedPath('/', activeLocale);

const navLinks = [
  { label: t('nav.apps'), href: getLocalizedPath('/apps', activeLocale) },
  { label: 'GB Coder', href: getLocalizedPath('/gb-coder', activeLocale) },
  { label: t('nav.docs'), href: getLocalizedPath('/docs', activeLocale) },
  { label: t('nav.blog'), href: getLocalizedPath('/blog', activeLocale) },
  { label: t('nav.about'), href: getLocalizedPath('/about', activeLocale) },
];
---

<header
  data-site-header
  class="sticky top-0 z-40 w-full transition-colors duration-200 border-b border-border/60 bg-background/80 backdrop-blur-md"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-6 lg:px-8 h-16">
    {/* ── LEFT: Logo ── */}
    <a href={homeHref} class="flex items-center gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-lg p-1">
      <div class="w-8 h-8 rounded-lg bg-brand flex items-center justify-center text-brand-foreground shadow-soft transition-transform group-hover:scale-105">
        <Icon name="code-2" class="w-4 h-4" />
      </div>
      <div class="flex flex-col">
        <span class="text-base font-semibold tracking-tight text-foreground leading-none">
          LadeStack
        </span>
        <span class="text-[10px] font-mono text-muted-foreground leading-none mt-1">
          v1.0 Developer Suite
        </span>
      </div>
    </a>

    {/* ── CENTER: Nav Links (desktop) ── */}
    <nav class="hidden md:flex items-center gap-1" aria-label="Primary navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3.5 py-1.5 text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-surface-muted rounded-md transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    {/* ── RIGHT: Actions & Controls ── */}
    <div class="flex items-center gap-2">
      {/* Search Trigger */}
      <button
        type="button"
        data-search-open
        aria-label={`${t('nav.quickJump')} (Press Command K)`}
        class="hidden sm:inline-flex items-center gap-2 h-9 px-3 text-xs text-muted-foreground bg-surface-muted/60 border border-border rounded-lg hover:bg-surface-muted hover:text-foreground transition-colors"
      >
        <Icon name="search" class="w-3.5 h-3.5" />
        <span class="hidden lg:inline">{t('nav.quickJump')}...</span>
        <kbd class="hidden lg:inline-flex items-center gap-0.5 ml-2 px-1.5 py-0.5 text-[10px] font-mono text-muted-foreground bg-surface rounded border border-border">
          ⌘K
        </kbd>
      </button>

      <button
        type="button"
        data-search-open
        class="sm:hidden p-2 text-muted-foreground hover:text-foreground rounded-lg"
        aria-label={t('nav.quickJump')}
      >
        <Icon name="search" class="w-4 h-4" />
      </button>

      {/* Language Switcher */}
      <LanguageSwitcher currentLocale={activeLocale} alternateUrls={alternateUrls} />

      {/* Theme Toggle */}
      <AnimatedThemeToggler variant="circle" duration={400} aria-label={t('nav.themeToggle')} />

      {/* Primary CTA */}
      <Button href="https://code.ladestack.in/" target="_blank" size="sm" class="hidden sm:inline-flex">
        <AnimatedShinyText>Start Free</AnimatedShinyText>
      </Button>

      {/* Mobile Menu Trigger */}
      <button
        type="button"
        data-menu-open
        class="md:hidden p-2 text-foreground hover:bg-surface-muted rounded-lg"
        aria-label={t('nav.openMenu')}
        aria-expanded="false"
      >
        <Icon name="menu" class="w-5 h-5" />
      </button>
    </div>
  </div>
</header>

{/* ── Mobile sheet ── */}
<div data-mobile-sheet class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
  <div data-sheet-backdrop class="absolute inset-0 bg-background/80 backdrop-blur-sm"></div>
  <div class="absolute left-0 top-0 bottom-0 w-[300px] bg-surface border-r border-border p-6 flex flex-col justify-between shadow-elevated">
    <div>
      <div class="flex items-center justify-between pb-6 border-b border-border">
        <a href={homeHref} class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-brand flex items-center justify-center text-brand-foreground">
            <Icon name="code-2" class="w-4 h-4" />
          </div>
          <span class="text-base font-semibold text-foreground">LadeStack</span>
        </a>
        <button
          type="button"
          data-menu-close
          class="p-2 text-muted-foreground hover:text-foreground rounded-lg"
          aria-label={t('nav.closeMenu')}
        >
          <Icon name="x" class="w-5 h-5" />
        </button>
      </div>

      <nav class="flex flex-col gap-1.5 mt-6" aria-label="Mobile Navigation Links">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="flex items-center justify-between px-3.5 py-2.5 text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-surface-muted rounded-lg transition-colors"
            >
              <span>{link.label}</span>
              <Icon name="chevron-right" class="w-4 h-4 text-border" />
            </a>
          ))
        }
        <a
          href={getLocalizedPath('/contact', activeLocale)}
          class="flex items-center justify-between px-3.5 py-2.5 text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-surface-muted rounded-lg transition-colors"
        >
          <span>{t('nav.contact')}</span>
          <Icon name="chevron-right" class="w-4 h-4 text-border" />
        </a>
      </nav>

      {/* Mobile Language Selector */}
      <div class="mt-6 pt-6 border-t border-border">
        <p class="text-xs font-mono text-muted-foreground uppercase tracking-wider mb-2">
          {t('nav.languageSelect')}
        </p>
        <LanguageSwitcher currentLocale={activeLocale} alternateUrls={alternateUrls} class="w-full" />
      </div>
    </div>

    <div class="pt-6 border-t border-border flex flex-col gap-3">
      <Button href="https://code.ladestack.in/" target="_blank" size="md" class="w-full justify-center">
        <AnimatedShinyText>Launch Studio</AnimatedShinyText>
      </Button>
      <p class="text-[11px] text-center text-muted-foreground">
        Free forever · Zero cloud telemetry
      </p>
    </div>
  </div>
</div>

{/* ── Search overlay ── */}
<div data-search-overlay class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-label="Quick search">
  <div data-search-backdrop class="absolute inset-0 bg-background/80 backdrop-blur-sm"></div>
  <div class="absolute left-1/2 top-20 -translate-x-1/2 w-[calc(100%-2rem)] max-w-lg rounded-xl border border-border bg-surface p-4 shadow-elevated">
    <div class="flex items-center gap-2.5 pb-3 border-b border-border">
      <Icon name="search" class="w-4 h-4 text-muted-foreground" />
      <span class="text-sm font-medium text-foreground">Quick Jump</span>
      <button type="button" data-search-close class="ml-auto p-1.5 text-muted-foreground hover:text-foreground rounded" aria-label="Close search">
        <Icon name="x" class="w-4 h-4" />
      </button>
    </div>
    <div class="mt-3 grid gap-1">
      <a href={getLocalizedPath('/apps', activeLocale)} class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm text-foreground hover:bg-surface-muted transition-colors">
        <div class="flex items-center gap-2.5">
          <Icon name="layers" class="w-4 h-4 text-brand" />
          <span>Apps & Tools Gallery</span>
        </div>
        <span class="text-xs text-muted-foreground font-mono">{getLocalizedPath('/apps', activeLocale)}</span>
      </a>
      <a href={getLocalizedPath('/gb-coder', activeLocale)} class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm text-foreground hover:bg-surface-muted transition-colors">
        <div class="flex items-center gap-2.5">
          <Icon name="code-2" class="w-4 h-4 text-brand" />
          <span>GB Coder</span>
        </div>
        <span class="text-xs text-muted-foreground font-mono">{getLocalizedPath('/gb-coder', activeLocale)}</span>
      </a>
      <a href={getLocalizedPath('/blog', activeLocale)} class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm text-foreground hover:bg-surface-muted transition-colors">
        <div class="flex items-center gap-2.5">
          <Icon name="file-text" class="w-4 h-4 text-brand" />
          <span>Engineering Blog</span>
        </div>
        <span class="text-xs text-muted-foreground font-mono">{getLocalizedPath('/blog', activeLocale)}</span>
      </a>
      <a href={getLocalizedPath('/docs', activeLocale)} class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm text-foreground hover:bg-surface-muted transition-colors">
        <div class="flex items-center gap-2.5">
          <Icon name="book-open" class="w-4 h-4 text-brand" />
          <span>Documentation & Guides</span>
        </div>
        <span class="text-xs text-muted-foreground font-mono">{getLocalizedPath('/docs', activeLocale)}</span>
      </a>
      <a href={getLocalizedPath('/sitemap', activeLocale)} class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm text-foreground hover:bg-surface-muted transition-colors">
        <div class="flex items-center gap-2.5">
          <Icon name="map-pin" class="w-4 h-4 text-brand" />
          <span>Index & Sitemap</span>
        </div>
        <span class="text-xs text-muted-foreground font-mono">{getLocalizedPath('/sitemap', activeLocale)}</span>
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var lastFocusedTrigger = null;

    function trapFocus(container, e) {
      if (e.key !== 'Tab') return;
      var focusables = container.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])');
      if (!focusables.length) return;
      var first = focusables[0];
      var last = focusables[focusables.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    // Mobile sheet
    var sheet = document.querySelector('[data-mobile-sheet]');
    var menuOpenBtn = document.querySelector('[data-menu-open]');
    var openSheet = function () {
      if (sheet) {
        lastFocusedTrigger = document.activeElement;
        sheet.classList.remove('hidden');
        if (menuOpenBtn) menuOpenBtn.setAttribute('aria-expanded', 'true');
        var closeBtn = sheet.querySelector('[data-menu-close]');
        if (closeBtn) closeBtn.focus();
      }
    };
    var closeSheet = function () {
      if (sheet && !sheet.classList.contains('hidden')) {
        sheet.classList.add('hidden');
        if (menuOpenBtn) menuOpenBtn.setAttribute('aria-expanded', 'false');
        if (lastFocusedTrigger && typeof lastFocusedTrigger.focus === 'function') {
          lastFocusedTrigger.focus();
        }
      }
    };

    if (menuOpenBtn) menuOpenBtn.addEventListener('click', openSheet);
    document.querySelectorAll('[data-menu-close]').forEach(function (b) {
      b.addEventListener('click', closeSheet);
    });
    var backdrop = sheet && sheet.querySelector('[data-sheet-backdrop]');
    if (backdrop) backdrop.addEventListener('click', closeSheet);

    if (sheet) {
      sheet.addEventListener('keydown', function (e) {
        trapFocus(sheet, e);
      });
    }

    // Search overlay (+ Cmd/Ctrl+K)
    var overlay = document.querySelector('[data-search-overlay]');
    var openSearch = function () {
      if (overlay) {
        lastFocusedTrigger = document.activeElement;
        overlay.classList.remove('hidden');
        var firstLink = overlay.querySelector('a, button');
        if (firstLink) firstLink.focus();
      }
    };
    var closeSearch = function () {
      if (overlay && !overlay.classList.contains('hidden')) {
        overlay.classList.add('hidden');
        if (lastFocusedTrigger && typeof lastFocusedTrigger.focus === 'function') {
          lastFocusedTrigger.focus();
        }
      }
    };

    document.querySelectorAll('[data-search-open]').forEach(function (b) {
      b.addEventListener('click', openSearch);
    });
    document.querySelectorAll('[data-search-close]').forEach(function (b) {
      b.addEventListener('click', closeSearch);
    });
    var sBackdrop = overlay && overlay.querySelector('[data-search-backdrop]');
    if (sBackdrop) sBackdrop.addEventListener('click', closeSearch);

    if (overlay) {
      overlay.addEventListener('keydown', function (e) {
        trapFocus(overlay, e);
      });
    }

    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (overlay) {
          overlay.classList.contains('hidden') ? openSearch() : closeSearch();
        }
      }
      if (e.key === 'Escape') {
        closeSearch();
        closeSheet();
      }
    });
  })();
</script>
