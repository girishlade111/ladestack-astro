---
/**
 * Header.astro
 * Streamlined technical header with tokens only, language switcher,
 * search trigger (Cmd+K), theme toggle, and accessible mobile sheet.
 */
import Icon from './Icon.astro';
import LanguageSwitcher from './ui/LanguageSwitcher.astro';
import Button from './ui/Button.astro';

export interface Props {
  currentLang?: string;
}

const { currentLang = 'en' } = Astro.props;

const navLinks = [
  { label: 'Platform', href: '/apps' },
  { label: 'Code Studio', href: '/ai-code-viewer-ai' },
  { label: 'Docs', href: '/docs' },
  { label: 'Blog', href: '/blog' },
  { label: 'About', href: '/about' },
];
---

<header
  data-site-header
  class="sticky top-0 z-40 w-full transition-colors duration-200 border-b border-border/60 bg-background/80 backdrop-blur-md"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-6 lg:px-8 h-16">
    {/* ── LEFT: Logo ── */}
    <a href="/" class="flex items-center gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-lg p-1">
      <div class="w-8 h-8 rounded-lg bg-brand flex items-center justify-center text-brand-foreground shadow-soft transition-transform group-hover:scale-105">
        <Icon name="code-2" class="w-4 h-4" />
      </div>
      <div class="flex flex-col">
        <span class="text-base font-semibold tracking-tight text-foreground leading-none">
          Lade Stack
        </span>
        <span class="text-[10px] font-mono text-muted-foreground leading-none mt-1">
          v1.0 Developer Suite
        </span>
      </div>
    </a>

    {/* ── CENTER: Nav Links (desktop) ── */}
    <nav class="hidden md:flex items-center gap-1" aria-label="Primary navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3.5 py-1.5 text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-surface-muted rounded-md transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    {/* ── RIGHT: Actions & Controls ── */}
    <div class="flex items-center gap-2">
      {/* Search Trigger */}
      <button
        type="button"
        data-search-open
        aria-label="Search site (Press Command K)"
        class="hidden sm:inline-flex items-center gap-2 h-9 px-3 text-xs text-muted-foreground bg-surface-muted/60 border border-border rounded-lg hover:bg-surface-muted hover:text-foreground transition-colors"
      >
        <Icon name="search" class="w-3.5 h-3.5" />
        <span class="hidden lg:inline">Search...</span>
        <kbd class="hidden lg:inline-flex items-center gap-0.5 ml-2 px-1.5 py-0.5 text-[10px] font-mono text-muted-foreground bg-surface rounded border border-border">
          ⌘K
        </kbd>
      </button>

      <button
        type="button"
        data-search-open
        class="sm:hidden p-2 text-muted-foreground hover:text-foreground rounded-lg"
        aria-label="Search"
      >
        <Icon name="search" class="w-4 h-4" />
      </button>

      {/* Language Switcher */}
      <LanguageSwitcher currentLang={currentLang} />

      {/* Theme Toggle */}
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle color theme"
        class="p-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-surface-muted transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
      >
        <span class="dark:hidden"><Icon name="moon" class="w-4 h-4" /></span>
        <span class="hidden dark:inline"><Icon name="sun" class="w-4 h-4" /></span>
      </button>

      {/* Primary CTA */}
      <Button href="https://code.ladestack.in/" target="_blank" size="sm" class="hidden sm:inline-flex">
        <span>Start Free</span>
        <Icon name="arrow-up-right" class="w-3.5 h-3.5" />
      </Button>

      {/* Mobile Menu Trigger */}
      <button
        type="button"
        data-menu-open
        class="md:hidden p-2 text-foreground hover:bg-surface-muted rounded-lg"
        aria-label="Open mobile menu"
        aria-expanded="false"
      >
        <Icon name="menu" class="w-5 h-5" />
      </button>
    </div>
  </div>
</header>

{/* ── Mobile sheet ── */}
<div data-mobile-sheet class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
  <div data-sheet-backdrop class="absolute inset-0 bg-background/80 backdrop-blur-sm"></div>
  <div class="absolute left-0 top-0 bottom-0 w-[300px] bg-surface border-r border-border p-6 flex flex-col justify-between shadow-elevated">
    <div>
      <div class="flex items-center justify-between pb-6 border-b border-border">
        <a href="/" class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-brand flex items-center justify-center text-brand-foreground">
            <Icon name="code-2" class="w-4 h-4" />
          </div>
          <span class="text-base font-semibold text-foreground">Lade Stack</span>
        </a>
        <button
          type="button"
          data-menu-close
          class="p-2 text-muted-foreground hover:text-foreground rounded-lg"
          aria-label="Close menu"
        >
          <Icon name="x" class="w-5 h-5" />
        </button>
      </div>

      <nav class="flex flex-col gap-1.5 mt-6" aria-label="Mobile Navigation Links">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="flex items-center justify-between px-3.5 py-2.5 text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-surface-muted rounded-lg transition-colors"
            >
              <span>{link.label}</span>
              <Icon name="chevron-right" class="w-4 h-4 text-border" />
            </a>
          ))
        }
        <a
          href="/contact"
          class="flex items-center justify-between px-3.5 py-2.5 text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-surface-muted rounded-lg transition-colors"
        >
          <span>Contact</span>
          <Icon name="chevron-right" class="w-4 h-4 text-border" />
        </a>
      </nav>
    </div>

    <div class="pt-6 border-t border-border flex flex-col gap-3">
      <Button href="https://code.ladestack.in/" target="_blank" size="md" class="w-full justify-center">
        <span>Launch Studio</span>
        <Icon name="arrow-up-right" class="w-4 h-4" />
      </Button>
      <p class="text-[11px] text-center text-muted-foreground">
        Free forever · Zero cloud telemetry
      </p>
    </div>
  </div>
</div>

{/* ── Search overlay ── */}
<div data-search-overlay class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-label="Quick search">
  <div data-search-backdrop class="absolute inset-0 bg-background/80 backdrop-blur-sm"></div>
  <div class="absolute left-1/2 top-20 -translate-x-1/2 w-[calc(100%-2rem)] max-w-lg rounded-xl border border-border bg-surface p-4 shadow-elevated">
    <div class="flex items-center gap-2.5 pb-3 border-b border-border">
      <Icon name="search" class="w-4 h-4 text-muted-foreground" />
      <span class="text-sm font-medium text-foreground">Quick Jump</span>
      <button type="button" data-search-close class="ml-auto p-1.5 text-muted-foreground hover:text-foreground rounded" aria-label="Close search">
        <Icon name="x" class="w-4 h-4" />
      </button>
    </div>
    <div class="mt-3 grid gap-1">
      <a href="/apps" class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm text-foreground hover:bg-surface-muted transition-colors">
        <div class="flex items-center gap-2.5">
          <Icon name="layers" class="w-4 h-4 text-brand" />
          <span>Apps & Tools Gallery</span>
        </div>
        <span class="text-xs text-muted-foreground font-mono">/apps</span>
      </a>
      <a href="/ai-code-viewer-ai" class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm text-foreground hover:bg-surface-muted transition-colors">
        <div class="flex items-center gap-2.5">
          <Icon name="code-2" class="w-4 h-4 text-brand" />
          <span>AI Code Studio</span>
        </div>
        <span class="text-xs text-muted-foreground font-mono">/code</span>
      </a>
      <a href="/blog" class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm text-foreground hover:bg-surface-muted transition-colors">
        <div class="flex items-center gap-2.5">
          <Icon name="file-text" class="w-4 h-4 text-brand" />
          <span>Engineering Blog</span>
        </div>
        <span class="text-xs text-muted-foreground font-mono">/blog</span>
      </a>
      <a href="/docs" class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm text-foreground hover:bg-surface-muted transition-colors">
        <div class="flex items-center gap-2.5">
          <Icon name="book-open" class="w-4 h-4 text-brand" />
          <span>Documentation & Guides</span>
        </div>
        <span class="text-xs text-muted-foreground font-mono">/docs</span>
      </a>
      <a href="/sitemap" class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm text-foreground hover:bg-surface-muted transition-colors">
        <div class="flex items-center gap-2.5">
          <Icon name="map-pin" class="w-4 h-4 text-brand" />
          <span>Index & Sitemap</span>
        </div>
        <span class="text-xs text-muted-foreground font-mono">/sitemap</span>
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    // Mobile sheet
    var sheet = document.querySelector('[data-mobile-sheet]');
    var menuOpenBtn = document.querySelector('[data-menu-open]');
    if (menuOpenBtn && sheet) {
      menuOpenBtn.addEventListener('click', function () {
        sheet.classList.remove('hidden');
        menuOpenBtn.setAttribute('aria-expanded', 'true');
      });
    }
    var closeSheet = function () {
      if (sheet) {
        sheet.classList.add('hidden');
        if (menuOpenBtn) menuOpenBtn.setAttribute('aria-expanded', 'false');
      }
    };
    document.querySelectorAll('[data-menu-close]').forEach(function (b) {
      b.addEventListener('click', closeSheet);
    });
    var backdrop = sheet && sheet.querySelector('[data-sheet-backdrop]');
    if (backdrop) backdrop.addEventListener('click', closeSheet);

    // Search overlay (+ Cmd/Ctrl+K)
    var overlay = document.querySelector('[data-search-overlay]');
    var openSearch = function () { overlay && overlay.classList.remove('hidden'); };
    var closeSearch = function () { overlay && overlay.classList.add('hidden'); };
    document.querySelectorAll('[data-search-open]').forEach(function (b) {
      b.addEventListener('click', openSearch);
    });
    document.querySelectorAll('[data-search-close]').forEach(function (b) {
      b.addEventListener('click', closeSearch);
    });
    var sBackdrop = overlay && overlay.querySelector('[data-search-backdrop]');
    if (sBackdrop) sBackdrop.addEventListener('click', closeSearch);

    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (overlay) {
          overlay.classList.contains('hidden') ? openSearch() : closeSearch();
        }
      }
      if (e.key === 'Escape') {
        closeSearch();
        closeSheet();
      }
    });
  })();
</script>
