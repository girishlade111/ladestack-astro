---
/**
 * Header.astro — 1:1 port of the source Header.tsx.
 * Same layout, classes, nav links, search entry, theme toggle, CTA and
 * mobile sheet. Scroll-aware styling + sheet/search toggles run as tiny
 * inline scripts (no framework) — the `dark:` variants activate via the
 * layout's theme guard (default light, like the source).
 */
import Icon from './Icon.astro';

const navLinks = [
  { label: 'Home', href: '/', icon: 'home' },
  { label: 'About', href: '/about', icon: 'user' },
  { label: 'Products', href: '/apps', icon: 'layers' },
  { label: 'Blog', href: '/blog', icon: 'file-text' },
  { label: 'Contact', href: '/contact', icon: 'mail' },
];
---

<div
  data-header-sentinel
  aria-hidden="true"
  style="position: absolute; top: 20px; left: 0; width: 1px; height: 1px; pointer-events: none;"
>
</div>

<header
  data-site-header
  class="sticky top-0 z-50 w-full transition-all duration-300 bg-[#F5F3EB] dark:bg-[#1e1c18]"
  style="animation: header-slide-in 0.5s ease-out both;"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between px-6 h-16">
    {/* ── LEFT: Logo ── */}
    <a href="/" class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-[#6E8F6A] flex items-center justify-center">
        <span class="text-xs font-mono font-bold text-white">{'</>'}</span>
      </div>
      <span class="text-base font-semibold text-[#1C1C1C] dark:text-[#E8E4DA] tracking-tight">
        Lade Stack
      </span>
    </a>

    {/* ── CENTER: Nav Links (desktop) ── */}
    <nav class="hidden md:flex items-center gap-1" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="px-4 py-2 text-sm font-medium text-[#555] dark:text-[#999] hover:text-[#1C1C1C] dark:hover:text-[#E8E4DA] transition-colors duration-200 rounded-lg hover:bg-black/[0.03] dark:hover:bg-white/[0.04]"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    {/* ── RIGHT: Actions ── */}
    <div class="flex items-center gap-2">
      <button
        type="button"
        data-search-open
        class="hidden sm:inline-flex items-center gap-2 h-9 px-3 text-sm text-[#777] dark:text-[#999] bg-white/60 dark:bg-white/[0.04] border border-[#E6E6E6] dark:border-white/10 rounded-lg hover:bg-white/80 dark:hover:bg-white/[0.06] transition-colors"
      >
        <Icon name="search" class="w-4 h-4" />
        <span class="hidden lg:inline">Search...</span>
        <kbd class="hidden lg:inline-flex items-center gap-0.5 ml-2 px-1.5 py-0.5 text-[10px] font-mono text-[#999] dark:text-[#666] bg-[#F0F0F0] dark:bg-white/[0.06] rounded border border-[#E0E0E0] dark:border-white/10">
          ⌘K
        </kbd>
      </button>

      <button
        type="button"
        data-search-open
        class="sm:hidden p-2 text-[#555] dark:text-[#999]"
        aria-label="Search"
      >
        <Icon name="search" class="w-5 h-5" />
      </button>

      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle theme"
        class="p-2 rounded-lg text-[#555] dark:text-[#999] hover:bg-black/[0.03] dark:hover:bg-white/[0.04] transition-colors"
      >
        <span class="dark:hidden"><Icon name="moon" class="w-5 h-5" /></span>
        <span class="hidden dark:inline"><Icon name="sun" class="w-5 h-5" /></span>
      </button>

      <a href="/apps" class="hidden md:block">
        <span class="inline-flex items-center h-9 px-5 text-sm font-medium bg-[#6E8F6A] text-white rounded-lg hover:bg-[#5F7F63] transition-all duration-200 hover:-translate-y-px active:scale-[0.98]">
          Get Started
        </span>
      </a>

      <button
        type="button"
        data-menu-open
        class="md:hidden p-2 text-[#1C1C1C] dark:text-[#E8E4DA]"
        aria-label="Open menu"
      >
        <Icon name="menu" class="w-5 h-5" />
      </button>
    </div>
  </div>
</header>

{/* ── Mobile sheet ── */}
<div data-mobile-sheet class="fixed inset-0 z-[60] hidden">
  <div data-sheet-backdrop class="absolute inset-0 bg-black/40"></div>
  <div class="absolute left-0 top-0 bottom-0 w-[280px] bg-[#F5F3EB] dark:bg-[#1e1c18] border-r border-[#E6E6E6] dark:border-white/10 p-5 flex flex-col">
    <div class="flex items-center gap-2.5 mb-2">
      <div class="w-7 h-7 rounded-lg bg-[#6E8F6A] flex items-center justify-center">
        <span class="text-[10px] font-mono font-bold text-white">{'</>'}</span>
      </div>
      <span class="text-base font-semibold text-[#1C1C1C] dark:text-[#E8E4DA]">Lade Stack</span>
      <button type="button" data-menu-close class="ml-auto p-2 text-[#555] dark:text-[#999]" aria-label="Close menu">
        <Icon name="x" class="w-5 h-5" />
      </button>
    </div>
    <nav class="flex flex-col gap-1 mt-6" aria-label="Mobile">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="flex items-center gap-3 px-3 py-3 text-sm font-medium text-[#1C1C1C] dark:text-[#E8E4DA] hover:text-[#6E8F6A] hover:bg-[#E7EDD8]/50 dark:hover:bg-[#6E8F6A]/10 rounded-lg transition-colors"
          >
            <Icon name={link.icon} class="w-4 h-4" />
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-6 pt-6 border-t border-[#E6E6E6] dark:border-white/10 flex flex-col gap-3">
      <a href="/apps" class="inline-flex items-center justify-center w-full h-10 text-sm font-medium bg-[#6E8F6A] text-white rounded-lg hover:bg-[#5F7F63] transition-colors">
        Get Started
      </a>
    </div>
  </div>
</div>

{/* ── Search overlay ── */}
<div data-search-overlay class="fixed inset-0 z-[60] hidden">
  <div data-search-backdrop class="absolute inset-0 bg-black/40"></div>
  <div class="absolute left-1/2 top-24 -translate-x-1/2 w-[calc(100%-2rem)] max-w-lg rounded-2xl border border-[#E6E6E6] dark:border-white/10 bg-[#F5F3EB] dark:bg-[#1e1c18] p-4 shadow-2xl">
    <div class="flex items-center gap-2 px-2">
      <Icon name="search" class="w-4 h-4 text-[#999]" />
      <span class="text-sm font-semibold text-[#1C1C1C] dark:text-[#E8E4DA]">Quick links</span>
      <button type="button" data-search-close class="ml-auto p-1.5 text-[#777]" aria-label="Close search">
        <Icon name="x" class="w-4 h-4" />
      </button>
    </div>
    <div class="mt-3 grid gap-1">
      <a href="/apps" class="px-3 py-2.5 rounded-xl text-sm font-medium text-[#333] dark:text-[#ccc] hover:bg-black/[0.04] dark:hover:bg-white/[0.05]">Apps Gallery</a>
      <a href="/blog" class="px-3 py-2.5 rounded-xl text-sm font-medium text-[#333] dark:text-[#ccc] hover:bg-black/[0.04] dark:hover:bg-white/[0.05]">Blog</a>
      <a href="/docs" class="px-3 py-2.5 rounded-xl text-sm font-medium text-[#333] dark:text-[#ccc] hover:bg-black/[0.04] dark:hover:bg-white/[0.05]">Documentation</a>
      <a href="/support" class="px-3 py-2.5 rounded-xl text-sm font-medium text-[#333] dark:text-[#ccc] hover:bg-black/[0.04] dark:hover:bg-white/[0.05]">Support</a>
      <a href="/contact" class="px-3 py-2.5 rounded-xl text-sm font-medium text-[#333] dark:text-[#ccc] hover:bg-black/[0.04] dark:hover:bg-white/[0.05]">Contact</a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    // Scroll-aware header (mirrors the source IntersectionObserver sentinel)
    var header = document.querySelector('[data-site-header]');
    var sentinel = document.querySelector('[data-header-sentinel]');
    if (header && sentinel && 'IntersectionObserver' in window) {
      var apply = function (scrolled) {
        header.classList.toggle('border-b', scrolled);
        header.classList.toggle('border-[#E6E6E6]', scrolled);
        header.classList.toggle('dark:border-white/10', scrolled);
        header.classList.toggle('bg-[#F5F3EB]/85', scrolled);
        header.classList.toggle('dark:bg-[#1e1c18]/80', scrolled);
        header.classList.toggle('backdrop-blur-md', scrolled);
        header.classList.toggle('md:backdrop-blur-xl', scrolled);
        header.classList.toggle('bg-[#F5F3EB]', !scrolled);
        header.classList.toggle('dark:bg-[#1e1c18]', !scrolled);
      };
      new IntersectionObserver(function (entries) {
        apply(!entries[0].isIntersecting);
      }, { threshold: 0, rootMargin: '-20px 0px 0px 0px' }).observe(sentinel);
    }
    // Mobile sheet
    var sheet = document.querySelector('[data-mobile-sheet]');
    document.querySelectorAll('[data-menu-open]').forEach(function (b) {
      b.addEventListener('click', function () { sheet && sheet.classList.remove('hidden'); });
    });
    var closeSheet = function () { sheet && sheet.classList.add('hidden'); };
    document.querySelectorAll('[data-menu-close]').forEach(function (b) {
      b.addEventListener('click', closeSheet);
    });
    var backdrop = sheet && sheet.querySelector('[data-sheet-backdrop]');
    backdrop && backdrop.addEventListener('click', closeSheet);
    // Search overlay (+ Cmd/Ctrl+K)
    var overlay = document.querySelector('[data-search-overlay]');
    var openSearch = function () { overlay && overlay.classList.remove('hidden'); };
    var closeSearch = function () { overlay && overlay.classList.add('hidden'); };
    document.querySelectorAll('[data-search-open]').forEach(function (b) {
      b.addEventListener('click', openSearch);
    });
    document.querySelectorAll('[data-search-close]').forEach(function (b) {
      b.addEventListener('click', closeSearch);
    });
    var sBackdrop = overlay && overlay.querySelector('[data-search-backdrop]');
    sBackdrop && sBackdrop.addEventListener('click', closeSearch);
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        overlay && overlay.classList.contains('hidden') ? openSearch() : closeSearch();
      }
      if (e.key === 'Escape') { closeSearch(); closeSheet(); }
    });
  })();
</script>
