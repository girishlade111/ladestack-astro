---
/**
 * Header.astro
 * Streamlined technical header with tokens only, language switcher,
 * search trigger (Cmd+K), theme toggle, and accessible mobile sheet.
 */
import Icon from './Icon.astro';
import Button from './ui/Button.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import AnimatedThemeToggler from './ui/animated-theme-toggler.astro';
import AnimatedShinyText from './ui/animated-shiny-text.astro';
import { DEFAULT_LOCALE, isValidLocale, type Locale } from '../i18n/config';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

export interface Props {
  currentLang?: string;
  locale?: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
}

const { currentLang, locale, alternateUrls } = Astro.props;
const activeLocale: Locale =
  locale ?? (isValidLocale(currentLang) ? currentLang : DEFAULT_LOCALE);

const t = useTranslations(activeLocale);
const homeHref = getLocalizedPath('/', activeLocale);

const navLinks = [
  { label: t('nav.apps'), href: getLocalizedPath('/apps', activeLocale) },
  { label: 'GB Coder', href: getLocalizedPath('/gb-coder', activeLocale) },
  { label: t('nav.docs'), href: getLocalizedPath('/docs', activeLocale) },
  { label: t('nav.blog'), href: getLocalizedPath('/blog', activeLocale) },
  { label: t('nav.about'), href: getLocalizedPath('/about', activeLocale) },
];
---

<header
  data-site-header
  class="sticky top-0 z-40 w-full transition-colors duration-200 border-b border-border/60 bg-background/80 backdrop-blur-md"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-6 lg:px-8 h-16">
    {/* ── LEFT: Logo ── */}
    <a href={homeHref} class="flex items-center gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-lg p-1">
      <img
        src="/logo.png"
        alt="LadeStack Logo"
        class="w-8 h-8 object-contain transition-transform group-hover:scale-105"
        width="32"
        height="32"
        loading="eager"
        decoding="async"
      />
      <span class="text-base font-semibold tracking-tight text-foreground">
        LadeStack
      </span>
    </a>

    {/* ── CENTER: Nav Links (desktop) ── */}
    <nav class="hidden md:flex items-center gap-1" aria-label="Primary navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3.5 py-1.5 text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-surface-muted rounded-md transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    {/* ── RIGHT: Actions & Controls ── */}
    <div class="flex items-center gap-2">
      {/* Language Switcher */}
      <LanguageSwitcher currentLocale={activeLocale} alternateUrls={alternateUrls} />

      {/* Theme Toggle */}
      <AnimatedThemeToggler variant="circle" duration={750} aria-label={t('nav.themeToggle')} />

      {/* Primary CTA */}
      <Button href="https://code.ladestack.in/" target="_blank" size="sm" class="hidden sm:inline-flex">
        <AnimatedShinyText>Start Free</AnimatedShinyText>
      </Button>

      {/* Mobile Menu Trigger */}
      <button
        type="button"
        data-menu-open
        class="md:hidden p-2 text-foreground hover:bg-surface-muted rounded-lg"
        aria-label={t('nav.openMenu')}
        aria-expanded="false"
      >
        <Icon name="menu" class="w-5 h-5" />
      </button>
    </div>
  </div>
</header>

{/* ── Mobile sheet ── */}
<div data-mobile-sheet class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
  <div data-sheet-backdrop class="absolute inset-0 bg-background/80 backdrop-blur-sm"></div>
  <div class="absolute left-0 top-0 bottom-0 w-[300px] bg-surface border-r border-border p-6 flex flex-col justify-between shadow-elevated">
    <div>
      <div class="flex items-center justify-between pb-6 border-b border-border">
        <a href={homeHref} class="flex items-center gap-2">
          <img
            src="/logo.png"
            alt="LadeStack Logo"
            class="w-7 h-7 object-contain"
            width="28"
            height="28"
            loading="lazy"
            decoding="async"
          />
          <span class="text-base font-semibold text-foreground">LadeStack</span>
        </a>
        <button
          type="button"
          data-menu-close
          class="p-2 text-muted-foreground hover:text-foreground rounded-lg"
          aria-label={t('nav.closeMenu')}
        >
          <Icon name="x" class="w-5 h-5" />
        </button>
      </div>

      <nav class="flex flex-col gap-1.5 mt-6" aria-label="Mobile Navigation Links">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="flex items-center justify-between px-3.5 py-2.5 text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-surface-muted rounded-lg transition-colors"
            >
              <span>{link.label}</span>
              <Icon name="chevron-right" class="w-4 h-4 text-border" />
            </a>
          ))
        }
        <a
          href={getLocalizedPath('/contact', activeLocale)}
          class="flex items-center justify-between px-3.5 py-2.5 text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-surface-muted rounded-lg transition-colors"
        >
          <span>{t('nav.contact')}</span>
          <Icon name="chevron-right" class="w-4 h-4 text-border" />
        </a>
      </nav>

      {/* Mobile Language Selector */}
      <div class="mt-6 pt-6 border-t border-border">
        <p class="text-xs font-mono text-muted-foreground uppercase tracking-wider mb-2">
          {t('nav.languageSelect')}
        </p>
        <LanguageSwitcher currentLocale={activeLocale} alternateUrls={alternateUrls} class="w-full" />
      </div>

      {/* Mobile Theme Switcher */}
      <div class="mt-4 pt-4 border-t border-border flex items-center justify-between">
        <span class="text-xs font-mono text-muted-foreground uppercase tracking-wider">
          {t('nav.themeToggle')}
        </span>
        <AnimatedThemeToggler variant="circle" duration={750} aria-label={t('nav.themeToggle')} />
      </div>
    </div>

    <div class="pt-6 border-t border-border flex flex-col gap-3">
      <Button href="https://code.ladestack.in/" target="_blank" size="md" class="w-full justify-center">
        <AnimatedShinyText>Launch Studio</AnimatedShinyText>
      </Button>
      <p class="text-[11px] text-center text-muted-foreground">
        Free forever · Zero cloud telemetry
      </p>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var lastFocusedTrigger = null;

    function trapFocus(container, e) {
      if (e.key !== 'Tab') return;
      var focusables = container.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])');
      if (!focusables.length) return;
      var first = focusables[0];
      var last = focusables[focusables.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    // Mobile sheet
    var sheet = document.querySelector('[data-mobile-sheet]');
    var menuOpenBtn = document.querySelector('[data-menu-open]');
    var openSheet = function () {
      if (sheet) {
        lastFocusedTrigger = document.activeElement;
        sheet.classList.remove('hidden');
        if (menuOpenBtn) menuOpenBtn.setAttribute('aria-expanded', 'true');
        var closeBtn = sheet.querySelector('[data-menu-close]');
        if (closeBtn) closeBtn.focus();
      }
    };
    var closeSheet = function () {
      if (sheet && !sheet.classList.contains('hidden')) {
        sheet.classList.add('hidden');
        if (menuOpenBtn) menuOpenBtn.setAttribute('aria-expanded', 'false');
        if (lastFocusedTrigger && typeof lastFocusedTrigger.focus === 'function') {
          lastFocusedTrigger.focus();
        }
      }
    };

    if (menuOpenBtn) menuOpenBtn.addEventListener('click', openSheet);
    document.querySelectorAll('[data-menu-close]').forEach(function (b) {
      b.addEventListener('click', closeSheet);
    });
    var backdrop = sheet && sheet.querySelector('[data-sheet-backdrop]');
    if (backdrop) backdrop.addEventListener('click', closeSheet);

    if (sheet) {
      sheet.addEventListener('keydown', function (e) {
        trapFocus(sheet, e);
      });
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        closeSheet();
      }
    });
  })();
</script>
