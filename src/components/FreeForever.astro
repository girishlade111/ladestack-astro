---
/**
 * FreeForever.astro — 1:1 port of the source FreeForeverSection.tsx.
 * Same 4 commitment cards, comparison table (desktop) + stacked cards
 * (mobile), and gradient CTA bar.
 */
import Icon from './Icon.astro';

const commitments = [
  {
    number: '01', title: 'Unlimited Core AI Tools', badge: '5+ Live Products',
    description: 'Full access to AI Code Editor, 17-in-1 LS PDF Toolkit, LS Image Compressor, Swift Resume, and Bharat Land Converter.',
    color: '#6E8F6A', icon: 'code-2',
    bullets: ['No daily usage caps', 'Full feature set included', 'Continuous free updates'],
  },
  {
    number: '02', title: 'Zero Paywalls or Trials', badge: 'No Credit Card',
    description: 'Free forever means free forever — no 14-day trial countdowns, no surprise billing, and no credit card required to start.',
    color: '#7C86E8', icon: 'shield-check',
    bullets: ['Instant 1-click access', 'No forced subscription upgrades', 'Free for commercial projects'],
  },
  {
    number: '03', title: '100% Privacy & Security', badge: 'In-Browser Privacy',
    description: 'PDFs and image processing happen 100% client-side in your browser. Your sensitive files and code never hit external servers.',
    color: '#4EC2E8', icon: 'lock',
    bullets: ['Zero server uploads for files', 'SOC 2 compliance standards', 'Local storage encryption'],
  },
  {
    number: '04', title: 'Community & Open Ethos', badge: 'Community Driven',
    description: 'Built in the open with public roadmaps, community-voted features, and open-source foundations shaping our future.',
    color: '#E8A64E', icon: 'heart-handshake',
    bullets: ['Public GitHub roadmap', 'Community feature requests', '8K+ developer community'],
  },
];

const comparisonRows = [
  { feature: 'Monthly Pricing', ladeStack: '$0 / month (Forever)', others: '$20 – $50 / month' },
  { feature: 'Credit Card Required', ladeStack: 'No Credit Card Needed', others: 'Required upfront' },
  { feature: 'Data Privacy', ladeStack: '100% In-Browser & Local', others: 'Cloud uploads & logs' },
  { feature: 'Usage Limits', ladeStack: 'Unlimited Core Access', others: 'Strict daily rate limits' },
  { feature: 'Team Seats', ladeStack: 'Unlimited Collaboration', others: '$15/user/mo upgrade' },
];
---

<section class="relative py-20 sm:py-24 md:py-32 bg-white dark:bg-black overflow-hidden transition-colors duration-300">
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute inset-0 dark:hidden">
      <div class="absolute top-0 right-1/4 w-[600px] h-[500px] bg-[radial-gradient(ellipse_at_top,_rgba(110,143,106,0.12),_transparent_70%)]"></div>
      <div class="absolute bottom-0 left-1/4 w-[500px] h-[400px] bg-[radial-gradient(ellipse_at_bottom,_rgba(124,134,232,0.08),_transparent_70%)]"></div>
    </div>
    <div class="absolute inset-0 hidden dark:block">
      <div class="absolute top-0 right-1/3 w-[600px] h-[500px] bg-[radial-gradient(ellipse_at_top,_rgba(110,143,106,0.12),_transparent_70%)]"></div>
      <div class="absolute bottom-0 left-1/3 w-[500px] h-[400px] bg-[radial-gradient(ellipse_at_bottom,_rgba(78,194,232,0.08),_transparent_70%)]"></div>
    </div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:36px_36px]"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#6E8F6A]/15 dark:bg-[#6E8F6A]/20 border border-[#6E8F6A]/30 text-[#4E6F4A] dark:text-[#8EAF8A] text-xs font-semibold tracking-wide uppercase mb-4 shadow-sm">
        <Icon name="shield-check" class="w-3.5 h-3.5" />
        100% Free Forever Promise
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-white leading-[1.15] mb-5">
        Enterprise AI Power.{' '}
        <span class="relative inline-block text-[#6E8F6A] dark:text-[#8EAF8A]">
          Zero Price Tag.
          <span class="absolute -bottom-1 left-0 right-0 h-[3px] bg-[#6E8F6A]/40 dark:bg-[#8EAF8A]/40 rounded-full"></span>
        </span>
      </h2>
      <p class="text-neutral-600 dark:text-neutral-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto">
        We believe high-caliber developer tools shouldn&apos;t be locked behind paywalls. Every developer gets enterprise capability with zero credit card required.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch mb-16">
      {
        commitments.map((item) => (
          <div class="group h-full relative overflow-hidden rounded-2xl border border-neutral-200 dark:border-white/10 bg-white/80 dark:bg-[#0c0c0e]/80 backdrop-blur-md p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:shadow-xl hover:shadow-black/5 dark:hover:shadow-black/40 hover:-translate-y-1.5">
            <div class="absolute top-0 left-0 right-0 h-1.5 opacity-80" style={`background-color: ${item.color};`}></div>
            <div>
              <div class="flex items-center justify-between mb-5">
                <span
                  class="font-mono text-xs font-extrabold px-2.5 py-1 rounded-md border"
                  style={`color: ${item.color}; background-color: ${item.color}15; border-color: ${item.color}30;`}
                >
                  {item.number}
                </span>
                <span
                  class="text-[11px] font-semibold px-2.5 py-1 rounded-full border"
                  style={`color: ${item.color}; background-color: ${item.color}10; border-color: ${item.color}25;`}
                >
                  {item.badge}
                </span>
              </div>
              <div class="mb-4">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-3" style={`background-color: ${item.color}18; color: ${item.color};`}>
                  <Icon name={item.icon} class="w-5 h-5" />
                </div>
                <h3 class="text-xl font-bold text-neutral-900 dark:text-white tracking-tight">{item.title}</h3>
              </div>
              <p class="text-neutral-600 dark:text-neutral-300 text-sm leading-relaxed mb-6">{item.description}</p>
            </div>
            <div class="pt-4 border-t border-neutral-100 dark:border-white/10 mt-auto">
              <ul class="space-y-2">
                {item.bullets.map((b) => (
                        <li class="flex items-center gap-2.5 text-xs text-neutral-700 dark:text-neutral-300">
                          <Icon name="check-circle-2" class="w-3.5 h-3.5 flex-shrink-0" style={`color: ${item.color};`} />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>

    <div class="max-w-4xl mx-auto rounded-3xl border border-neutral-200 dark:border-white/10 bg-white/90 dark:bg-[#0d0d10]/90 backdrop-blur-md p-6 sm:p-10 shadow-xl shadow-black/5 dark:shadow-black/40 mb-16">
      <div class="text-center mb-8">
        <span class="text-xs font-bold uppercase tracking-wider text-[#6E8F6A] dark:text-[#8EAF8A]">
          Transparent Comparison
        </span>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-neutral-900 dark:text-white tracking-tight mt-1">
          Lade Stack vs Traditional Paid Tools
        </h3>
      </div>
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-neutral-200 dark:border-white/10">
              <th class="py-3.5 px-4 text-xs font-bold uppercase text-neutral-400 dark:text-neutral-500">Feature</th>
              <th class="py-3.5 px-4 text-sm font-bold text-[#6E8F6A] dark:text-[#8EAF8A]">Lade Suite ($0)</th>
              <th class="py-3.5 px-4 text-sm font-bold text-neutral-500 dark:text-neutral-400">Other Paid Platforms</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100 dark:divide-white/5">
            {
              comparisonRows.map((row) => (
                <tr class="hover:bg-neutral-50/50 dark:hover:bg-white/[0.02] transition-colors">
                  <td class="py-4 px-4 text-sm font-semibold text-neutral-900 dark:text-white">{row.feature}</td>
                  <td class="py-4 px-4 text-sm font-bold text-neutral-800 dark:text-neutral-100">
                    <div class="flex items-center gap-2">
                      <Icon name="check-circle-2" class="w-4 h-4 text-[#6E8F6A] flex-shrink-0" />
                      <span>{row.ladeStack}</span>
                    </div>
                  </td>
                  <td class="py-4 px-4 text-sm text-neutral-500 dark:text-neutral-400">
                    <div class="flex items-center gap-2">
                      <Icon name="x-circle" class="w-4 h-4 text-rose-400 flex-shrink-0" />
                      <span>{row.others}</span>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="md:hidden space-y-4">
        {
          comparisonRows.map((row) => (
            <div class="rounded-xl border border-neutral-200 dark:border-white/10 p-4 bg-neutral-50/50 dark:bg-white/[0.02]">
              <p class="text-xs font-bold uppercase text-neutral-400 dark:text-neutral-500 mb-2">{row.feature}</p>
              <div class="space-y-2">
                <div class="flex items-center justify-between text-xs font-bold text-neutral-900 dark:text-white">
                  <span>Lade Stack:</span>
                  <span class="flex items-center gap-1 text-[#6E8F6A] dark:text-[#8EAF8A]">
                    <Icon name="check-circle-2" class="w-3.5 h-3.5" />
                    {row.ladeStack}
                  </span>
                </div>
                <div class="flex items-center justify-between text-xs text-neutral-500 dark:text-neutral-400">
                  <span>Others:</span>
                  <span class="flex items-center gap-1 text-rose-400">
                    <Icon name="x-circle" class="w-3.5 h-3.5" />
                    {row.others}
                  </span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-[#6E8F6A] to-[#4E6F4A] p-8 sm:p-12 text-center text-white shadow-2xl max-w-4xl mx-auto">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(255,255,255,0.15),_transparent_60%)]"></div>
      <div class="relative z-10">
        <h3 class="text-2xl sm:text-3xl font-extrabold mb-3 leading-tight">
          Ready to Experience AI Development Without Barriers?
        </h3>
        <p class="text-white/80 text-sm sm:text-base max-w-xl mx-auto mb-8">
          Join over 8,000 developers building smarter, faster, and 100% free with Lade Stack.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href="https://code.ladestack.in/"
            target="_blank"
            rel="noopener noreferrer"
            class="soft-btn inline-flex items-center justify-center gap-2 font-medium h-12 px-8 text-base rounded-[10px] w-full sm:w-auto bg-white text-neutral-900 hover:bg-neutral-100 shadow-md font-semibold"
          >
            Start Building Free
            <Icon name="arrow-right" class="w-4 h-4" />
          </a>
          <a
            href="/apps"
            class="soft-btn inline-flex items-center justify-center gap-2 font-medium h-12 px-8 text-base rounded-[10px] w-full sm:w-auto border-white/40 text-white hover:bg-white/10 font-semibold border"
          >
            Explore 9+ Suite Apps
          </a>
        </div>
      </div>
    </div>

    <div class="w-full flex justify-center py-8 mt-12">
      <div class="h-px bg-gradient-to-r from-transparent via-border to-transparent" style="width: 60%;"></div>
    </div>
  </div>
</section>
