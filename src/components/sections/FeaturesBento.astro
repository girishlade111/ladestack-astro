---
/**
 * FeaturesBento.astro
 * High-craft Bento Grid showcasing core products with bespoke mini visuals.
 * Strictly adheres to design system tokens and craft-floor guidelines (no nested cards).
 */
import Icon from '../Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import BentoGrid from '../ui/BentoGrid.astro';
import BentoCard from '../ui/BentoCard.astro';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
---

<section id="features" class="py-20 sm:py-28 border-t border-border bg-surface-muted/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      eyebrow={t('features.eyebrow')}
      title={t('features.title')}
      description={t('features.subtitle')}
    />

    <BentoGrid cols={3}>
      {/* ── Card 1: AI Code Editor (Spans 2 columns on desktop) ── */}
      <BentoCard
        colSpan="col-span-1 lg:col-span-2"
        title={t('features.card1Title')}
        description={t('features.card1Desc')}
        badge={t('features.card1Badge')}
        href="https://code.ladestack.in/"
      >
        <div slot="icon" class="w-8 h-8 rounded-lg bg-brand/10 text-brand flex items-center justify-center">
          <Icon name="code-2" class="w-4 h-4" />
        </div>

        <div slot="visual" class="space-y-2 font-mono text-xs">
          <div class="flex items-center justify-between pb-2 border-b border-border/60 text-[11px] text-foreground/75">
            <span class="flex items-center gap-1.5 text-foreground font-medium">
              <span class="w-2 h-2 rounded-full bg-brand"></span>
              realtime-compiler.ts
            </span>
            <span class="text-brand">Optimization 99.4%</span>
          </div>
          <div class="space-y-1 text-foreground/75 text-[11px]">
            <div><span class="text-brand font-semibold">const</span> ast = parseCode(source);</div>
            <div><span class="text-brand font-semibold">const</span> optimized = <span class="text-foreground">aiEnhancer.refactor</span>(ast);</div>
            <div class="text-brand font-semibold">// Clean output: 0 dependencies added</div>
          </div>
        </div>
      </BentoCard>

      {/* ── Card 2: LS PDF Toolkit 17-in-1 (1 column) ── */}
      <BentoCard
        colSpan="col-span-1"
        title={t('features.card2Title')}
        description={t('features.card2Desc')}
        badge={t('features.card2Badge')}
        href="https://pdf.ladestack.in/"
      >
        <div slot="icon" class="w-8 h-8 rounded-lg bg-brand/10 text-brand flex items-center justify-center">
          <Icon name="file-text" class="w-4 h-4" />
        </div>

        <div slot="visual" class="space-y-2 text-xs">
          <div class="flex items-center justify-between pb-2 border-b border-border/60">
            <span class="font-medium text-foreground text-[11px]">Local Sandbox Engine</span>
            <span class="text-[10px] font-mono text-brand font-semibold">100% Client-Side</span>
          </div>
          <div class="grid grid-cols-3 gap-1.5 text-center text-[10px] font-mono">
            <div class="py-1.5 px-1 rounded bg-surface-muted text-foreground">Merge</div>
            <div class="py-1.5 px-1 rounded bg-surface-muted text-foreground">Compress</div>
            <div class="py-1.5 px-1 rounded bg-surface-muted text-foreground">Encrypt</div>
          </div>
        </div>
      </BentoCard>

      {/* ── Card 3: LS Image Compressor ── */}
      <BentoCard
        colSpan="col-span-1"
        title={t('features.card3Title')}
        description={t('features.card3Desc')}
        badge={t('features.card3Badge')}
        href="https://img.ladestack.in/"
      >
        <div slot="icon" class="w-8 h-8 rounded-lg bg-brand/10 text-brand flex items-center justify-center">
          <Icon name="image" class="w-4 h-4" />
        </div>

        <div slot="visual" class="space-y-2">
          <div class="flex items-center justify-between text-xs pb-1 border-b border-border/60">
            <span class="text-foreground/75 text-[11px]">hero-banner.png</span>
            <span class="text-brand font-mono font-semibold text-[11px]">-84%</span>
          </div>
          <div class="h-2 w-full rounded-full bg-surface-muted overflow-hidden">
            <div class="h-full rounded-full bg-brand" style="width: 16%;"></div>
          </div>
          <div class="flex justify-between text-[10px] font-mono text-foreground/75">
            <span>Original: 2.4 MB</span>
            <span class="text-foreground font-medium">Output: 384 KB</span>
          </div>
        </div>
      </BentoCard>

      {/* ── Card 4: Swift Resume Builder ── */}
      <BentoCard
        colSpan="col-span-1"
        title={t('features.card4Title')}
        description={t('features.card4Desc')}
        badge={t('features.card4Badge')}
        href="https://resume.ladestack.in/"
      >
        <div slot="icon" class="w-8 h-8 rounded-lg bg-brand/10 text-brand flex items-center justify-center">
          <Icon name="file-check" class="w-4 h-4" />
        </div>

        <div slot="visual" class="flex items-center justify-between text-xs pt-1">
          <div>
            <p class="font-medium text-foreground text-[11px]">ATS Match Score</p>
            <p class="text-[10px] text-foreground/75">94/100 · High Relevance</p>
          </div>
          <div class="flex items-center gap-1 font-mono text-xs font-semibold text-brand">
            <Icon name="check-circle" class="w-4 h-4" />
            <span>Passed</span>
          </div>
        </div>
      </BentoCard>

      {/* ── Card 5: Bharat Land Converter ── */}
      <BentoCard
        colSpan="col-span-1"
        title="Bharat Land Converter"
        description="Convert complex land measurement units across India (Bigha, Guntha, Acre, Biswa) with state-wise precision."
        badge="State Precision"
        href="https://land.ladestack.in/"
      >
        <div slot="icon" class="w-8 h-8 rounded-lg bg-brand/10 text-brand flex items-center justify-center">
          <Icon name="map-pin" class="w-4 h-4" />
        </div>

        <div slot="visual" class="text-xs space-y-1.5 pt-1">
          <div class="flex justify-between font-mono text-[11px]">
            <span class="text-foreground/75">1 Bigha (UP)</span>
            <span class="text-foreground font-medium">= 27,000 sq ft</span>
          </div>
          <div class="flex justify-between font-mono text-[11px]">
            <span class="text-foreground/75">1 Guntha (MH)</span>
            <span class="text-foreground font-medium">= 1,089 sq ft</span>
          </div>
        </div>
      </BentoCard>
    </BentoGrid>
  </div>
</section>
