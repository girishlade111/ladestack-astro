---
/**
 * FeaturesBento.astro
 * High-craft Bento Grid showcasing core products with bespoke mini visuals.
 * Strictly adheres to design system tokens and craft-floor guidelines.
 */
import Icon from '../Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import BentoGrid from '../ui/BentoGrid.astro';
import BentoCard from '../ui/BentoCard.astro';
---

<section id="features" class="py-20 sm:py-28 border-t border-border bg-surface-muted/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      title="Purpose-built tools for every stage of development"
      description="Nine specialized utilities engineered with one relentless standard: uncompromising client-side privacy, instantaneous WASM speed, and zero paywalls."
    />

    <BentoGrid cols={3}>
      {/* ── Card 1: AI Code Editor (Spans 2 columns on desktop) ── */}
      <BentoCard
        colSpan="col-span-1 lg:col-span-2"
        title="AI-Powered Code Studio & Compiler"
        description="Write, inspect, compile, and debug HTML, CSS, and modern JavaScript in real-time. Intelligent context-aware AI fixes bugs and optimizes bundle efficiency on the fly."
        badge="Flagship Studio"
        href="https://code.ladestack.in/"
      >
        <div slot="icon" class="w-8 h-8 rounded-lg bg-brand/10 text-brand flex items-center justify-center">
          <Icon name="code-2" class="w-4 h-4" />
        </div>

        <div slot="visual" class="rounded-lg border border-border bg-background p-4 font-mono text-xs">
          <div class="flex items-center justify-between pb-2 mb-3 border-b border-border/60 text-[11px] text-muted-foreground">
            <span class="flex items-center gap-1.5 text-foreground font-medium">
              <span class="w-2 h-2 rounded-full bg-brand"></span>
              realtime-compiler.ts
            </span>
            <span class="text-brand">Optimization 99.4%</span>
          </div>
          <div class="space-y-1 text-muted-foreground text-[11px]">
            <div><span class="text-brand font-semibold">const</span> ast = parseCode(source);</div>
            <div><span class="text-brand font-semibold">const</span> optimized = <span class="text-foreground">aiEnhancer.refactor</span>(ast);</div>
            <div class="text-emerald-600 dark:text-emerald-400 font-semibold">// Clean output: 0 dependencies added</div>
          </div>
        </div>
      </BentoCard>

      {/* ── Card 2: LS PDF Toolkit 17-in-1 (1 column) ── */}
      <BentoCard
        colSpan="col-span-1"
        title="LS PDF: 17 Client-Side Tools"
        description="Merge, split, compress, protect, watermark, and convert documents. 100% processed in your browser with WebAssembly."
        badge="Zero Cloud Uploads"
        href="https://pdf.ladestack.in/"
      >
        <div slot="icon" class="w-8 h-8 rounded-lg bg-brand/10 text-brand flex items-center justify-center">
          <Icon name="file-text" class="w-4 h-4" />
        </div>

        <div slot="visual" class="rounded-lg border border-border bg-background p-3.5 space-y-2 text-xs">
          <div class="flex items-center justify-between">
            <span class="font-medium text-foreground text-[11px]">Local Sandbox Engine</span>
            <span class="text-[10px] font-mono text-brand font-semibold">100% Client-Side</span>
          </div>
          <div class="grid grid-cols-3 gap-1.5 text-center text-[10px] font-mono">
            <div class="p-1.5 rounded border border-border bg-surface text-foreground">Merge</div>
            <div class="p-1.5 rounded border border-border bg-surface text-foreground">Compress</div>
            <div class="p-1.5 rounded border border-border bg-surface text-foreground">Encrypt</div>
          </div>
        </div>
      </BentoCard>

      {/* ── Card 3: LS Image Compressor ── */}
      <BentoCard
        colSpan="col-span-1"
        title="LS Image Compressor"
        description="High-fidelity compression for 9+ image formats (WebP, AVIF, PNG, SVG). Reduces asset weight up to 90% without server transit."
        badge="Canvas + WASM"
        href="https://img.ladestack.in/"
      >
        <div slot="icon" class="w-8 h-8 rounded-lg bg-brand/10 text-brand flex items-center justify-center">
          <Icon name="image" class="w-4 h-4" />
        </div>

        <div slot="visual" class="space-y-2">
          <div class="flex items-center justify-between text-xs">
            <span class="text-muted-foreground text-[11px]">hero-banner.png</span>
            <span class="text-brand font-mono font-semibold text-[11px]">-84%</span>
          </div>
          <div class="h-2 w-full rounded-full bg-border/60 overflow-hidden">
            <div class="h-full rounded-full bg-brand" style="width: 16%;"></div>
          </div>
          <div class="flex justify-between text-[10px] font-mono text-muted-foreground">
            <span>Original: 2.4 MB</span>
            <span class="text-foreground font-medium">Output: 384 KB</span>
          </div>
        </div>
      </BentoCard>

      {/* ── Card 4: Swift Resume Builder ── */}
      <BentoCard
        colSpan="col-span-1"
        title="Swift Resume Builder"
        description="ATS-compliant engineering resume builder with live Markdown preview, keyword density scoring, and clean one-click PDF export."
        badge="ATS Optimized"
        href="https://resume.ladestack.in/"
      >
        <div slot="icon" class="w-8 h-8 rounded-lg bg-brand/10 text-brand flex items-center justify-center">
          <Icon name="file-check" class="w-4 h-4" />
        </div>

        <div slot="visual" class="rounded-lg border border-border bg-background p-3 flex items-center justify-between text-xs">
          <div>
            <p class="font-medium text-foreground text-[11px]">ATS Parser Score</p>
            <p class="text-[10px] text-muted-foreground">94/100 · High Match</p>
          </div>
          <div class="flex items-center gap-1 font-mono text-sm font-bold text-brand">
            <Icon name="check-circle" class="w-4 h-4" />
            <span>Passed</span>
          </div>
        </div>
      </BentoCard>

      {/* ── Card 5: Bharat Land Converter ── */}
      <BentoCard
        colSpan="col-span-1"
        title="Bharat Land Converter"
        description="Convert complex land measurement units across India (Bigha, Guntha, Acre, Biswa) with state-wise precision."
        badge="State Precision"
        href="https://land.ladestack.in/"
      >
        <div slot="icon" class="w-8 h-8 rounded-lg bg-brand/10 text-brand flex items-center justify-center">
          <Icon name="map-pin" class="w-4 h-4" />
        </div>

        <div slot="visual" class="rounded-lg border border-border bg-background p-3 text-xs space-y-1">
          <div class="flex justify-between font-mono text-[11px]">
            <span class="text-muted-foreground">1 Bigha (UP)</span>
            <span class="text-foreground font-medium">= 27,000 sq ft</span>
          </div>
          <div class="flex justify-between font-mono text-[11px]">
            <span class="text-muted-foreground">1 Guntha (MH)</span>
            <span class="text-foreground font-medium">= 1,089 sq ft</span>
          </div>
        </div>
      </BentoCard>
    </BentoGrid>
  </div>
</section>
