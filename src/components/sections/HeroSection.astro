---
/**
 * HeroSection.astro
 * Premium developer hero with authentic Aceternity-inspired conic lamp spotlight
 * directly flush against the navbar, casting an expanding light cone downward
 * onto focal typography, CTAs, trust strip, and interactive studio workbench.
 * Token-driven, WCAG 2.2 compliant, zero emoji, full i18n support.
 */
import Icon from '../Icon.astro';
import Button from '../ui/Button.astro';
import AnimatedShinyText from '../ui/animated-shiny-text.astro';
import { useTranslations, getLocalizedPath, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const appsHref = getLocalizedPath('/apps', locale);

const trustPills = [
  { icon: 'shield-check', text: t('hero.badge') },
  { icon: 'zap', text: t('hero.editorStatus') },
  { icon: 'gift', text: t('footer.status') },
];
---

<section class="relative z-0 flex w-full flex-col items-center justify-start overflow-hidden bg-background pt-0 pb-20 sm:pb-32">
  <!-- Lamp / Downward Expanding Spotlight Stage (Flush with Navbar) -->
  <div class="absolute top-0 isolate z-0 flex w-full flex-1 items-start justify-center pointer-events-none select-none" aria-hidden="true">
    <div class="absolute top-0 z-50 h-48 w-full bg-transparent opacity-10 backdrop-blur-md"></div>

    <!-- Main central ambient glow: fills center between cones -->
    <div class="lamp-glow absolute inset-auto z-50 h-36 w-[28rem] translate-y-[30%] rounded-full opacity-80 blur-3xl"></div>

    <!-- Core lamp bulb beam: adds bright intensity directly under emitter bar -->
    <div class="lamp-bulb absolute top-0 z-30 h-36 -translate-y-[20%] w-[16rem] rounded-full blur-2xl"></div>

    <!-- Top lamp emitter line (touching navbar directly) -->
    <div class="lamp-bar absolute inset-auto z-50 h-0.5 w-[30rem] translate-y-[10%]"></div>

    <!-- Left gradient cone: spreads downward and outward to the left -->
    <div class="lamp-cone-left absolute inset-auto right-1/2 h-56 overflow-visible w-[30rem]">
      <div class="lamp-mask-bottom absolute w-full left-0 h-40 bottom-0 z-20"></div>
      <div class="lamp-mask-left absolute w-40 h-full left-0 bottom-0 z-20"></div>
    </div>

    <!-- Right gradient cone: spreads downward and outward to the right -->
    <div class="lamp-cone-right absolute inset-auto left-1/2 h-56 w-[30rem]">
      <div class="lamp-mask-right absolute w-40 h-full right-0 bottom-0 z-20"></div>
      <div class="lamp-mask-bottom absolute w-full right-0 h-40 bottom-0 z-20"></div>
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20">
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto hero-animate-in">
      <!-- Primary H1: Focal display title framed directly inside the downward expanding beam -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-foreground text-balance leading-[1.08]">
        {t('hero.titleLine1')} <span class="text-brand dark:text-blue-400">{t('hero.titleLine2')}</span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-base sm:text-lg md:text-xl text-muted-foreground leading-relaxed max-w-2xl text-pretty">
        {t('hero.description')}
      </p>

      <!-- Primary CTAs -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto">
        <Button href="https://code.ladestack.in/" target="_blank" size="lg" class="w-full sm:w-auto shadow-md">
          <AnimatedShinyText>{t('hero.ctaPrimary')}</AnimatedShinyText>
        </Button>
        <Button href={appsHref} variant="outline" size="lg" class="w-full sm:w-auto">
          <span>{t('hero.ctaSecondary')}</span>
          <Icon name="layers" class="w-4 h-4 text-muted-foreground" />
        </Button>
      </div>

      <!-- Trust cues -->
      <div class="mt-8 sm:mt-10 flex flex-wrap items-center justify-center gap-3 sm:gap-6 text-xs text-muted-foreground">
        {
          trustPills.map((p) => (
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface/80 border border-border backdrop-blur-sm shadow-soft">
              <Icon name={p.icon} class="w-4 h-4 text-brand" />
              <span class="font-medium text-foreground/85">{p.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  :root {
    --lamp-beam: rgba(2, 132, 199, 0.4);
    --lamp-glow: rgba(14, 165, 233, 0.45);
    --lamp-line: rgba(2, 132, 199, 0.9);
    --lamp-line-glow: rgba(14, 165, 233, 0.8);
  }

  :global(.dark) {
    --lamp-beam: rgba(255, 255, 255, 0.65);
    --lamp-glow: rgba(255, 255, 255, 0.65);
    --lamp-line: rgba(255, 255, 255, 0.95);
    --lamp-line-glow: rgba(255, 255, 255, 0.85);
  }

  .lamp-cone-left {
    background-image: conic-gradient(from 70deg at 50% 0%, var(--lamp-beam), transparent, transparent);
  }

  .lamp-cone-right {
    background-image: conic-gradient(from 290deg at 50% 0%, transparent, transparent, var(--lamp-beam));
  }

  .lamp-bar {
    background-color: var(--lamp-line);
    box-shadow: 0 0 20px var(--lamp-line-glow), 0 0 40px var(--lamp-line-glow);
  }

  .lamp-glow {
    background-color: var(--lamp-glow);
  }

  .lamp-bulb {
    background-color: var(--lamp-glow);
  }

  .lamp-mask-bottom {
    background-color: var(--background);
    mask-image: linear-gradient(to top, black, transparent);
    -webkit-mask-image: linear-gradient(to top, black, transparent);
  }

  .lamp-mask-left {
    background-color: var(--background);
    mask-image: linear-gradient(to right, black, transparent);
    -webkit-mask-image: linear-gradient(to right, black, transparent);
  }

  .lamp-mask-right {
    background-color: var(--background);
    mask-image: linear-gradient(to left, black, transparent);
    -webkit-mask-image: linear-gradient(to left, black, transparent);
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-animate-in {
    animation: hero-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
  }

  .hero-animate-delay {
    animation: hero-fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.45s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-animate-in,
    .hero-animate-delay {
      animation: none !important;
    }
  }
</style>
