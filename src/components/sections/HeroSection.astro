---
/**
 * HeroSection.astro
 * Premium developer hero with authentic Aceternity-inspired conic lamp spotlight
 * directly flush against the navbar, casting an expanding light cone downward
 * onto focal typography, CTAs, trust strip, and interactive studio workbench.
 * Token-driven, WCAG 2.2 compliant, zero emoji, full i18n support.
 */
import Icon from '../Icon.astro';
import Button from '../ui/Button.astro';
import { useTranslations, getLocalizedPath, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const appsHref = getLocalizedPath('/apps', locale);

const trustPills = [
  { icon: 'shield-check', text: t('hero.badge') },
  { icon: 'zap', text: t('hero.editorStatus') },
  { icon: 'gift', text: t('footer.status') },
];
---

<section class="relative z-0 flex w-full flex-col items-center justify-start overflow-hidden bg-background pt-0 pb-20 sm:pb-32">
  <!-- Lamp / Downward Expanding Spotlight Stage (Flush with Navbar) -->
  <div class="absolute top-0 isolate z-0 flex w-full flex-1 items-start justify-center pointer-events-none select-none overflow-hidden" aria-hidden="true">
    <div class="absolute top-0 z-50 h-48 w-full bg-transparent opacity-10 backdrop-blur-md"></div>

    <!-- Main central ambient glow -->
    <div class="absolute inset-auto z-50 h-36 w-[28rem] translate-y-[30%] rounded-full bg-brand/35 dark:bg-white/60 opacity-80 blur-3xl"></div>

    <!-- Core lamp bulb beam -->
    <div class="lamp-bulb absolute top-0 z-30 h-36 -translate-y-[20%] w-[16rem] rounded-full bg-brand/40 dark:bg-white/60 blur-2xl"></div>

    <!-- Top lamp emitter line (touching navbar) -->
    <div class="lamp-bar absolute inset-auto z-50 h-0.5 w-[30rem] translate-y-[10%] bg-brand/80 dark:bg-white shadow-[0_0_20px_hsl(var(--brand)/0.7)] dark:shadow-[0_0_25px_rgba(255,255,255,0.9)]"></div>

    <!-- Left gradient cone: shoots downward and left -->
    <div
      style="background-image: conic-gradient(var(--conic-position), var(--tw-gradient-stops));"
      class="lamp-cone-left absolute inset-auto right-1/2 h-56 overflow-visible w-[30rem] bg-gradient-conic from-brand/50 dark:from-white/60 via-transparent to-transparent [--conic-position:from_70deg_at_center_top]"
    >
      <div class="absolute w-[100%] left-0 bg-background h-40 bottom-0 z-20 [mask-image:linear-gradient(to_top,white,transparent)] [-webkit-mask-image:linear-gradient(to_top,white,transparent)]"></div>
      <div class="absolute w-40 h-[100%] left-0 bg-background bottom-0 z-20 [mask-image:linear-gradient(to_right,white,transparent)] [-webkit-mask-image:linear-gradient(to_right,white,transparent)]"></div>
    </div>

    <!-- Right gradient cone: shoots downward and right -->
    <div
      style="background-image: conic-gradient(var(--conic-position), var(--tw-gradient-stops));"
      class="lamp-cone-right absolute inset-auto left-1/2 h-56 w-[30rem] bg-gradient-conic from-transparent via-transparent to-brand/50 dark:to-white/60 [--conic-position:from_290deg_at_center_top]"
    >
      <div class="absolute w-40 h-[100%] right-0 bg-background bottom-0 z-20 [mask-image:linear-gradient(to_left,white,transparent)] [-webkit-mask-image:linear-gradient(to_left,white,transparent)]"></div>
      <div class="absolute w-[100%] right-0 bg-background h-40 bottom-0 z-20 [mask-image:linear-gradient(to_top,white,transparent)] [-webkit-mask-image:linear-gradient(to_top,white,transparent)]"></div>
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20">
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto hero-animate-in">
      <!-- Primary H1: Focal display title framed directly inside the downward expanding beam -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-foreground text-balance leading-[1.08]">
        {t('hero.titleLine1')} <span class="text-brand dark:text-blue-400">{t('hero.titleLine2')}</span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-base sm:text-lg md:text-xl text-muted-foreground leading-relaxed max-w-2xl text-pretty">
        {t('hero.description')}
      </p>

      <!-- Primary CTAs -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto">
        <Button href="https://code.ladestack.in/" target="_blank" size="lg" class="w-full sm:w-auto shadow-md">
          <span>{t('hero.ctaPrimary')}</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </Button>
        <Button href={appsHref} variant="outline" size="lg" class="w-full sm:w-auto">
          <span>{t('hero.ctaSecondary')}</span>
          <Icon name="layers" class="w-4 h-4 text-muted-foreground" />
        </Button>
      </div>

      <!-- Trust cues -->
      <div class="mt-8 sm:mt-10 flex flex-wrap items-center justify-center gap-3 sm:gap-6 text-xs text-muted-foreground">
        {
          trustPills.map((p) => (
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface/80 border border-border backdrop-blur-sm shadow-soft">
              <Icon name={p.icon} class="w-4 h-4 text-brand" />
              <span class="font-medium text-foreground/85">{p.text}</span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Studio Product Visual Mockup -->
    <div class="mt-14 sm:mt-20 max-w-5xl mx-auto hero-animate-delay">
      <div class="rounded-2xl border border-border bg-surface shadow-elevated overflow-hidden transition-all duration-300 hover:border-border-strong">
        <!-- IDE Titlebar -->
        <div class="flex items-center justify-between px-4 py-3 bg-surface-muted border-b border-border text-xs text-muted-foreground select-none">
          <div class="flex items-center gap-2">
            <div class="flex gap-1.5">
              <div class="w-3 h-3 rounded-full bg-border"></div>
              <div class="w-3 h-3 rounded-full bg-border"></div>
              <div class="w-3 h-3 rounded-full bg-border"></div>
            </div>
            <div class="hidden sm:flex items-center gap-2 ml-4 font-mono text-[11px]">
              <span class="text-foreground font-semibold flex items-center gap-1.5">
                <Icon name="code-2" class="w-3.5 h-3.5 text-brand" />
                {t('hero.editorFileName')}
              </span>
              <span class="text-border">/</span>
              <span>{t('hero.editorTabName')}</span>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-brand/10 text-brand font-mono text-[11px]">
              <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
              {t('hero.editorStatus')}
            </span>
            <span class="hidden md:inline font-mono text-[11px] text-muted-foreground">
              {t('hero.editorPrivacy')}
            </span>
          </div>
        </div>

        <!-- IDE Main Workspace -->
        <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-border bg-background">
          <!-- Left Editor Pane -->
          <div class="lg:col-span-7 p-5 sm:p-6 font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto">
            <div class="space-y-1 text-muted-foreground">
              <div class="flex gap-4">
                <span class="text-border select-none w-4 text-right">1</span>
                <span><span class="text-brand font-semibold">import</span> &#123; createPreviewSandbox &#125; <span class="text-brand font-semibold">from</span> <span class="text-foreground/80">'./studio/sandbox'</span>;</span>
              </div>
              <div class="flex gap-4">
                <span class="text-border select-none w-4 text-right">2</span>
                <span><span class="text-brand font-semibold">import type</span> &#123; EditorConfig &#125; <span class="text-brand font-semibold">from</span> <span class="text-foreground/80">'./types'</span>;</span>
              </div>
              <div class="flex gap-4">
                <span class="text-border select-none w-4 text-right">3</span>
                <span></span>
              </div>
              <div class="flex gap-4">
                <span class="text-border select-none w-4 text-right">4</span>
                <span><span class="text-muted-foreground">// Client-side execution: direct in-browser rendering</span></span>
              </div>
              <div class="flex gap-4">
                <span class="text-border select-none w-4 text-right">5</span>
                <span><span class="text-brand font-semibold">export function</span> <span class="text-foreground font-semibold">renderProjectPreview</span>(config: <span class="text-foreground/80">EditorConfig</span>) &#123;</span>
              </div>
              <div class="flex gap-4 bg-brand/5 -mx-4 px-4 py-0.5 rounded">
                <span class="text-brand select-none w-4 text-right">6</span>
                <span>&nbsp;&nbsp;<span class="text-brand font-semibold">const</span> sandbox = createPreviewSandbox(&#123; target: <span class="text-foreground/90">'#preview'</span> &#125;);</span>
              </div>
              <div class="flex gap-4">
                <span class="text-border select-none w-4 text-right">7</span>
                <span>&nbsp;&nbsp;<span class="text-brand font-semibold">return</span> sandbox.render(config.html, config.css, config.js);</span>
              </div>
              <div class="flex gap-4">
                <span class="text-border select-none w-4 text-right">8</span>
                <span>&#125;</span>
              </div>
            </div>

            <!-- In-editor inline notification -->
            <div class="mt-6 p-3 rounded-lg border border-brand/30 bg-brand/5 flex items-center justify-between gap-3 text-xs">
              <div class="flex items-center gap-2">
                <Icon name="check-circle-2" class="w-4 h-4 text-brand" />
                <span class="text-foreground font-medium">{t('hero.editorNotification')}</span>
              </div>
              <span class="font-mono text-[10px] text-brand uppercase tracking-wider">{t('hero.editorNotificationBadge')}</span>
            </div>
          </div>

          <!-- Right Live Preview / Metric Pane -->
          <div class="lg:col-span-5 p-5 sm:p-6 bg-surface/50 flex flex-col justify-between gap-6">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-border text-xs">
                <span class="font-medium text-foreground">{t('hero.specTitle')}</span>
                <span class="font-mono text-muted-foreground">{t('hero.specRuntime')}</span>
              </div>

              <div class="mt-4 space-y-3">
                <div class="p-3 rounded-lg border border-border bg-surface flex items-center justify-between">
                  <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-md bg-brand/10 text-brand flex items-center justify-center">
                      <Icon name="zap" class="w-4 h-4" />
                    </div>
                    <div>
                      <p class="text-xs font-semibold text-foreground">{t('hero.specExecutionModel')}</p>
                      <p class="text-[11px] text-muted-foreground">{t('hero.specExecutionValue')}</p>
                    </div>
                  </div>
                  <span class="font-mono text-xs font-semibold text-brand">{t('hero.specExecutionBadge')}</span>
                </div>

                <div class="p-3 rounded-lg border border-border bg-surface flex items-center justify-between">
                  <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-md bg-brand/10 text-brand flex items-center justify-center">
                      <Icon name="shield-check" class="w-4 h-4" />
                    </div>
                    <div>
                      <p class="text-xs font-semibold text-foreground">{t('hero.specPrivacy')}</p>
                      <p class="text-[11px] text-muted-foreground">{t('hero.specPrivacyValue')}</p>
                    </div>
                  </div>
                  <span class="font-mono text-xs font-semibold text-brand">{t('hero.specPrivacyBadge')}</span>
                </div>

                <div class="p-3 rounded-lg border border-border bg-surface flex items-center justify-between">
                  <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-md bg-brand/10 text-brand flex items-center justify-center">
                      <Icon name="layers" class="w-4 h-4" />
                    </div>
                    <div>
                      <p class="text-xs font-semibold text-foreground">{t('hero.specDistribution')}</p>
                      <p class="text-[11px] text-muted-foreground">{t('hero.specDistributionValue')}</p>
                    </div>
                  </div>
                  <span class="font-mono text-xs font-semibold text-brand">{t('hero.specDistributionBadge')}</span>
                </div>
              </div>
            </div>

            <!-- Quick Action in Preview -->
            <div class="pt-4 border-t border-border flex items-center justify-between">
              <span class="text-xs text-muted-foreground">{t('hero.browserCompatibility')}</span>
              <a
                href={appsHref}
                class="text-xs font-medium text-brand hover:underline inline-flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded"
              >
                <span>{t('hero.viewAppsLink')}</span>
                <Icon name="arrow-right" class="w-3 h-3" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes lamp-bar-expand {
    from {
      width: 15rem;
      opacity: 0.4;
    }
    to {
      width: min(30rem, 90vw);
      opacity: 1;
    }
  }

  @keyframes lamp-bulb-expand {
    from {
      width: 8rem;
      opacity: 0.4;
    }
    to {
      width: min(16rem, 50vw);
      opacity: 1;
    }
  }

  @keyframes lamp-cone-expand {
    from {
      width: 15rem;
      opacity: 0.4;
    }
    to {
      width: min(30rem, 50vw);
      opacity: 1;
    }
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .lamp-bar {
    animation: lamp-bar-expand 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }

  .lamp-bulb {
    animation: lamp-bulb-expand 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }

  .lamp-cone-left,
  .lamp-cone-right {
    animation: lamp-cone-expand 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }

  .hero-animate-in {
    animation: hero-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
  }

  .hero-animate-delay {
    animation: hero-fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.45s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .lamp-bar,
    .lamp-bulb,
    .lamp-cone-left,
    .lamp-cone-right,
    .hero-animate-in,
    .hero-animate-delay {
      animation: none !important;
    }
  }
</style>
