---
/**
 * HeroSection.astro
 * Premium developer hero with authentic Aceternity-inspired conic lamp spotlight
 * directly flush against the navbar, casting an expanding light cone downward
 * onto focal typography, CTAs, trust strip, and interactive studio workbench.
 * Token-driven, WCAG 2.2 compliant, zero emoji, full i18n support.
 */
import Icon from '../Icon.astro';
import Button from '../ui/Button.astro';
import AnimatedShinyText from '../ui/animated-shiny-text.astro';
import { useTranslations, getLocalizedPath, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const appsHref = getLocalizedPath('/apps', locale);

const trustPills = [
  { icon: 'shield-check', text: t('hero.badge') },
  { icon: 'zap', text: t('hero.editorStatus') },
  { icon: 'gift', text: t('footer.status') },
];
---

<section class="relative z-0 flex w-full flex-col items-center justify-start overflow-hidden bg-background pt-0 pb-20 sm:pb-32">
  <!-- Minimal Tray Lamp Stage (SVG Physical Housing + CSS Emitted Lighting) -->
  <div class="absolute top-0 isolate z-0 flex w-full flex-col items-center pointer-events-none select-none overflow-visible" aria-hidden="true">
    <!-- Layer 3: Ambient Diffusion (Wide soft atmosphere) -->
    <div class="lamp-ambient absolute top-0 w-[540px] sm:w-[780px] md:w-[960px] h-[300px] sm:h-[400px] pointer-events-none"></div>

    <!-- Layer 2: Main Downward Projection Beam (Directional colored light field) -->
    <div class="lamp-beam absolute top-0 w-[380px] sm:w-[560px] md:w-[700px] h-[240px] sm:h-[320px] pointer-events-none"></div>

    <!-- Layer 1: Luminous Source Linear Emitter (Continuous horizontal aura along the full diffuser length) -->
    <div class="lamp-source absolute top-[13px] sm:top-[15px] w-[180px] sm:w-[220px] md:w-[250px] lg:w-[270px] h-[16px] sm:h-[20px] rounded-full pointer-events-none"></div>

    <!-- Physical SVG Minimal Tray Lamp Housing -->
    <div class="relative z-10 flex justify-center w-full">
      <svg
        class="w-[200px] sm:w-[240px] md:w-[270px] lg:w-[290px] h-auto drop-shadow-md"
        viewBox="0 0 320 28"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <defs>
          <!-- DARK THEME GRADIENTS (Warm Bronze/Titanium Metallic Housing + Luminous Amber Diffuser) -->
          <linearGradient id="tray-metal-dark" x1="160" y1="2" x2="160" y2="20" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#5C4736" />
            <stop offset="20%" stop-color="#7B6149" />
            <stop offset="50%" stop-color="#9A7753" />
            <stop offset="80%" stop-color="#BD935F" />
            <stop offset="100%" stop-color="#DFAC68" />
          </linearGradient>
          <linearGradient id="tray-rim-dark" x1="160" y1="2" x2="160" y2="20" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#9C7F62" stop-opacity="0.9" />
            <stop offset="50%" stop-color="#735A42" stop-opacity="0.6" />
            <stop offset="100%" stop-color="#F59E0B" stop-opacity="0.8" />
          </linearGradient>
          <linearGradient id="tray-spec-dark" x1="28" y1="3" x2="292" y2="3" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#7B6149" stop-opacity="0" />
            <stop offset="25%" stop-color="#CBB196" stop-opacity="0.8" />
            <stop offset="50%" stop-color="#F4ECE2" stop-opacity="0.95" />
            <stop offset="75%" stop-color="#CBB196" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#7B6149" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="diffuser-lens-dark" x1="22" y1="16" x2="298" y2="16" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#D97706" />
            <stop offset="5%" stop-color="#F59E0B" />
            <stop offset="12%" stop-color="#FEF08A" />
            <stop offset="20%" stop-color="#FFFFFF" />
            <stop offset="80%" stop-color="#FFFFFF" />
            <stop offset="88%" stop-color="#FEF08A" />
            <stop offset="95%" stop-color="#F59E0B" />
            <stop offset="100%" stop-color="#D97706" />
          </linearGradient>
          <linearGradient id="diffuser-core-dark" x1="36" y1="16" x2="284" y2="16" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#FEF08A" stop-opacity="0.6" />
            <stop offset="8%" stop-color="#FFFFFF" stop-opacity="1" />
            <stop offset="92%" stop-color="#FFFFFF" stop-opacity="1" />
            <stop offset="100%" stop-color="#FEF08A" stop-opacity="0.6" />
          </linearGradient>

          <!-- LIGHT THEME GRADIENTS (Cool Slate/Aluminum Metallic Housing + Sky-Blue Diffuser) -->
          <linearGradient id="tray-metal-light" x1="160" y1="2" x2="160" y2="20" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#93A6BD" />
            <stop offset="25%" stop-color="#8AA3BE" />
            <stop offset="50%" stop-color="#92AECB" />
            <stop offset="75%" stop-color="#A5C7E0" />
            <stop offset="100%" stop-color="#C2E2F8" />
          </linearGradient>
          <linearGradient id="tray-rim-light" x1="160" y1="2" x2="160" y2="20" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.95" />
            <stop offset="50%" stop-color="#CBD5E1" stop-opacity="0.7" />
            <stop offset="100%" stop-color="#0284C7" stop-opacity="0.8" />
          </linearGradient>
          <linearGradient id="tray-spec-light" x1="28" y1="3" x2="292" y2="3" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0" />
            <stop offset="20%" stop-color="#FFFFFF" stop-opacity="0.9" />
            <stop offset="50%" stop-color="#FFFFFF" stop-opacity="1" />
            <stop offset="80%" stop-color="#FFFFFF" stop-opacity="0.9" />
            <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="diffuser-lens-light" x1="22" y1="16" x2="298" y2="16" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#0284C7" />
            <stop offset="5%" stop-color="#38BDF8" />
            <stop offset="12%" stop-color="#BAE6FD" />
            <stop offset="20%" stop-color="#FFFFFF" />
            <stop offset="80%" stop-color="#FFFFFF" />
            <stop offset="88%" stop-color="#BAE6FD" />
            <stop offset="95%" stop-color="#38BDF8" />
            <stop offset="100%" stop-color="#0284C7" />
          </linearGradient>
          <linearGradient id="diffuser-core-light" x1="36" y1="16" x2="284" y2="16" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#BAE6FD" stop-opacity="0.6" />
            <stop offset="8%" stop-color="#FFFFFF" stop-opacity="1" />
            <stop offset="92%" stop-color="#FFFFFF" stop-opacity="1" />
            <stop offset="100%" stop-color="#BAE6FD" stop-opacity="0.6" />
          </linearGradient>
        </defs>

        <!-- DARK THEME FIXTURE (Rendered only when .dark is active) -->
        <g class="hidden dark:inline">
          <!-- Upper Metallic Tray Housing -->
          <rect x="10" y="2" width="300" height="18" rx="9" fill="url(#tray-metal-dark)" stroke="url(#tray-rim-dark)" stroke-width="1" />
          <!-- Top Specular Highlight Line -->
          <path d="M 28 3.2 L 292 3.2" stroke="url(#tray-spec-dark)" stroke-width="0.8" stroke-linecap="round" />
          <!-- Luminous Diffuser Lens Underside -->
          <rect x="22" y="12.5" width="276" height="7.5" rx="3.75" fill="url(#diffuser-lens-dark)" />
          <!-- Diffuser Core Slit -->
          <rect x="36" y="14" width="248" height="3" rx="1.5" fill="url(#diffuser-core-dark)" />
        </g>

        <!-- LIGHT THEME FIXTURE (Rendered when light mode is active) -->
        <g class="inline dark:hidden">
          <!-- Upper Metallic Tray Housing -->
          <rect x="10" y="2" width="300" height="18" rx="9" fill="url(#tray-metal-light)" stroke="url(#tray-rim-light)" stroke-width="1" />
          <!-- Top Specular Highlight Line -->
          <path d="M 28 3.2 L 292 3.2" stroke="url(#tray-spec-light)" stroke-width="0.8" stroke-linecap="round" />
          <!-- Luminous Diffuser Lens Underside -->
          <rect x="22" y="12.5" width="276" height="7.5" rx="3.75" fill="url(#diffuser-lens-light)" />
          <!-- Diffuser Core Slit -->
          <rect x="36" y="14" width="248" height="3" rx="1.5" fill="url(#diffuser-core-light)" />
        </g>
      </svg>
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20">
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto hero-animate-in">
      <!-- Primary H1: Focal display title framed directly inside the downward expanding beam -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-foreground text-balance leading-[1.08]">
        {t('hero.titleLine1')} <span class="text-[#0076FF] dark:text-[#FBA528]">{t('hero.titleLine2')}</span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-base sm:text-lg md:text-xl text-muted-foreground leading-relaxed max-w-2xl text-pretty">
        {t('hero.description')}
      </p>

      <!-- Primary CTAs -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto">
        <Button href="https://code.ladestack.in/" target="_blank" size="lg" class="w-full sm:w-auto shadow-md">
          <AnimatedShinyText>{t('hero.ctaPrimary')}</AnimatedShinyText>
        </Button>
        <Button href={appsHref} variant="outline" size="lg" class="w-full sm:w-auto">
          <span>{t('hero.ctaSecondary')}</span>
          <Icon name="layers" class="w-4 h-4 text-muted-foreground" />
        </Button>
      </div>

      <!-- Trust cues -->
      <div class="mt-8 sm:mt-10 flex flex-wrap items-center justify-center gap-3 sm:gap-6 text-xs text-muted-foreground">
        {
          trustPills.map((p) => (
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface/80 border border-border backdrop-blur-sm shadow-soft">
              <Icon name={p.icon} class="w-4 h-4 text-brand" />
              <span class="font-medium text-foreground/85">{p.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  :root {
    /* Light Theme: Soft Clear Sky-Blue Illumination */
    --lamp-source-core: rgba(255, 255, 255, 1.0);
    --lamp-source-glow: rgba(56, 189, 248, 0.90);
    --lamp-beam: radial-gradient(ellipse 68% 58% at 50% 0%, rgba(56, 189, 248, 0.44) 0%, rgba(125, 211, 252, 0.32) 30%, rgba(14, 165, 233, 0.20) 55%, rgba(2, 132, 199, 0.08) 75%, transparent 85%);
    --lamp-ambient: radial-gradient(ellipse 64% 52% at 50% 0%, rgba(56, 189, 248, 0.24) 0%, rgba(125, 211, 252, 0.12) 45%, transparent 75%);
  }

  :global(.dark) {
    /* Dark Theme: Soft Warm Golden Amber Illumination */
    --lamp-source-core: rgba(255, 255, 255, 1.0);
    --lamp-source-glow: rgba(251, 191, 36, 0.98);
    --lamp-beam: radial-gradient(ellipse 68% 58% at 50% 0%, rgba(251, 191, 36, 0.72) 0%, rgba(245, 158, 11, 0.58) 25%, rgba(217, 119, 6, 0.38) 50%, rgba(180, 83, 9, 0.16) 72%, transparent 88%);
    --lamp-ambient: radial-gradient(ellipse 64% 52% at 50% 0%, rgba(245, 158, 11, 0.36) 0%, rgba(217, 119, 6, 0.18) 45%, transparent 75%);
  }

  .lamp-ambient {
    background: var(--lamp-ambient);
    filter: blur(52px);
  }

  .lamp-beam {
    background: var(--lamp-beam);
    filter: blur(28px);
  }

  .lamp-source {
    background: radial-gradient(ellipse 60% 80% at 50% 50%, var(--lamp-source-core) 0%, var(--lamp-source-glow) 45%, transparent 100%);
    filter: blur(8px);
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-animate-in {
    animation: hero-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
  }

  .hero-animate-delay {
    animation: hero-fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.45s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-animate-in,
    .hero-animate-delay {
      animation: none !important;
    }
  }
</style>
