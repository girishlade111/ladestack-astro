---
/**
 * ProductShowcase.astro
 * Real-world catalog of live and upcoming utilities from src/data/apps.json.
 * Category filtering, live launch status, clean token styling.
 */
import Icon from '../Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Badge from '../ui/Badge.astro';
import appsData from '../../data/apps.json';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);

const apps = appsData;
const liveApps = apps.filter((a) => !a.comingSoon);
const upcomingApps = apps.filter((a) => a.comingSoon);
---

<section id="products-catalog" class="py-20 sm:py-28 border-t border-border bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      eyebrow={t('showcase.eyebrow')}
      title={t('showcase.title')}
      description={t('showcase.subtitle')}
    />

    {/* Live Suite */}
    <div class="mb-14">
      <div class="flex items-center gap-2 mb-6">
        <span class="w-2 h-2 rounded-full bg-brand"></span>
        <h3 class="text-sm font-mono font-semibold uppercase tracking-wider text-foreground">
          Live & In Production ({liveApps.length})
        </h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          liveApps.map((app) => (
            <div class="group relative rounded-xl border border-border bg-surface p-6 flex flex-col justify-between transition-all duration-200 hover:border-brand/40 hover:shadow-card">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <Badge variant="brand" size="sm">
                    {app.category}
                  </Badge>
                  <span class="text-xs font-mono text-muted-foreground">
                    TTValue: {app.timeToValue}
                  </span>
                </div>

                <h4 class="text-lg font-semibold tracking-tight text-foreground group-hover:text-brand transition-colors">
                  {app.title}
                </h4>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed line-clamp-2">
                  {app.description}
                </p>

                <div class="mt-4 flex flex-wrap gap-1.5">
                  {app.features.map((f) => (
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono bg-surface-muted text-muted-foreground">
                      {f}
                    </span>
                  ))}
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-border/60 flex items-center justify-between">
                <span class="text-xs text-muted-foreground font-mono">100% Free Forever</span>
                <a
                  href={app.landingUrl}
                  target={app.landingUrl.startsWith('http') ? '_blank' : undefined}
                  rel={app.landingUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand hover:underline"
                >
                  <span>{t('showcase.launchCta')}</span>
                  <Icon name="arrow-up-right" class="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    {/* Coming Next in Pipeline */}
    <div>
      <div class="flex items-center gap-2 mb-6">
        <span class="w-2 h-2 rounded-full bg-muted-foreground"></span>
        <h3 class="text-sm font-mono font-semibold uppercase tracking-wider text-muted-foreground">
          In Development Pipeline ({upcomingApps.length})
        </h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          upcomingApps.map((app) => (
            <div class="rounded-xl border border-border/80 bg-surface/50 p-5 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground px-2 py-0.5 rounded bg-surface-muted">
                    {app.category}
                  </span>
                  <Badge variant="outline" size="sm">
                    In Testing
                  </Badge>
                </div>
                <h4 class="text-base font-semibold tracking-tight text-foreground">
                  {app.title}
                </h4>
                <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed line-clamp-2">
                  {app.tagline}
                </p>
              </div>

              <div class="mt-4 pt-3 border-t border-border/40 text-[11px] text-muted-foreground font-mono">
                Planned Q2 2026
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
