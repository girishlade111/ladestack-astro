---
/**
 * DeveloperCommunitySection.astro
 * Presentation of LadeStack's Developer Community channels, open source ethos, and collaboration hubs.
 * Token-based design, full i18n, zero emoji, WCAG AA contrast.
 */
import Icon from '../Icon.astro';
import { getLandingData } from '../../i18n/pages/landing';
import { getLocalizedPath } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const data = getLandingData(locale).developerCommunity;
---

<section id="community" class="py-20 sm:py-28 border-t border-border bg-background relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
      <span class="text-xs font-mono font-semibold uppercase tracking-wider text-brand">
        {data.eyebrow}
      </span>
      <h2 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-foreground text-balance">
        {data.title} <span class="text-brand">{data.titleHighlight}</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-muted-foreground leading-relaxed text-pretty">
        {data.subtitle}
      </p>
    </div>

    {/* Community Stats Strip */}
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mb-16 max-w-4xl mx-auto">
      {
        data.stats.map((s) => (
          <div class="flex flex-col items-center justify-center p-5 rounded-xl border border-border bg-surface text-center shadow-soft hover:border-brand/40 transition-colors">
            <div class="w-8 h-8 rounded-lg bg-brand/10 text-brand flex items-center justify-center mb-2">
              <Icon name={s.icon} class="w-4 h-4" />
            </div>
            <span class="text-2xl sm:text-3xl font-bold font-mono text-foreground tracking-tight">
              {s.value}
            </span>
            <span class="text-xs text-muted-foreground mt-1 font-medium">{s.label}</span>
          </div>
        ))
      }
    </div>

    {/* 6 Community Channel Cards */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        data.channels.map((channel) => {
          const isExternal = channel.url.startsWith('http');
          const href = isExternal ? channel.url : getLocalizedPath(channel.url, locale);
          return (
            <a
              href={href}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
              class="group rounded-2xl border border-border bg-surface p-6 sm:p-7 shadow-soft flex flex-col justify-between hover:border-brand/40 hover:-translate-y-1 transition-all duration-200"
            >
              <div>
                <div class="flex items-center justify-between mb-4">
                  <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand flex items-center justify-center">
                    <Icon name={channel.icon} class="w-5 h-5" />
                  </div>
                  <span class="text-[11px] font-mono font-semibold px-2.5 py-0.5 rounded-full bg-brand/10 text-brand border border-brand/20">
                    {channel.stat}
                  </span>
                </div>

                <h3 class="text-lg font-bold text-foreground tracking-tight mb-2">
                  {channel.label}
                </h3>

                <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed mb-6">
                  {channel.description}
                </p>
              </div>

              <div class="pt-4 border-t border-border/80 flex items-center justify-between text-xs font-semibold text-brand group-hover:text-foreground transition-colors">
                <span>{channel.cta}</span>
                <Icon name="arrow-up-right" class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
