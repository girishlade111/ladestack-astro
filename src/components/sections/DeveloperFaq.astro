---
/**
 * DeveloperFaq.astro
 * Real technical answers to common developer questions.
 * Built with accessible native Accordion primitives.
 */
import SectionHeader from '../ui/SectionHeader.astro';
import Accordion from '../ui/Accordion.astro';
import AccordionItem from '../ui/AccordionItem.astro';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);

export function getFaqs(loc: Locale = 'en') {
  const trans = useTranslations(loc);
  return [
    {
      q: trans('faq.q1'),
      a: trans('faq.a1'),
    },
    {
      q: trans('faq.q2'),
      a: trans('faq.a2'),
    },
    {
      q: trans('faq.q3'),
      a: trans('faq.a3'),
    },
    {
      q: trans('faq.q4'),
      a: trans('faq.a4'),
    },
    {
      q: trans('faq.q5'),
      a: trans('faq.a5'),
    },
    {
      q: trans('faq.q6'),
      a: trans('faq.a6'),
    },
    {
      q: trans('faq.q7'),
      a: trans('faq.a7'),
    },
    {
      q: trans('faq.q8'),
      a: trans('faq.a8'),
    },
    {
      q: trans('faq.q9'),
      a: trans('faq.a9'),
    },
    {
      q: trans('faq.q10'),
      a: trans('faq.a10'),
    },
    {
      q: trans('faq.q11'),
      a: trans('faq.a11'),
    },
    {
      q: trans('faq.q12'),
      a: trans('faq.a12'),
    },
    {
      q: trans('faq.q13'),
      a: trans('faq.a13'),
    },
    {
      q: trans('faq.q14'),
      a: trans('faq.a14'),
    },
  ];
}

export const faqs = getFaqs('en');
const currentFaqs = getFaqs(locale);
---

<section id="faq" class="py-20 sm:py-28 border-t border-border bg-surface-muted/30">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      eyebrow="FAQ"
      title={t('faq.title')}
      description={t('faq.subtitle')}
    />

    <Accordion>
      {
        currentFaqs.map((faq, i) => (
          <AccordionItem question={faq.q} open={i === 0}>
            <p>{faq.a}</p>
          </AccordionItem>
        ))
      }
    </Accordion>
  </div>
</section>
