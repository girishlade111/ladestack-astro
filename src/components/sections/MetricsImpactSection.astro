---
/**
 * MetricsImpactSection.astro
 * Presentation of LadeStack's measurable performance, reliability, and productivity numbers.
 * Verified metrics, accessible data bars, token-based design, zero emoji.
 */
import Icon from '../Icon.astro';
import { getLandingData } from '../../i18n/pages/landing';
import type { Locale } from '../../i18n/config';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const data = getLandingData(locale).metricsImpact;
---

<section id="impact" class="py-20 sm:py-28 border-t border-border bg-background relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
      <span class="text-xs font-mono font-semibold uppercase tracking-wider text-brand">
        {data.eyebrow}
      </span>
      <h2 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-foreground text-balance">
        {data.title} <span class="text-brand">{data.titleHighlight}</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-muted-foreground leading-relaxed text-pretty">
        {data.subtitle}
      </p>
    </div>

    {/* 4 Hero Stats */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-16">
      {
        data.heroStats.map((stat) => (
          <div class="rounded-2xl border border-border bg-surface p-6 text-center shadow-soft hover:border-brand/40 transition-colors flex flex-col items-center justify-center">
            <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand flex items-center justify-center mb-3">
              <Icon name={stat.icon} class="w-5 h-5" />
            </div>
            <span class="text-3xl sm:text-4xl font-bold font-mono text-foreground tracking-tight">
              {stat.value}
            </span>
            <span class="text-sm font-semibold text-foreground mt-1">{stat.label}</span>
            <span class="text-xs text-muted-foreground mt-0.5">{stat.sub}</span>
          </div>
        ))
      }
    </div>

    {/* Tool-Level Workflow Productivity Gains */}
    <div class="rounded-2xl border border-border bg-surface p-6 sm:p-10 shadow-soft mb-12">
      <div class="mb-8">
        <h3 class="text-xl sm:text-2xl font-bold text-foreground tracking-tight">
          {data.toolMetricsTitle}
        </h3>
        <p class="text-sm text-muted-foreground mt-1">
          {data.toolMetricsSubtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        {
          data.toolMetrics.map((tool) => (
            <div class="rounded-xl border border-border/80 bg-surface-muted/20 p-5 flex flex-col justify-between">
              <div class="flex items-center gap-3 mb-5">
                <div class="w-9 h-9 rounded-lg bg-brand/10 text-brand flex items-center justify-center">
                  <Icon name={tool.icon} class="w-4 h-4" />
                </div>
                <h4 class="text-base font-bold text-foreground tracking-tight">{tool.tool}</h4>
              </div>

              <div class="space-y-4">
                {
                  tool.metrics.map((m) => (
                    <div>
                      <div class="flex justify-between text-xs mb-1.5 font-medium">
                        <span class="text-muted-foreground">{m.label}</span>
                        <span class="font-mono text-brand font-semibold">{m.value}%</span>
                      </div>
                      <div class="h-2 w-full rounded-full bg-surface-muted overflow-hidden">
                        <div
                          class="h-full rounded-full bg-brand transition-all duration-500"
                          style={`width: ${m.value}%;`}
                          role="progressbar"
                          aria-valuenow={m.value}
                          aria-valuemin="0"
                          aria-valuemax="100"
                        />
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          ))
        }
      </div>
    </div>

    {/* Reliability & Speed Benchmarks */}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {
        data.benchmarks.map((b) => (
          <div class="rounded-xl border border-border bg-surface p-5 text-center shadow-soft">
            <span class="text-2xl sm:text-3xl font-bold font-mono text-brand block mb-1">
              {b.value}
            </span>
            <span class="text-xs sm:text-sm font-semibold text-foreground block">
              {b.label}
            </span>
            <span class="text-[11px] text-muted-foreground mt-0.5 block">
              {b.sub}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
