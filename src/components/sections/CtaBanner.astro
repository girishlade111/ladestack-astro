---
/**
 * CtaBanner.astro
 * Focused, high-contrast closing CTA section.
 */
import Icon from '../Icon.astro';
import Button from '../ui/Button.astro';
import { useTranslations, getLocalizedPath, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const appsHref = getLocalizedPath('/apps', locale);
---

<section class="py-20 sm:py-28 border-t border-border bg-background relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 hero-glow -z-10" aria-hidden="true"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="rounded-3xl border border-border bg-surface p-8 sm:p-14 shadow-card">
      <div class="max-w-2xl mx-auto">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-brand">
          Immediate Access
        </span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-foreground text-balance">
          {t('cta.title')}
        </h2>
        <p class="mt-4 text-base sm:text-lg text-muted-foreground leading-relaxed text-pretty">
          {t('cta.subtitle')}
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <Button href="https://code.ladestack.in/" target="_blank" size="lg" class="w-full sm:w-auto">
            <span>{t('cta.button')}</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </Button>
          <Button href={appsHref} variant="outline" size="lg" class="w-full sm:w-auto">
            <span>Explore All Utilities</span>
            <Icon name="layers" class="w-4 h-4 text-muted-foreground" />
          </Button>
        </div>

        <p class="mt-6 text-xs text-muted-foreground font-mono">
          100% Free Forever · Client-Side Execution · Open Standards
        </p>
      </div>
    </div>
  </div>
</section>
