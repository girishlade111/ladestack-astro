---
/**
 * HowItWorks.astro
 * Step-by-step flow diagram in SVG + crisp technical narrative.
 * Mobile-first responsive workflow with on-device execution proof.
 */
import Icon from '../Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
  class?: string;
}

const { locale = 'en', class: className = '' } = Astro.props;
const t = useTranslations(locale);

const steps = [
  {
    step: t('howItWorks.step1Num'),
    title: t('howItWorks.step1Title'),
    description: t('howItWorks.step1Desc'),
    icon: 'play',
  },
  {
    step: t('howItWorks.step2Num'),
    title: t('howItWorks.step2Title'),
    description: t('howItWorks.step2Desc'),
    icon: 'cpu',
  },
  {
    step: t('howItWorks.step3Num'),
    title: t('howItWorks.step3Title'),
    description: t('howItWorks.step3Desc'),
    icon: 'rocket',
  },
];
---

<section id="how-it-works" class={`preserved-bento-lock py-20 sm:py-28 border-b border-border bg-background ${className}`.trim()}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      eyebrow={t('howItWorks.eyebrow')}
      title={t('howItWorks.title')}
      description={t('howItWorks.subtitle')}
    />

    {/* ── Flow Diagram (SVG + HTML) ── */}
    <div class="mb-14 p-6 sm:p-10 rounded-2xl border border-border bg-surface shadow-soft">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-6 sm:gap-8 relative">
        {/* Node 1 */}
        <div class="flex flex-col items-center text-center max-w-[220px]">
          <div class="w-14 h-14 rounded-xl border border-border bg-surface-muted flex items-center justify-center text-foreground mb-3 shadow-soft">
            <Icon name="globe" class="w-6 h-6 text-brand" />
          </div>
          <span class="text-xs font-mono text-muted-foreground uppercase tracking-wider">Step 1</span>
          <p class="text-sm font-semibold text-foreground mt-1">Direct In-Browser Launch</p>
          <p class="text-xs text-muted-foreground mt-0.5">Zero logins or API setup</p>
        </div>

        {/* Connector 1 */}
        <div class="hidden lg:flex flex-1 items-center justify-center px-4" aria-hidden="true">
          <svg class="w-full h-6 text-border" viewBox="0 0 200 24" fill="none">
            <line x1="0" y1="12" x2="190" y2="12" stroke="currentColor" stroke-width="2" stroke-dasharray="4 4" />
            <polygon points="190,8 200,12 190,16" fill="currentColor" />
          </svg>
        </div>

        {/* Mobile vertical divider */}
        <div class="lg:hidden w-px h-8 bg-border" aria-hidden="true"></div>

        {/* Node 2 */}
        <div class="flex flex-col items-center text-center max-w-[220px]">
          <div class="w-14 h-14 rounded-xl border border-brand/40 bg-brand/10 flex items-center justify-center text-brand mb-3 shadow-soft">
            <Icon name="cpu" class="w-6 h-6" />
          </div>
          <span class="text-xs font-mono text-brand uppercase tracking-wider">Step 2</span>
          <p class="text-sm font-semibold text-foreground mt-1">WASM & Local AI</p>
          <p class="text-xs text-muted-foreground mt-0.5">100% on-device sandboxing</p>
        </div>

        {/* Connector 2 */}
        <div class="hidden lg:flex flex-1 items-center justify-center px-4" aria-hidden="true">
          <svg class="w-full h-6 text-border" viewBox="0 0 200 24" fill="none">
            <line x1="0" y1="12" x2="190" y2="12" stroke="currentColor" stroke-width="2" stroke-dasharray="4 4" />
            <polygon points="190,8 200,12 190,16" fill="currentColor" />
          </svg>
        </div>

        {/* Mobile vertical divider */}
        <div class="lg:hidden w-px h-8 bg-border" aria-hidden="true"></div>

        {/* Node 3 */}
        <div class="flex flex-col items-center text-center max-w-[220px]">
          <div class="w-14 h-14 rounded-xl border border-border bg-surface-muted flex items-center justify-center text-foreground mb-3 shadow-soft">
            <Icon name="check-circle" class="w-6 h-6 text-brand" />
          </div>
          <span class="text-xs font-mono text-muted-foreground uppercase tracking-wider">Step 3</span>
          <p class="text-sm font-semibold text-foreground mt-1">Instant Deployment</p>
          <p class="text-xs text-muted-foreground mt-0.5">Clean code, zero paywalls</p>
        </div>
      </div>
    </div>

    {/* Detail cards */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {
        steps.map((step) => (
          <div class="rounded-xl border border-border bg-surface p-6 sm:p-7 flex flex-col justify-between transition-colors hover:border-brand/30">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-mono text-xs font-semibold text-brand bg-brand/10 px-2 py-0.5 rounded">
                  {step.step}
                </span>
                <Icon name={step.icon} class="w-4 h-4 text-muted-foreground" />
              </div>
              <h3 class="text-lg font-semibold tracking-tight text-foreground">
                {step.title}
              </h3>
              <p class="mt-2.5 text-sm text-muted-foreground leading-relaxed">
                {step.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
