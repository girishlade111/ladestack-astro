---
/**
 * Footer.astro
 * Unified brand footer with structured columns, status badge,
 * accessible newsletter input, sitemap link, and social channels.
 */
import Icon from './Icon.astro';
import { useTranslations, getLocalizedPath, type Locale } from '../i18n';
import { getConsentTranslations } from '../i18n/consent';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const homeHref = getLocalizedPath('/', locale);
const consentT = getConsentTranslations(locale);

const navColumns = [
  {
    heading: t('nav.platform'),
    links: [
      { label: 'GB Coder', href: '/gb-coder' },
      { label: 'LS PDF Toolkit (17-in-1)', href: 'https://pdf.ladestack.in/', external: true },
      { label: 'LS Image Compressor', href: 'https://img.ladestack.in/', external: true },
      { label: 'Swift Resume Builder', href: 'https://resume.ladestack.in/', external: true },
      { label: 'Bharat Land Converter', href: 'https://land.ladestack.in/', external: true },
      { label: t('nav.apps'), href: '/apps' },
    ],
  },
  {
    heading: t('footer.resources'),
    links: [
      { label: t('nav.docs'), href: '/docs' },
      { label: t('nav.faq'), href: '/faq' },
      { label: 'API Reference', href: '/docs' },
      { label: t('nav.blog'), href: '/blog' },
      { label: 'GitHub Repository', href: 'https://github.com/girishlade111', external: true },
      { label: 'System Architecture', href: '/about' },
    ],
  },
  {
    heading: t('footer.company'),
    links: [
      { label: t('nav.about'), href: '/about' },
      { label: t('nav.contact'), href: '/contact' },
      { label: t('footer.privacy'), href: '/privacy' },
      { label: t('footer.terms'), href: '/terms' },
      { label: 'Human-Readable Sitemap', href: '/sitemap' },
    ],
  },
];

const socials = [
  { icon: 'github', label: 'GitHub', href: 'https://github.com/girishlade111' },
  { icon: 'linkedin', label: 'LinkedIn', href: 'https://www.linkedin.com/in/girish-lade/' },
  { icon: 'instagram', label: 'Instagram', href: 'https://www.instagram.com/girish_lade_/' },
];
---

<footer class="border-t border-border bg-surface text-foreground transition-colors mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-12 pb-12 border-b border-border">
      {/* Brand & Pitch column */}
      <div class="lg:col-span-2 flex flex-col justify-between">
        <div class="space-y-4">
          <a href={homeHref} class="flex items-center gap-2.5 group">
            <img
              src="/logo.png"
              alt="LadeStack Logo"
              class="w-7 h-7 object-contain transition-transform group-hover:scale-105"
              width="28"
              height="28"
              loading="lazy"
              decoding="async"
            />
            <span class="text-lg font-semibold tracking-tight text-foreground">LadeStack</span>
          </a>
          <p class="text-sm text-muted-foreground leading-relaxed max-w-sm">
            {t('footer.tagline')}
          </p>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border bg-surface-muted text-xs text-muted-foreground font-mono">
            <span class="h-2 w-2 rounded-full bg-brand"></span>
            {t('footer.status')}
          </div>
        </div>

        {/* Engineering Dispatch & Direct Contact */}
        <div class="mt-8">
          <p class="text-xs font-semibold text-foreground uppercase tracking-wider mb-2.5">
            Engineering Dispatch
          </p>
          <p class="text-xs text-muted-foreground leading-relaxed max-w-sm mb-3">
            {t('footer.emailPrompt')}
          </p>
          <a
            href="mailto:admin@ladestack.in"
            class="inline-flex items-center gap-2 text-xs font-medium text-brand hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded"
          >
            <Icon name="mail" class="w-3.5 h-3.5" />
            <span>admin@ladestack.in</span>
            <Icon name="arrow-up-right" class="w-3 h-3" />
          </a>
        </div>
      </div>

      {/* Nav columns */}
      {
        navColumns.map((col) => (
          <div>
            <p class="text-xs font-semibold text-foreground uppercase tracking-wider mb-4">
              {col.heading}
            </p>
            <ul class="space-y-2.5 text-sm">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.external ? link.href : getLocalizedPath(link.href, locale)}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                    class="text-muted-foreground hover:text-foreground transition-colors inline-flex items-center gap-1.5"
                  >
                    <span>{link.label}</span>
                    {link.external && <Icon name="arrow-up-right" class="w-3 h-3 text-border" />}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {/* Bottom row */}
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted-foreground">
      <div class="flex flex-wrap items-center gap-3">
        <span>© {new Date().getFullYear()} Lade Stack. Built by Girish Lade. {t('footer.rights')}</span>
        <span>·</span>
        <a href={getLocalizedPath('/sitemap', locale)} class="hover:text-foreground underline underline-offset-4">Sitemap</a>
        <span>·</span>
        <button
          type="button"
          data-action="open-preferences"
          class="hover:text-foreground underline underline-offset-4 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand cursor-pointer"
        >
          {consentT.persistentTrigger}
        </button>
      </div>

      <div class="flex items-center gap-2">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="p-2 text-muted-foreground hover:text-foreground transition-colors rounded-lg hover:bg-surface-muted inline-flex items-center justify-center"
            >
              <Icon name={s.icon} class="w-4 h-4" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
