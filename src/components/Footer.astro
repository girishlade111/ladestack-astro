---
/**
 * Footer.astro
 * Unified brand footer with structured columns, status badge,
 * accessible newsletter input, sitemap link, and social channels.
 */
import Icon from './Icon.astro';

const navColumns = [
  {
    heading: 'Platform',
    links: [
      { label: 'AI Code Studio', href: '/ai-code-viewer-ai' },
      { label: 'LS PDF Toolkit (17-in-1)', href: 'https://pdf.ladestack.in/', external: true },
      { label: 'LS Image Compressor', href: 'https://img.ladestack.in/', external: true },
      { label: 'Swift Resume Builder', href: 'https://resume.ladestack.in/', external: true },
      { label: 'Bharat Land Converter', href: 'https://land.ladestack.in/', external: true },
      { label: 'All Products & Tools', href: '/apps' },
    ],
  },
  {
    heading: 'Developers',
    links: [
      { label: 'Documentation', href: '/docs' },
      { label: 'API Reference', href: '/docs' },
      { label: 'Engineering Blog', href: '/blog' },
      { label: 'GitHub Repository', href: 'https://github.com/girishlade111', external: true },
      { label: 'System Architecture', href: '/about' },
    ],
  },
  {
    heading: 'Company & Legal',
    links: [
      { label: 'About Lade Stack', href: '/about' },
      { label: 'Contact Support', href: '/contact' },
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms of Service', href: '/terms' },
      { label: 'Human-Readable Sitemap', href: '/sitemap' },
    ],
  },
];

const socials = [
  { icon: 'github', label: 'GitHub', href: 'https://github.com/girishlade111' },
  { icon: 'linkedin', label: 'LinkedIn', href: 'https://www.linkedin.com/in/girish-lade-075bba201/' },
  { icon: 'instagram', label: 'Instagram', href: 'https://www.instagram.com/girish_lade_/' },
];
---

<footer class="border-t border-border bg-surface text-foreground transition-colors mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-12 pb-12 border-b border-border">
      {/* Brand & Pitch column */}
      <div class="lg:col-span-2 flex flex-col justify-between">
        <div class="space-y-4">
          <a href="/" class="flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-lg bg-brand flex items-center justify-center text-brand-foreground shadow-soft">
              <Icon name="code-2" class="w-4 h-4" />
            </div>
            <span class="text-lg font-semibold tracking-tight text-foreground">Lade Stack</span>
          </a>
          <p class="text-sm text-muted-foreground leading-relaxed max-w-sm">
            High-performance developer utilities and AI tools. Engineered for client-side privacy, instant execution, and zero usage paywalls.
          </p>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border bg-surface-muted text-xs text-muted-foreground font-mono">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            All tools operational
          </div>
        </div>

        {/* Newsletter / Changelog */}
        <div class="mt-8">
          <p class="text-xs font-semibold text-foreground uppercase tracking-wider mb-2.5">
            Engineering Dispatch
          </p>
          <form class="flex gap-2 max-w-sm" onsubmit="event.preventDefault(); alert('Subscribed! Thank you.');">
            <input
              type="email"
              required
              placeholder="developer@company.com"
              aria-label="Email address for engineering updates"
              class="w-full text-xs h-9 px-3 rounded-lg border border-border bg-background text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
            />
            <button
              type="submit"
              class="h-9 px-3.5 text-xs font-medium bg-brand text-brand-foreground hover:bg-brand-hover rounded-lg transition-colors whitespace-nowrap"
            >
              Subscribe
            </button>
          </form>
        </div>
      </div>

      {/* Nav columns */}
      {
        navColumns.map((col) => (
          <div>
            <p class="text-xs font-semibold text-foreground uppercase tracking-wider mb-4">
              {col.heading}
            </p>
            <ul class="space-y-2.5 text-sm">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                    class="text-muted-foreground hover:text-foreground transition-colors inline-flex items-center gap-1.5"
                  >
                    <span>{link.label}</span>
                    {link.external && <Icon name="arrow-up-right" class="w-3 h-3 text-border" />}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {/* Bottom row */}
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted-foreground">
      <div class="flex items-center gap-3">
        <span>© {new Date().getFullYear()} Lade Stack. Built by Girish Lade.</span>
        <span>·</span>
        <a href="/sitemap" class="hover:text-foreground underline underline-offset-4">Sitemap</a>
      </div>

      <div class="flex items-center gap-4">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="p-1.5 text-muted-foreground hover:text-foreground transition-colors rounded-md hover:bg-surface-muted"
            >
              <Icon name={s.icon} class="w-4 h-4" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
