---
/**
 * Impact.astro — 1:1 port of the source ImpactSection.tsx.
 * Hero stat cards (final counter values), tabbed feature-impact panel with
 * metric bars, SVG arc-ring summary, milestone timeline. Tab switching via
 * inline script; animated fills render at final state.
 */
import Icon from './Icon.astro';

const heroStats = [
  { value: '10x', label: 'Faster Development', sub: 'vs. manual coding', icon: 'zap', color: '#6E8F6A', bg: 'from-[#6E8F6A]/10 to-transparent', border: 'border-[#6E8F6A]/20' },
  { value: '8K+', label: 'Active Developers', sub: 'worldwide, growing daily', icon: 'users', color: '#4ec2e8', bg: 'from-[#4ec2e8]/10 to-transparent', border: 'border-[#4ec2e8]/20' },
  { value: '99.9%', label: 'Platform Uptime', sub: 'enterprise-grade SLA', icon: 'trending-up', color: '#e8a64e', bg: 'from-[#e8a64e]/10 to-transparent', border: 'border-[#e8a64e]/20' },
  { value: '98%', label: 'Developer Satisfaction', sub: 'happiness score', icon: 'heart', color: '#e87070', bg: 'from-[#e87070]/10 to-transparent', border: 'border-[#e87070]/20' },
];

const featureImpact = [
  {
    tool: 'AI Code Editor', icon: 'code-2', color: '#6E8F6A',
    metrics: [
      { label: 'Code written by AI', value: 73 },
      { label: 'Bug reduction', value: 61 },
      { label: 'Review time saved', value: 55 },
    ],
  },
  {
    tool: 'API Tester', icon: 'zap', color: '#4ec2e8',
    metrics: [
      { label: 'Test coverage boost', value: 88 },
      { label: 'Manual effort cut', value: 79 },
      { label: 'Faster releases', value: 64 },
    ],
  },
  {
    tool: 'Doc Generator', icon: 'trending-up', color: '#e8a64e',
    metrics: [
      { label: 'Docs time reduced', value: 82 },
      { label: 'Accuracy improved', value: 91 },
      { label: 'Onboarding speed', value: 68 },
    ],
  },
];

const milestones = [
  { year: '2022', label: 'Founded', detail: 'Launched AI Code Editor beta with 500 early adopters.', color: '#6E8F6A' },
  { year: 'Q1 2023', label: '10K Devs', detail: 'First 10,000 active developers across 40 countries.', color: '#4ec2e8' },
  { year: 'Q3 2023', label: 'API Tester', detail: 'Released AI-powered API testing — 8K sign-ups in week one.', color: '#e8a64e' },
  { year: 'Q1 2024', label: '50K Devs', detail: 'Community hit 50,000 developers in 100+ countries.', color: '#e87070' },
  { year: '2024+', label: 'Full Suite', detail: 'Lade Suite: docs, builder, CLI & AI assistant unified.', color: '#b47ee8' },
];

const rings = [
  { label: 'Speed Boost', value: 92, color: '#6E8F6A' },
  { label: 'Uptime SLA', value: 99.9, color: '#4ec2e8' },
  { label: 'Satisfaction', value: 98, color: '#e87070' },
  { label: 'Global Reach', value: 85, color: '#b47ee8' },
];

const RING_SIZE = 60;
const RING_STROKE = 5;
const RING_R = (RING_SIZE - RING_STROKE) / 2;
const RING_CIRC = 2 * Math.PI * RING_R;
const ringOffset = (p: number) => RING_CIRC * (1 - Math.round(p) / 100);
---

<section class="relative py-24 md:py-36 bg-white dark:bg-black overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 dark:hidden">
      <div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-[radial-gradient(ellipse,_rgba(110,143,106,0.07),_transparent_60%)]"></div>
      <div class="absolute bottom-0 left-0 w-[500px] h-[400px] bg-[radial-gradient(ellipse,_rgba(78,194,232,0.05),_transparent_60%)]"></div>
      <div class="absolute bottom-0 right-0 w-[500px] h-[400px] bg-[radial-gradient(ellipse,_rgba(232,118,112,0.05),_transparent_60%)]"></div>
    </div>
    <div class="absolute inset-0 hidden dark:block">
      <div class="absolute inset-0 bg-gradient-to-b from-black via-[#080808] to-black"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-[radial-gradient(ellipse,_rgba(110,143,106,0.12),_transparent_60%)]"></div>
      <div class="absolute bottom-0 left-0 w-[600px] h-[400px] bg-[radial-gradient(ellipse,_rgba(78,194,232,0.06),_transparent_60%)]"></div>
      <div class="absolute bottom-0 right-0 w-[600px] h-[400px] bg-[radial-gradient(ellipse,_rgba(180,126,232,0.06),_transparent_60%)]"></div>
    </div>
    <div class="absolute inset-0 dot-pattern opacity-[0.35]"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-20">
      <div class="tag-pill inline-flex items-center gap-2 mb-5">
        <Icon name="bar-chart-3" class="w-3.5 h-3.5" />
        Impact & Results
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-neutral-900 dark:text-white mb-5">
        Numbers that{' '}
        <span class="relative inline-block">
          <span class="text-[#6E8F6A]">speak</span>
          <span class="absolute -bottom-1 left-0 right-0 h-[3px] bg-[#6E8F6A]/35 rounded-full"></span>
        </span>{' '}
        for themselves
      </h2>
      <p class="text-neutral-500 dark:text-neutral-400 text-lg max-w-xl mx-auto leading-relaxed">
        Real impact on real developers — measurable, repeatable, and growing every day.
      </p>
    </div>

    {/* Hero stat cards */}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-16">
      {
        heroStats.map((stat) => (
          <div class={`group relative overflow-hidden rounded-2xl border bg-white dark:bg-white/[0.02] ${stat.border} dark:border-white/[0.07] p-6 flex flex-col gap-3 cursor-default hover:-translate-y-1.5 transition-transform duration-300`}>
            <div class={`absolute inset-0 bg-gradient-to-br ${stat.bg} opacity-60 pointer-events-none`}></div>
            <div class="relative z-10 w-9 h-9 rounded-xl flex items-center justify-center" style={`background: ${stat.color}18; color: ${stat.color};`}>
              <Icon name={stat.icon} class="w-4 h-4" />
            </div>
            <div class="relative z-10">
              <div class="text-3xl md:text-4xl font-bold tracking-tight text-neutral-900 dark:text-white leading-none">
                {stat.value}
              </div>
              <p class="text-sm font-semibold text-neutral-800 dark:text-neutral-200 mt-2 leading-tight">{stat.label}</p>
              <p class="text-xs text-neutral-500 dark:text-neutral-500 mt-0.5">{stat.sub}</p>
            </div>
            <div class="absolute top-4 right-4 z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-200" style={`color: ${stat.color};`}>
              <Icon name="arrow-up-right" class="w-4 h-4" />
            </div>
            <div class="absolute bottom-0 left-0 right-0 h-[2px] rounded-b-2xl origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300" style={`background: ${stat.color};`}></div>
          </div>
        ))
      }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-5 mb-16">
      {/* Tabbed impact panel */}
      <div class="lg:col-span-3">
        <div class="rounded-2xl bg-white dark:bg-white/[0.02] border border-[#E6E6E6] dark:border-white/[0.07] overflow-hidden" data-impact-panel>
          <div class="flex border-b border-[#E6E6E6] dark:border-white/[0.06]" role="tablist">
            {
              featureImpact.map((f, i) => (
                <button
                  type="button"
                  role="tab"
                  data-impact-tab={i}
                  class={`flex-1 flex items-center justify-center gap-2 px-4 py-4 text-xs font-medium transition-all duration-200 relative ${i === 0 ? 'text-neutral-900 dark:text-white' : 'text-neutral-500 dark:text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300'}`}
                >
                  <span style={i === 0 ? `color: ${f.color};` : undefined} class="flex items-center gap-2">
                    <Icon name={f.icon} class="w-3.5 h-3.5" />
                    <span class="hidden sm:inline">{f.tool}</span>
                  </span>
                  {i === 0 && (
                    <span data-impact-underline class="absolute bottom-0 left-0 right-0 h-[2px] rounded-t-full" style={`background: ${f.color};`}></span>
                  )}
                </button>
              ))
            }
          </div>
          {
            featureImpact.map((f, i) => (
              <div data-impact-body={i} class={`p-6 ${i === 0 ? '' : 'hidden'}`}>
                <div class="flex items-center gap-3 mb-6">
                  <div class="w-8 h-8 rounded-lg flex items-center justify-center" style={`background: ${f.color}18; color: ${f.color};`}>
                    <Icon name={f.icon} class="w-4 h-4" />
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-neutral-900 dark:text-white">{f.tool}</p>
                    <p class="text-[11px] text-neutral-500 dark:text-neutral-500">Measured impact on developer workflow</p>
                  </div>
                </div>
                <div class="flex flex-col gap-4">
                  {f.metrics.map((m) => (
                    <div class="flex flex-col gap-1.5">
                      <div class="flex items-center justify-between">
                        <span class="text-[11px] text-neutral-600 dark:text-neutral-400">{m.label}</span>
                        <span class="text-[11px] font-semibold" style={`color: ${f.color};`}>{m.value}%</span>
                      </div>
                      <div class="h-1.5 rounded-full bg-[#F0F0F0] dark:bg-white/[0.06] overflow-hidden">
                        <div class="h-full rounded-full" style={`background: linear-gradient(90deg, ${f.color}99, ${f.color}); width: ${m.value}%;`}></div>
                      </div>
                    </div>
                  ))}
                </div>
                <p class="text-[10px] text-neutral-400 dark:text-neutral-600 mt-5">
                  Based on developer surveys across 5,000+ active users.
                </p>
              </div>
            ))
          }
        </div>
      </div>

      {/* Arc summary + banner */}
      <div class="lg:col-span-2 flex flex-col gap-4">
        <div class="rounded-2xl bg-white dark:bg-white/[0.02] border border-[#E6E6E6] dark:border-white/[0.07] p-6 flex-1">
          <p class="text-xs font-semibold text-neutral-900 dark:text-white mb-1">Performance at a glance</p>
          <p class="text-[11px] text-neutral-500 dark:text-neutral-500 mb-6">Core metrics across all products</p>
          <div class="grid grid-cols-2 gap-5">
            {
              rings.map((m) => (
                <div class="flex flex-col items-center gap-2">
                  <div class="relative flex-shrink-0" style={`width: ${RING_SIZE}px; height: ${RING_SIZE}px;`}>
                    <svg width={RING_SIZE} height={RING_SIZE} style="transform: rotate(-90deg);">
                      <circle cx={RING_SIZE / 2} cy={RING_SIZE / 2} r={RING_R} fill="none" stroke={`${m.color}20`} stroke-width={RING_STROKE} />
                      <circle
                        cx={RING_SIZE / 2}
                        cy={RING_SIZE / 2}
                        r={RING_R}
                        fill="none"
                        stroke={m.color}
                        stroke-width={RING_STROKE}
                        stroke-linecap="round"
                        stroke-dasharray={RING_CIRC}
                        stroke-dashoffset={ringOffset(m.value)}
                      />
                    </svg>
                    <div class="absolute inset-0 flex items-center justify-center">
                      <span class="text-[9px] font-bold" style={`color: ${m.color};`}>{Math.round(m.value)}%</span>
                    </div>
                  </div>
                  <span class="text-[10px] text-neutral-500 dark:text-neutral-500 text-center leading-tight">{m.label}</span>
                </div>
              ))
            }
          </div>
        </div>
        <div class="relative overflow-hidden rounded-2xl bg-[#6E8F6A] p-5">
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_120%_120%_at_100%_0%,_rgba(255,255,255,0.10),_transparent_60%)]"></div>
          <div class="relative z-10">
            <div class="flex items-center gap-2 mb-2">
              <Icon name="globe" class="w-4 h-4 text-white/80" />
              <span class="text-white text-xs font-semibold">Growing Fast</span>
            </div>
            <p class="text-white/70 text-[11px] leading-relaxed">
              New developer joins every <span class="text-white font-semibold">8 minutes</span>. 100+ countries.
              Zero enterprise pricing.
            </p>
          </div>
        </div>
      </div>
    </div>

    {/* Timeline divider */}
    <div class="flex items-center gap-5 mb-14">
      <div class="flex-1 h-px bg-gradient-to-r from-transparent via-[#E6E6E6] dark:via-white/[0.07] to-transparent"></div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <div class="w-1.5 h-1.5 rounded-full bg-[#6E8F6A]"></div>
        <span class="text-[11px] font-medium text-neutral-400 dark:text-neutral-600 uppercase tracking-widest">Our journey</span>
        <div class="w-1.5 h-1.5 rounded-full bg-[#b47ee8]"></div>
      </div>
      <div class="flex-1 h-px bg-gradient-to-r from-transparent via-[#E6E6E6] dark:via-white/[0.07] to-transparent"></div>
    </div>

    {/* Milestones */}
    <div class="relative">
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-[#E6E6E6] dark:bg-white/[0.07] -translate-x-1/2" aria-hidden="true"></div>
      <div class="absolute left-4 md:left-1/2 top-0 w-px h-full bg-gradient-to-b from-[#6E8F6A] via-[#4ec2e8] to-[#b47ee8] origin-top" aria-hidden="true"></div>
      <div class="flex flex-col">
        {
          milestones.map((m, i) => {
            const isRight = i % 2 !== 0;
            return (
              <div class={`relative flex items-center gap-0 md:gap-8 py-6 pl-10 md:pl-0 ${isRight ? 'md:flex-row-reverse' : 'md:flex-row'}`}>
                <div class={`w-full md:w-[calc(50%-28px)] rounded-2xl bg-white dark:bg-white/[0.02] border border-[#E6E6E6] dark:border-white/[0.07] p-5 ${isRight ? 'md:text-left' : 'md:text-right'}`}>
                  <div class={`flex items-center gap-2 mb-2 ${isRight ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
                    <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full" style={`background: ${m.color}18; color: ${m.color};`}>
                      {m.year}
                    </span>
                    <span class="text-sm font-bold text-neutral-900 dark:text-white">{m.label}</span>
                  </div>
                  <p class="text-xs text-neutral-500 dark:text-neutral-500 leading-relaxed">{m.detail}</p>
                </div>
                <div class="absolute left-4 md:left-1/2 -translate-x-1/2 z-10">
                  <div
                    class="w-4 h-4 rounded-full border-2 border-white dark:border-[#0a0a0a] flex items-center justify-center"
                    style={`background: ${m.color}; box-shadow: 0 0 0 4px ${m.color}25, 0 0 12px ${m.color}50;`}
                  ></div>
                </div>
                <div class="hidden md:block md:w-[calc(50%-28px)]"></div>
              </div>
            );
          })
        }
      </div>
    </div>

    <div class="w-full flex justify-center py-8 mt-8">
      <div class="h-px bg-gradient-to-r from-transparent via-border to-transparent" style="width: 60%;"></div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var panel = document.querySelector('[data-impact-panel]');
    if (!panel) return;
    var tabs = Array.prototype.slice.call(panel.querySelectorAll('[data-impact-tab]'));
    var bodies = Array.prototype.slice.call(panel.querySelectorAll('[data-impact-body]'));
    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () {
        bodies.forEach(function (b, k) { b.classList.toggle('hidden', k !== i); });
        tabs.forEach(function (t, k) {
          var on = k === i;
          t.classList.toggle('text-neutral-900', on);
          t.classList.toggle('dark:text-white', on);
          t.classList.toggle('text-neutral-500', !on);
          var old = t.querySelector('[data-impact-underline]');
          if (old) old.remove();
          if (on) {
            var color = ['#6E8F6A', '#4ec2e8', '#e8a64e'][k];
            var u = document.createElement('span');
            u.setAttribute('data-impact-underline', '');
            u.className = 'absolute bottom-0 left-0 right-0 h-[2px] rounded-t-full';
            u.style.background = color;
            t.appendChild(u);
            var wrap = t.querySelector('span');
            if (wrap) wrap.style.color = color;
          } else {
            var w = t.querySelector('span');
            if (w) w.style.color = '';
          }
        });
      });
    });
  })();
</script>
