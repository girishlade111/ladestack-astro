---
/**
 * src/components/pages/TermsPage.astro
 * Reusable, fully localized Terms of Service page component.
 * Supports all 9 languages with native typography, full accessibility,
 * self-referencing canonicals, reciprocal hreflang tags, and authoritative legal notice.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import Badge from '../ui/Badge.astro';
import { LOCALES, LOCALE_CONFIG, type Locale } from '../../i18n/config';
import { getHreflangLinks, getLocalizedPath } from '../../i18n/utils';
import { getTermsData } from '../../i18n/pages/terms';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = getTermsData(locale);
const canonicalUrl = `https://ladestack.in${getLocalizedPath('/terms', locale)}`;
const hreflangs = getHreflangLinks('/terms', LOCALES);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: data.seo.title,
    description: data.seo.description,
    url: canonicalUrl,
    inLanguage: locale,
    publisher: {
      '@type': 'Organization',
      name: 'LadeStack',
      url: 'https://ladestack.in',
    },
  },
];
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  canonical={canonicalUrl}
  locale={locale}
  hreflangs={hreflangs}
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: data.seo.ogTitle,
    description: data.seo.ogDescription,
    url: canonicalUrl,
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: data.seo.ogTitle,
    description: data.seo.ogDescription,
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background text-foreground">
    {/* Header */}
    <section class="pt-20 pb-12 border-b border-border bg-surface-muted/20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Badge variant="brand" class="mb-3">{data.header.badge}</Badge>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-foreground">
          {data.header.title}
        </h1>
        <p class="mt-3 text-xs font-mono text-muted-foreground">
          {data.header.lastUpdated} · {data.header.effectiveDate}
        </p>
      </div>
    </section>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      {/* Disclaimer Alert */}
      <div class="mb-10 rounded-xl border border-brand/30 bg-brand/5 p-4 sm:p-5 text-xs sm:text-sm text-foreground/90 leading-relaxed">
        <div class="flex items-start gap-3">
          <Icon name="info" class="w-5 h-5 text-brand shrink-0 mt-0.5" />
          <div>
            <p class="font-semibold text-foreground mb-1">{data.disclaimer.title}</p>
            <p class="text-muted-foreground">{data.disclaimer.text}</p>
          </div>
        </div>
      </div>

      {/* Main Sections */}
      <div class="space-y-8 text-sm sm:text-base leading-relaxed text-muted-foreground max-w-[72ch] mx-auto">
        {
          data.sections.map((section) => (
            <div class="rounded-xl border border-border bg-surface p-6 sm:p-8 space-y-4 shadow-soft">
              <h2 class="text-lg font-bold text-foreground">{section.title}</h2>
              {section.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          ))
        }

        {/* Contact Note */}
        <div class="rounded-xl border border-border bg-surface p-6 sm:p-8 space-y-3 shadow-soft">
          <h2 class="text-lg font-bold text-foreground">{data.contactNote.title}</h2>
          <p>{data.contactNote.text}</p>
          <p>
            <a href={`mailto:${data.contactNote.email}`} class="font-mono text-xs font-semibold text-brand hover:underline">
              {data.contactNote.email}
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
