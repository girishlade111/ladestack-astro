---
/**
 * src/components/pages/GbCoderPage.astro
 * Reusable, fully localized GB Coder flagship product showcase component.
 * Supports all 9 languages with native typography, full accessibility,
 * self-referencing canonicals, and reciprocal hreflang tags.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Accordion from '../ui/Accordion.astro';
import AccordionItem from '../ui/AccordionItem.astro';
import { LOCALES, LOCALE_CONFIG, type Locale } from '../../i18n/config';
import { getHreflangLinks, getLocalizedPath } from '../../i18n/utils';
import { getGbCoderData } from '../../i18n/pages/gb-coder';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = getGbCoderData(locale);
const canonicalUrl = `https://ladestack.in${getLocalizedPath('/gb-coder', locale)}`;
const hreflangs = getHreflangLinks('/gb-coder', LOCALES);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'GB Coder',
    operatingSystem: 'Any (Web Browser)',
    applicationCategory: 'DeveloperApplication',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    author: {
      '@type': 'Person',
      name: 'Girish Lade',
      url: 'https://github.com/girishlade111',
    },
    publisher: {
      '@type': 'Organization',
      name: 'LadeStack',
      url: 'https://ladestack.in',
    },
    url: canonicalUrl,
    inLanguage: locale,
    description: data.seo.description,
  },
];
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  canonical={canonicalUrl}
  locale={locale}
  hreflangs={hreflangs}
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: data.seo.ogTitle,
    description: data.seo.ogDescription,
    url: canonicalUrl,
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: data.seo.ogTitle,
    description: data.seo.ogDescription,
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background text-foreground">
    {/* ── HERO SECTION ── */}
    <section class="relative pt-20 pb-20 sm:pt-28 sm:pb-32 overflow-hidden border-b border-border bg-surface-muted/20">
      <div class="pointer-events-none absolute inset-0 hero-glow -z-10" aria-hidden="true"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-brand/30 bg-brand/10 text-xs font-mono text-brand mb-6">
          <span class="w-2 h-2 rounded-full bg-brand"></span>
          {data.hero.badge}
        </div>

        <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-foreground text-balance leading-[1.08] max-w-4xl mx-auto">
          {data.hero.titleLine} <span class="text-brand">{data.hero.titleHighlight}</span>
        </h1>

        <p class="mt-6 text-base sm:text-xl text-muted-foreground max-w-3xl mx-auto leading-relaxed text-pretty">
          {data.hero.description}
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <Button href="https://code.ladestack.in/" target="_blank" size="lg" class="w-full sm:w-auto">
            <span>{data.hero.ctaStudio}</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </Button>
          <Button href="https://code.ladestack.in/app/projects" target="_blank" variant="outline" size="lg" class="w-full sm:w-auto">
            <span>{data.hero.ctaProjects}</span>
            <Icon name="arrow-up-right" class="w-4 h-4 text-muted-foreground" />
          </Button>
        </div>

        {/* Trust Badges */}
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs text-muted-foreground font-mono">
          {data.hero.trustBadges.map((badge, idx) => (
            <span class="inline-flex items-center gap-1.5">
              <Icon name={idx === 0 ? 'shield-check' : idx === 1 ? 'zap' : 'gift'} class="w-4 h-4 text-brand" />
              {badge}
            </span>
          ))}
        </div>
      </div>
    </section>

    {/* ── TWO DEDICATED ENVIRONMENTS ── */}
    <section class="py-16 sm:py-24 border-b border-border bg-background">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow={data.environments.eyebrow}
          title={data.environments.title}
          description={data.environments.description}
        />

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {/* Card 1: Static Prototyping */}
          <div class="rounded-2xl border border-border bg-surface p-8 shadow-card flex flex-col justify-between relative overflow-hidden">
            <div>
              <div class="flex items-center justify-between mb-4">
                <Badge variant="outline" size="md">{data.environments.staticCard.badge}</Badge>
                <span class="text-xs font-mono text-muted-foreground">{data.environments.staticCard.engine}</span>
              </div>

              <h3 class="text-2xl font-bold text-foreground">{data.environments.staticCard.title}</h3>
              <p class="mt-3 text-sm text-muted-foreground leading-relaxed">
                {data.environments.staticCard.description}
              </p>

              <div class="mt-6 space-y-2.5">
                {data.environments.staticCard.features.map((feat) => (
                  <div class="flex items-center gap-2 text-xs text-foreground">
                    <Icon name="check-circle-2" class="w-4 h-4 text-brand shrink-0" />
                    <span>{feat}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="mt-8 pt-6 border-t border-border flex items-center justify-between">
              <span class="text-xs font-mono text-muted-foreground">{data.environments.staticCard.status}</span>
              <a href="https://code.ladestack.in/" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-brand hover:underline inline-flex items-center gap-1">
                <span>{data.environments.staticCard.cta}</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>

          {/* Card 2: Advanced WebContainer IDE */}
          <div class="rounded-2xl border border-brand/50 bg-surface p-8 shadow-card flex flex-col justify-between relative overflow-hidden">
            <div class="absolute -top-12 -right-12 w-32 h-32 rounded-full bg-brand/10 blur-2xl pointer-events-none"></div>

            <div>
              <div class="flex items-center justify-between mb-4">
                <Badge variant="brand" size="md">{data.environments.webContainerCard.badge}</Badge>
                <span class="text-xs font-mono text-brand font-semibold">{data.environments.webContainerCard.engine}</span>
              </div>

              <h3 class="text-2xl font-bold text-foreground">{data.environments.webContainerCard.title}</h3>
              <p class="mt-3 text-sm text-muted-foreground leading-relaxed">
                {data.environments.webContainerCard.description}
              </p>

              <div class="mt-6 space-y-2.5">
                {data.environments.webContainerCard.features.map((feat) => (
                  <div class="flex items-center gap-2 text-xs text-foreground">
                    <Icon name="check-circle-2" class="w-4 h-4 text-brand shrink-0" />
                    <span>{feat}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="mt-8 pt-6 border-t border-border flex items-center justify-between">
              <span class="text-xs font-mono text-muted-foreground">{data.environments.webContainerCard.status}</span>
              <a href="https://code.ladestack.in/app/projects" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-brand hover:underline inline-flex items-center gap-1">
                <span>{data.environments.webContainerCard.cta}</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── CORE CAPABILITIES GRID ── */}
    <section class="py-16 sm:py-24 border-b border-border bg-surface-muted/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow={data.pillars.eyebrow}
          title={data.pillars.title}
          description={data.pillars.description}
        />

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {data.pillars.items.map((feat) => (
            <div class="rounded-xl border border-border bg-surface p-6 shadow-soft flex flex-col justify-between hover:border-brand/40 transition-colors">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <div class="w-10 h-10 rounded-lg bg-brand/10 text-brand flex items-center justify-center">
                    <Icon name={feat.icon} class="w-5 h-5" />
                  </div>
                  <Badge variant="outline" size="sm">
                    {feat.badge}
                  </Badge>
                </div>
                <h3 class="text-lg font-bold text-foreground">
                  {feat.title}
                </h3>
                <p class="mt-2 text-xs text-muted-foreground leading-relaxed">
                  {feat.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── BROWSER SUPPORT TRANSPARENCY ── */}
    <section class="py-16 sm:py-24 border-b border-border bg-background">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-2xl border border-border bg-surface p-8 sm:p-12 shadow-card">
          <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
            <div class="space-y-3 max-w-xl">
              <span class="text-xs font-mono font-semibold uppercase tracking-wider text-brand">
                {data.guardrails.eyebrow}
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight">
                {data.guardrails.title}
              </h2>
              <p class="text-sm text-muted-foreground leading-relaxed">
                {data.guardrails.desc1}
              </p>
              <p class="text-sm text-muted-foreground leading-relaxed">
                {data.guardrails.desc2}
              </p>
            </div>

            <div class="w-full lg:w-72 p-5 rounded-xl border border-border bg-surface-muted/50 space-y-3 font-mono text-xs">
              <p class="font-semibold text-foreground uppercase tracking-wider text-[11px]">
                {data.guardrails.supportedHeading}
              </p>
              <div class="space-y-2 text-muted-foreground">
                {data.guardrails.environments.map((env) => (
                  <div class="flex items-center justify-between">
                    <span>{env.browser}</span>
                    <span class={env.highlight ? 'text-brand font-semibold' : 'text-foreground font-semibold'}>
                      {env.support}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── FAQ SECTION ── */}
    <section class="py-16 sm:py-24 border-b border-border bg-surface-muted/20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow={data.faqs.eyebrow}
          title={data.faqs.title}
          description={data.faqs.description}
        />

        <Accordion>
          {data.faqs.items.map((faq, index) => (
            <AccordionItem question={faq.q} open={index === 0}>
              <p>{faq.a}</p>
            </AccordionItem>
          ))}
        </Accordion>
      </div>
    </section>

    {/* ── BOTTOM CTA ── */}
    <section class="py-16 sm:py-24 bg-background">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
        <h2 class="text-3xl sm:text-4xl font-bold text-foreground tracking-tight">
          {data.cta.title}
        </h2>
        <p class="text-base sm:text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed">
          {data.cta.description}
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
          <Button href="https://code.ladestack.in/app/projects" target="_blank" size="lg" class="w-full sm:w-auto">
            <span>{data.cta.launchStudioBtn}</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </Button>
          <Button href={getLocalizedPath('/apps', locale)} variant="outline" size="lg" class="w-full sm:w-auto">
            <span>{data.cta.exploreAllBtn}</span>
            <Icon name="layers" class="w-4 h-4 text-muted-foreground" />
          </Button>
        </div>

        <p class="text-xs font-mono text-muted-foreground pt-4">
          {data.cta.footerTagline}
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
