---
/**
 * src/components/pages/DocsPage.astro
 * Reusable, fully localized Documentation & Guides page component.
 * Supports all 9 languages with native typography, full accessibility,
 * self-referencing canonicals, reciprocal hreflang tags, and interactive dialogs.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import { LOCALES, LOCALE_CONFIG, type Locale } from '../../i18n/config';
import { getHreflangLinks, getLocalizedPath } from '../../i18n/utils';
import { getDocsData } from '../../i18n/pages/docs';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = getDocsData(locale);
const canonicalUrl = `https://ladestack.in${getLocalizedPath('/docs', locale)}`;
const hreflangs = getHreflangLinks('/docs', LOCALES);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    name: data.seo.title,
    description: data.seo.description,
    url: canonicalUrl,
    inLanguage: locale,
    publisher: {
      '@type': 'Organization',
      name: 'LadeStack',
      url: 'https://ladestack.in',
    },
  },
];
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  canonical={canonicalUrl}
  locale={locale}
  hreflangs={hreflangs}
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: data.seo.ogTitle,
    description: data.seo.ogDescription,
    url: canonicalUrl,
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: data.seo.ogTitle,
    description: data.seo.ogDescription,
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background">
    {/* Hero */}
    <section class="relative pt-20 pb-14 border-b border-border bg-surface-muted/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Badge variant="brand" class="mb-4">{data.hero.badge}</Badge>
        <h1 class="text-3xl sm:text-5xl font-bold text-foreground tracking-tight leading-tight">
          {data.hero.title}
        </h1>
        <p class="mt-4 text-base sm:text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed">
          {data.hero.description}
        </p>

        <div class="mt-8 max-w-md mx-auto relative">
          <Icon name="search" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground pointer-events-none" />
          <input
            type="text"
            data-docs-search
            placeholder={data.hero.searchPlaceholder}
            aria-label={data.hero.searchAriaLabel}
            class="w-full h-10 pl-10 pr-4 rounded-lg border border-border bg-surface text-xs sm:text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-brand transition"
          />
        </div>
      </div>
    </section>

    {/* Topic categories */}
    <section class="py-14 sm:py-20 border-b border-border bg-background">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-10 text-center sm:text-left">
          <h2 class="text-xl sm:text-2xl font-bold text-foreground">{data.categoriesSection.title}</h2>
          <p class="text-xs sm:text-sm text-muted-foreground mt-1">{data.categoriesSection.description}</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            data.categoriesSection.categories.map((cat) => (
              <button
                type="button"
                data-docs-cat={cat.id}
                data-search-text={`${cat.title} ${cat.description} ${cat.overview}`.toLowerCase()}
                class="text-left rounded-xl border border-border bg-surface p-6 shadow-soft hover:border-brand/40 hover:shadow-card transition-all duration-200 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
              >
                <div class="w-10 h-10 rounded-lg bg-brand/10 text-brand flex items-center justify-center mb-4 transition-transform group-hover:scale-105">
                  <Icon name={cat.icon} class="w-5 h-5" />
                </div>
                <h3 class="text-base font-semibold text-foreground mb-1 group-hover:text-brand transition-colors">
                  {cat.title}
                </h3>
                <p class="text-xs text-muted-foreground leading-relaxed mb-4">
                  {cat.description}
                </p>
                <span class="text-xs font-semibold text-brand inline-flex items-center gap-1">
                  <span>{data.categoriesSection.viewGuide}</span>
                  <Icon name="arrow-right" class="w-3.5 h-3.5" />
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    {/* Articles */}
    <section class="py-14 sm:py-20 border-b border-border bg-surface-muted/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
          <h2 class="text-xl sm:text-2xl font-bold text-foreground">{data.articlesSection.title}</h2>
          <p class="text-xs sm:text-sm text-muted-foreground mt-1">{data.articlesSection.description}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl">
          {
            data.articlesSection.articles.map((art) => (
              <div class="rounded-xl border border-border bg-surface p-6 shadow-soft flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between mb-3">
                    <Badge variant="brand" size="sm">{art.category}</Badge>
                    <span class="text-xs font-mono text-muted-foreground">{art.readTime}</span>
                  </div>
                  <h3 class="text-base font-semibold text-foreground mb-2">
                    {art.title}
                  </h3>
                  <p class="text-xs text-muted-foreground leading-relaxed mb-6">
                    {art.intro}
                  </p>
                </div>
                <button
                  type="button"
                  data-docs-open-article={art.id}
                  class="text-xs font-semibold text-brand hover:underline inline-flex items-center gap-1 self-start"
                >
                  <span>{data.articlesSection.readArticle}</span>
                  <Icon name="arrow-right" class="w-3.5 h-3.5" />
                </button>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Platform Changelog */}
    <section class="py-14 sm:py-20 bg-background">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8 text-center sm:text-left">
          <h2 class="text-xl sm:text-2xl font-bold text-foreground">{data.changelogSection.title}</h2>
          <p class="text-xs sm:text-sm text-muted-foreground mt-1">{data.changelogSection.description}</p>
        </div>

        <div class="rounded-xl border border-border bg-surface divide-y divide-border overflow-hidden">
          {
            data.changelogSection.items.map((c) => (
              <div class="p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <span class="font-mono text-xs font-bold text-brand bg-brand/10 px-2 py-0.5 rounded">
                    {c.version}
                  </span>
                  <span class="text-sm font-semibold text-foreground">{c.type}</span>
                  <span class="text-xs font-mono text-muted-foreground">{c.date}</span>
                </div>
                <p class="text-xs text-muted-foreground sm:max-w-md">{c.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  {/* Category Dialogs */}
  {
    data.categoriesSection.categories.map((category) => (
      <dialog data-docs-dialog={category.id} class="max-w-2xl w-[calc(100%-2rem)] max-h-[85vh] overflow-y-auto rounded-2xl border border-border bg-surface p-6 sm:p-8 text-foreground shadow-elevated backdrop:bg-black/60">
        <div class="flex items-center justify-between pb-4 border-b border-border">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-brand/10 text-brand flex items-center justify-center">
              <Icon name={category.icon} class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-lg font-bold">{category.title}</h3>
              <p class="text-xs text-muted-foreground">{category.description}</p>
            </div>
          </div>
          <form method="dialog">
            <button type="submit" class="p-1 text-muted-foreground hover:text-foreground rounded" aria-label="Close dialog">
              <Icon name="x" class="w-4 h-4" />
            </button>
          </form>
        </div>

        <div class="mt-6 space-y-6">
          <div class="p-4 rounded-xl border border-border bg-background text-xs sm:text-sm leading-relaxed text-muted-foreground">
            {category.overview}
          </div>

          <div class="space-y-4">
            {category.sections.map((sec) => (
              <div class="rounded-lg border border-border bg-surface-muted/40 p-4">
                <h4 class="text-sm font-semibold text-foreground mb-1.5">{sec.title}</h4>
                <p class="text-xs text-muted-foreground leading-relaxed">{sec.content}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-border flex justify-end">
          <form method="dialog">
            <Button type="submit" variant="outline" size="sm">{data.categoriesSection.closeGuide}</Button>
          </form>
        </div>
      </dialog>
    ))
  }

  {/* Article Dialogs */}
  {
    data.articlesSection.articles.map((art) => (
      <dialog data-docs-article-dialog={art.id} class="max-w-2xl w-[calc(100%-2rem)] max-h-[85vh] overflow-y-auto rounded-2xl border border-border bg-surface p-6 sm:p-8 text-foreground shadow-elevated backdrop:bg-black/60">
        <div class="flex items-center justify-between pb-4 border-b border-border">
          <div>
            <Badge variant="brand" size="sm">{art.category}</Badge>
            <h3 class="text-lg font-bold mt-2">{art.title}</h3>
          </div>
          <form method="dialog">
            <button type="submit" class="p-1 text-muted-foreground hover:text-foreground rounded" aria-label="Close dialog">
              <Icon name="x" class="w-4 h-4" />
            </button>
          </form>
        </div>

        <div class="mt-6 space-y-4">
          <p class="text-sm text-foreground leading-relaxed">{art.intro}</p>
          <div class="space-y-2">
            <p class="text-xs font-mono font-semibold uppercase tracking-wider text-muted-foreground">{data.articlesSection.stepsTitle}</p>
            {art.steps.map((st, i) => (
              <div class="flex items-center gap-3 p-3 rounded-lg border border-border bg-background text-xs">
                <span class="w-5 h-5 rounded-md bg-brand/10 text-brand font-mono font-bold flex items-center justify-center shrink-0">
                  {i + 1}
                </span>
                <span class="text-foreground">{st}</span>
              </div>
            ))}
          </div>
          <div class="p-3.5 rounded-lg border border-brand/20 bg-brand/5 text-xs text-muted-foreground">
            <span class="font-semibold text-foreground">{data.articlesSection.summaryLabel}</span> {art.summary}
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-border flex justify-end">
          <form method="dialog">
            <Button type="submit" variant="outline" size="sm">{data.articlesSection.closeArticle}</Button>
          </form>
        </div>
      </dialog>
    ))
  }

  <script is:inline>
    (function () {
      function initDocs() {
        var searchInput = document.querySelector('[data-docs-search]');
        if (searchInput && !searchInput.__docsBound) {
          searchInput.__docsBound = true;
          searchInput.addEventListener('input', function (e) {
            var q = (e.target.value || '').toLowerCase().trim();
            document.querySelectorAll('[data-docs-cat]').forEach(function (card) {
              var text = (card.getAttribute('data-search-text') || '').toLowerCase();
              if (!q || text.indexOf(q) !== -1) {
                card.style.display = '';
              } else {
                card.style.display = 'none';
              }
            });
          });
        }

        document.querySelectorAll('[data-docs-cat]').forEach(function (btn) {
          if (btn.__docsBound) return;
          btn.__docsBound = true;
          btn.addEventListener('click', function () {
            var d = document.querySelector('[data-docs-dialog="' + btn.getAttribute('data-docs-cat') + '"]');
            if (d && d.showModal) d.showModal();
          });
        });

        document.querySelectorAll('[data-docs-open-article]').forEach(function (btn) {
          if (btn.__docsBound) return;
          btn.__docsBound = true;
          btn.addEventListener('click', function () {
            var d = document.querySelector('[data-docs-article-dialog="' + btn.getAttribute('data-docs-open-article') + '"]');
            if (d && d.showModal) d.showModal();
          });
        });

        document.querySelectorAll('dialog').forEach(function (dialog) {
          if (dialog.__docsBound) return;
          dialog.__docsBound = true;

          // Close on clicking backdrop
          dialog.addEventListener('click', function (e) {
            var rect = dialog.getBoundingClientRect();
            var isInDialog = (
              rect.top <= e.clientY &&
              e.clientY <= rect.top + rect.height &&
              rect.left <= e.clientX &&
              e.clientX <= rect.left + rect.width
            );
            if (!isInDialog) {
              dialog.close();
            }
          });

          // Explicitly close dialog on submit or button click
          dialog.querySelectorAll('form[method="dialog"] button, [data-dialog-close]').forEach(function (btn) {
            btn.addEventListener('click', function () {
              dialog.close();
            });
          });
        });
      }

      initDocs();
      document.addEventListener('astro:page-load', initDocs);
    })();
  </script>
</BaseLayout>
