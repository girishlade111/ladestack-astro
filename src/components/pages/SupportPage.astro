---
/**
 * src/components/pages/SupportPage.astro
 * Reusable, fully localized Support Center page component.
 * Supports all 9 languages with native typography, full accessibility,
 * self-referencing canonicals, reciprocal hreflang tags, and FAQ schema.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Accordion from '../ui/Accordion.astro';
import AccordionItem from '../ui/AccordionItem.astro';
import { LOCALES, LOCALE_CONFIG, type Locale } from '../../i18n/config';
import { getHreflangLinks, getLocalizedPath } from '../../i18n/utils';
import { getSupportData } from '../../i18n/pages/support';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = getSupportData(locale);
const canonicalUrl = `https://ladestack.in${getLocalizedPath('/support', locale)}`;
const hreflangs = getHreflangLinks('/support', LOCALES);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    name: data.seo.title,
    description: data.seo.description,
    url: canonicalUrl,
    inLanguage: locale,
    mainEntity: data.faqSection.faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  canonical={canonicalUrl}
  locale={locale}
  hreflangs={hreflangs}
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: data.seo.ogTitle,
    description: data.seo.ogDescription,
    url: canonicalUrl,
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: data.seo.ogTitle,
    description: data.seo.ogDescription,
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background">
    {/* Hero */}
    <section class="relative pt-20 pb-14 border-b border-border bg-surface-muted/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Badge variant="emerald" class="mb-4">{data.hero.badge}</Badge>
        <h1 class="text-3xl sm:text-5xl font-bold text-foreground tracking-tight leading-tight">
          {data.hero.title}
        </h1>
        <p class="mt-4 text-base sm:text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed">
          {data.hero.description}
        </p>
      </div>
    </section>

    {/* Channels */}
    <section class="py-14 sm:py-20 border-b border-border bg-background">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="sr-only">{data.channelsSection.heading}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {
            data.channelsSection.channels.map((channel) => {
              const isInternal = channel.href.startsWith('/');
              const targetHref = isInternal ? getLocalizedPath(channel.href, locale) : channel.href;
              const isExternal = channel.href.startsWith('http');

              return (
                <div class="rounded-xl border border-border bg-surface p-6 shadow-soft flex flex-col justify-between hover:border-brand/40 transition-colors">
                  <div>
                    <div class="w-10 h-10 rounded-lg bg-brand/10 text-brand flex items-center justify-center mb-4">
                      <Icon name={channel.icon} class="w-5 h-5" />
                    </div>
                    <h3 class="text-lg font-semibold text-foreground mb-2">
                      {channel.title}
                    </h3>
                    <p class="text-xs text-muted-foreground leading-relaxed mb-4">
                      {channel.description}
                    </p>
                  </div>
                  <div class="pt-4 border-t border-border/60 flex items-center justify-between">
                    <span class="text-[11px] font-mono text-muted-foreground">{channel.responseTime}</span>
                    <a
                      href={targetHref}
                      target={isExternal ? '_blank' : undefined}
                      rel={isExternal ? 'noopener noreferrer' : undefined}
                      class="text-xs font-semibold text-brand hover:underline"
                    >
                      {channel.action} →
                    </a>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    {/* FAQ */}
    <section class="py-14 sm:py-20 bg-surface-muted/10">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          title={data.faqSection.title}
          description={data.faqSection.description}
        />

        <Accordion>
          {
            data.faqSection.faqs.map((f, i) => (
              <AccordionItem question={f.question} open={i === 0}>
                <p>{f.answer}</p>
              </AccordionItem>
            ))
          }
        </Accordion>

        <div class="mt-12 text-center">
          <Button href={getLocalizedPath('/contact', locale)} size="md">
            <span>{data.faqSection.ctaText}</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </Button>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
