---
/**
 * src/components/pages/SitemapPage.astro
 * Reusable, fully localized Sitemap & Directory page component.
 * Supports all 9 languages with native typography, full accessibility,
 * self-referencing canonicals, reciprocal hreflang tags, and honest blog fallback notice.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import Badge from '../ui/Badge.astro';
import { blogPosts } from '../../data/blogPosts';
import appsData from '../../data/apps.json';
import { LOCALES, LOCALE_CONFIG, type Locale } from '../../i18n/config';
import { getHreflangLinks, getLocalizedPath } from '../../i18n/utils';
import { getSitemapData } from '../../i18n/pages/sitemap';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = getSitemapData(locale);
const canonicalUrl = `https://ladestack.in${getLocalizedPath('/sitemap', locale)}`;
const hreflangs = getHreflangLinks('/sitemap', LOCALES);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: data.seo.title,
    description: data.seo.description,
    url: canonicalUrl,
    inLanguage: locale,
    publisher: {
      '@type': 'Organization',
      name: 'LadeStack',
      url: 'https://ladestack.in',
    },
  },
];

// Group blog posts by category
const postsByCategory = blogPosts.reduce((acc, post) => {
  if (!acc[post.category]) acc[post.category] = [];
  acc[post.category].push(post);
  return acc;
}, {} as Record<string, typeof blogPosts>);
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  canonical={canonicalUrl}
  locale={locale}
  hreflangs={hreflangs}
  robots={{ index: true, follow: true, custom: 'max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}
  openGraph={{
    title: data.seo.ogTitle,
    description: data.seo.ogDescription,
    url: canonicalUrl,
    type: 'website',
    image: 'https://ladestack.in/og-image.png',
  }}
  twitter={{
    card: 'summary_large_image',
    title: data.seo.ogTitle,
    description: data.seo.ogDescription,
    image: 'https://ladestack.in/og-image.png',
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background">
    {/* Hero */}
    <section class="relative pt-20 pb-14 border-b border-border bg-surface-muted/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <Badge variant="emerald" class="mb-4">{data.hero.badge}</Badge>
        <h1 class="text-3xl sm:text-5xl font-bold text-foreground tracking-tight leading-tight">
          {data.hero.title}
        </h1>
        <p class="mt-4 text-base sm:text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed">
          {data.hero.description}
        </p>
      </div>
    </section>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
      {/* ── SECTION 1: Core Platform ── */}
      <div>
        <div class="flex items-center gap-2 mb-6 pb-3 border-b border-border">
          <Icon name="home" class="w-4 h-4 text-brand" />
          <h2 class="text-lg font-bold text-foreground">{data.sections.corePlatform.title}</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            data.sections.corePlatform.items.map((route) => {
              const localizedHref = getLocalizedPath(route.href, locale);
              return (
                <a
                  href={localizedHref}
                  class="rounded-xl border border-border bg-surface p-5 hover:border-brand/40 hover:shadow-soft transition-all duration-150 flex flex-col justify-between group"
                >
                  <div>
                    <h3 class="text-sm font-semibold text-foreground group-hover:text-brand transition-colors">
                      {route.title}
                    </h3>
                    <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                      {route.desc}
                    </p>
                  </div>
                  <span class="mt-3 text-[11px] font-mono text-brand">
                    {localizedHref} →
                  </span>
                </a>
              );
            })
          }
        </div>
      </div>

      {/* ── SECTION 2: Developer Tools & Apps ── */}
      <div>
        <div class="flex items-center gap-2 mb-6 pb-3 border-b border-border">
          <Icon name="layers" class="w-4 h-4 text-brand" />
          <h2 class="text-lg font-bold text-foreground">{data.sections.tools.title}</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {
            appsData.map((app) => (
              <a
                href={app.landingUrl}
                target={app.landingUrl.startsWith('http') ? '_blank' : undefined}
                rel={app.landingUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="rounded-xl border border-border bg-surface p-4 hover:border-brand/40 hover:shadow-soft transition-all duration-150 flex flex-col justify-between group"
              >
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[10px] font-mono text-brand font-semibold uppercase">{app.category}</span>
                    {app.comingSoon ? (
                      <span class="text-[10px] text-muted-foreground font-mono">{data.sections.tools.comingSoon}</span>
                    ) : (
                      <span class="text-[10px] text-emerald-500 font-mono font-semibold">{data.sections.tools.live}</span>
                    )}
                  </div>
                  <h3 class="text-sm font-semibold text-foreground group-hover:text-brand transition-colors">
                    {app.title}
                  </h3>
                  <p class="mt-1 text-xs text-muted-foreground line-clamp-2">
                    {app.tagline}
                  </p>
                </div>
                <span class="mt-3 text-[11px] font-mono text-muted-foreground group-hover:text-brand inline-flex items-center gap-1">
                  <span>{data.sections.tools.openTool}</span>
                  {app.landingUrl.startsWith('http') && <Icon name="arrow-up-right" class="w-3 h-3" />}
                </span>
              </a>
            ))
          }
        </div>
      </div>

      {/* ── SECTION 3: Engineering Blog Archive ── */}
      <div>
        <div class="flex items-center justify-between mb-6 pb-3 border-b border-border">
          <div class="flex items-center gap-2">
            <Icon name="file-text" class="w-4 h-4 text-brand" />
            <h2 class="text-lg font-bold text-foreground">{data.sections.blogArchive.title}</h2>
          </div>
          <a href="/blog" class="text-xs font-semibold text-brand hover:underline">
            {data.sections.blogArchive.visitBlog}
          </a>
        </div>

        {/* Translation Status Notice */}
        <div class="mb-6 rounded-xl border border-border bg-surface-muted/40 p-3.5 text-xs text-muted-foreground flex items-center gap-2.5">
          <Icon name="info" class="w-4 h-4 text-brand shrink-0" />
          <span>{data.sections.blogArchive.notice}</span>
        </div>

        <div class="space-y-8">
          {
            Object.entries(postsByCategory).map(([category, posts]) => (
              <div>
                <h3 class="text-xs font-mono font-semibold text-brand uppercase tracking-wider mb-3">
                  {category} ({posts.length})
                </h3>
                <div class="divide-y divide-border rounded-xl border border-border bg-surface overflow-hidden">
                  {posts.map((post) => (
                    <a
                      href={`/blog/${post.slug}`}
                      class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-surface-muted/50 transition-colors group"
                    >
                      <span class="text-xs sm:text-sm font-medium text-foreground group-hover:text-brand transition-colors">
                        {post.title}
                      </span>
                      <div class="flex items-center gap-3 text-xs text-muted-foreground font-mono shrink-0">
                        <span>{new Date(post.date + 'T00:00:00').toLocaleDateString(locale === 'ja' ? 'ja-JP' : locale === 'ko' ? 'ko-KR' : locale === 'zh' ? 'zh-CN' : 'en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                        <span>·</span>
                        <span>{post.readTime}</span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      {/* ── SECTION 4: Legal & Policies ── */}
      <div>
        <div class="flex items-center gap-2 mb-6 pb-3 border-b border-border">
          <Icon name="shield" class="w-4 h-4 text-brand" />
          <h2 class="text-lg font-bold text-foreground">{data.sections.legal.title}</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            data.sections.legal.items.map((route) => {
              const localizedHref = getLocalizedPath(route.href, locale);
              return (
                <a
                  href={localizedHref}
                  class="rounded-xl border border-border bg-surface p-5 hover:border-brand/40 hover:shadow-soft transition-all duration-150 flex flex-col justify-between group"
                >
                  <div>
                    <h3 class="text-sm font-semibold text-foreground group-hover:text-brand transition-colors">
                      {route.title}
                    </h3>
                    <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                      {route.desc}
                    </p>
                  </div>
                  <span class="mt-3 text-[11px] font-mono text-brand">
                    {localizedHref} →
                  </span>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
